--------------------------------------------------------------------------------
-- Hex helper — converts {r,g,b[,a]} to "#RRGGBB" (alpha dropped for Color)
--------------------------------------------------------------------------------
function rgbHex(c)
  if not c then return "#00000000" end
  return string.format("#%02X%02X%02X", c[1], c[2], c[3])
end

--------------------------------------------------------------------------------
-- Backwards-compat theme keys (still referenced by other page builders).
--------------------------------------------------------------------------------
local _origGetTheme = getThemeColors
function getThemeColors()
  local t = _origGetTheme()
  t.groupboxFill   = t.pageBg
  -- Indicator fill matches the page bg so empty device-info boxes blend in
  -- (backup convention: visually invisible until populated).
  t.indicatorFill  = state.darkMode and { 20, 24, 40, 230 } or { 240, 245, 255, 255 }
  t.strokeColor    = t.cardStroke
  t.textColor      = t.textPrimary
  t.textboxColor   = t.textPrimary
  t.textboxBg      = t.cardFill
  t.buttonColor    = t.accentCyan
  t.buttonAltColor = t.accentCyan
  t.buttonOffColor = t.portDefault
  t.labelGray      = t.textMuted
  -- Port backdrop rectangle — subtle, close to page bg (backup value).
  t.rectangleFill  = state.darkMode and { 30, 40, 60, 220 } or { 240, 245, 255, 255 }
  return t
end

--------------------------------------------------------------------------------
-- Port UI Renderer (UI ONLY)
--------------------------------------------------------------------------------
function renderPortUI(port)
  -- A REST snapshot setting several fields of one port renders it once at
  -- the end (state.renderHeld, see applyPortObject / syncPoePorts).
  if state.renderHeld then return end
  local p = getPortState(port)
  local theme = getThemeColors()
  renderPortPins(port)

  -- Group / trunk color for the Port.Group cell of the port-settings grid.
  -- Live API color preferred, predefined palette fallback, transparent if
  -- unassigned, black on a disabled port.
  local memberOf  = p.memberOf
  local groupColor = (state.customColors and state.customColors[memberOf])
                    or GROUP_COLORS[memberOf]
  local groupHex
  if p.enabled == false then
    groupHex = "#000000"
  else
    groupHex = groupColor and rgbHex(groupColor) or "#00000000"
  end

  -- Port.Group cell — Button colored with group color, Legend = name.
  local groupBtn = Controls["Port.Group " .. port]
  if groupBtn then
    local cellHex = (memberOf and groupHex ~= "#00000000") and groupHex or PICKER_UNASSIGNED_HEX
    groupBtn.Color = cellHex
    pcall(function() groupBtn.OffColor = cellHex end)
    groupBtn.Legend = memberOfDisplayName(memberOf)
  end

  -- Without the PoE licence ("poe" missing from the /api/features active
  -- list) no toggle color and no toggle state (renderPortPins), whatever
  -- /api/poe/ports reports.
  local poeLicensed = state.hasPoe ~= false
  local poeKey = poeLicensed and (p.poe or ""):lower() or ""
  local poeColorMap = {
    sourcing = theme.poeSourcing,
    enabled  = theme.poeEnabled,
    disabled = theme.poeDisabled,
  }

  local poeToggle = Controls["PoE.Port " .. port .. ".Enabled"]
  if poeToggle then
    local c = poeColorMap[poeKey]
    poeToggle.Color  = c and rgbHex(c) or "#00000000"
    poeToggle.Legend = (poeKey == "sourcing") and "⚡" or ""
  end

  -- "Disabled" is a picker choice, not an API speed: a disabled port shows
  -- it here while p.speed keeps the real link_speed for when it comes back.
  local speedCell = Controls["Port.Speed Cell " .. port]
  if speedCell then
    local hex = rgbHex(theme.buttonOffColor)
    speedCell.Legend = (p.enabled == false) and "Disabled" or tostring(p.speed or "")
    speedCell.Color  = hex
    pcall(function() speedCell.OffColor = hex end)
  end

  -- Web UI card on the chassis. Re-encoded only when its SVG changed: the
  -- connect storm calls renderPortUI hundreds of times. Ports without a card
  -- (plugin model smaller than the switch) are skipped.
  local card = state.chassis and state.chassis.cards[port]
  if card then
    local svg = portCardSvg(portCardView(port, card))
    if svg ~= state.cardSvg[port] then
      state.cardSvg[port] = svg
      Controls["Port.Card " .. port].Legend = iconLegend(svg)
    end
  end
end

-- Button Legend that draws an SVG through IconData (no chrome, no text).
function iconLegend(svg)
  return '{"DrawChrome":false,"IconData":"' .. Crypto.Base64Encode(svg) .. '","Legend":""}'
end

-- 10G frames (Chassis.10G N, one per tenG group in layout order): shown while
-- the 10g licence is active. Painted only when that changes (state.tenGShown).
function refreshTenGFrames()
  if not state.chassis or state.tenGShown == state.has10g then return end
  state.tenGShown = state.has10g
  local index = 0
  for _, frame in ipairs(state.chassis.frames) do
    if frame.tenG then
      index = index + 1
      Controls["Chassis.10G " .. index].Legend = state.has10g and iconLegend(tenGFrameSvg(frame)) or ""
    end
  end
end

-- Blank every card and 10G frame so the offline chassis graphic shows: at
-- runtime start (Designer keeps the last runtime Legend, which would show a
-- previous session as current) and when the WebSocket drops (the web UI's
-- not-live look). The next snapshot rewrites them all.
function clearPortCards()
  -- First: closing re-renders the selected card, which the blanking below
  -- then clears.
  closeLldpPanel()
  state.cardSvg = {}
  state.tenGShown = nil
  for port = 1, (state.portCount or 0) do
    Controls["Port.Card " .. port].Legend = ""
  end
  -- Forget the states too: a groups answer landing after a close (in flight,
  -- or the 3 s reconcile) would otherwise redraw them while offline.
  state.querierSvg, state.querierByVid = "", {}
  Controls["Querier.Badges"].Legend = ""
  clearLldp()
  if not state.chassis then return end
  local index = 0
  for _, frame in ipairs(state.chassis.frames) do
    if frame.tenG then
      index = index + 1
      Controls["Chassis.10G " .. index].Legend = ""
    end
  end
end

--------------------------------------------------------------------------------
-- Basic Auth
--------------------------------------------------------------------------------
function MergeTables(a, b)
  local result = {}
  for k, v in pairs(a) do result[k] = v end
  for k, v in pairs(b) do result[k] = v end
  return result
end

function getAuthHeaders()
  local user = Controls["Auth.Username"] and Controls["Auth.Username"].String or ""
  local pass = Controls["Auth.Password"] and Controls["Auth.Password"].String or ""
  if user == "" or pass == "" then return {} end
  local token = Crypto.Base64Encode(user .. ":" .. pass)
  return { ["Authorization"] = "Basic " .. token }
end

--------------------------------------------------------------------------------
-- WebSocket subscriptions
--------------------------------------------------------------------------------
function subscribeAllPorts()
  if not state.ws then return end

  for i = 1, state.portCount do
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/link_state","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/member_of","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/rlinkx","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/rlinkx/ports/%d/state","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/legend","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/enabled","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/ports/port/%d/link_speed","action":"add","method":"changes"}}', i))
  end

  state.ws:Write('{"subscription":{"path":"/device/name","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/hostname","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/description","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/actual_ip/ip_address","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/actual_ip/prefix_length","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/actual_ip/default_gateway","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/ip_settings/mode","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/mac_address","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/device/firmware/active","action":"add","method":"changes"}}')
end

--------------------------------------------------------------------------------
-- System / chassis / RSTP / snooping subscriptions
--------------------------------------------------------------------------------
function subscribeAllSystem()
  if not state.ws then return end

  -- CPU load, CPU and case temperatures
  state.ws:Write('{"subscription":{"path":"/system/cpu_load","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/system/cpu_load_long","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/temperatures/temperature/cpu/current","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/temperatures/temperature/case/current","action":"add","method":"changes"}}')

  -- Fans 1..3 (some models have fewer — extras harmlessly never fire)
  for i = 1, 3 do
    state.ws:Write(string.format('{"subscription":{"path":"/fans/fan/%d/speed","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/fans/fan/%d/state","action":"add","method":"changes"}}', i))
  end

  -- PSUs
  for _, name in ipairs({ "psu1", "psu2" }) do
    state.ws:Write(string.format('{"subscription":{"path":"/power/psus/%s/state","action":"add","method":"changes"}}', name))
    state.ws:Write(string.format('{"subscription":{"path":"/power/psus/%s/power_status","action":"add","method":"changes"}}', name))
    state.ws:Write(string.format('{"subscription":{"path":"/power/psus/%s/power_usage","action":"add","method":"changes"}}', name))
  end
  state.ws:Write('{"subscription":{"path":"/power/coupling/mode","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/power/coupling/state","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/power/total_power_usage","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/power/total_power_max","action":"add","method":"changes"}}')

  -- Switch-wide RLinkX flag
  state.ws:Write('{"subscription":{"path":"/rlinkx/enabled","action":"add","method":"changes"}}')

  -- Spanning tree (default MST instance 0)
  state.ws:Write('{"subscription":{"path":"/spanning_tree/mst/0/bridge_priority","action":"add","method":"changes"}}')
  for i = 1, state.portCount do
    state.ws:Write(string.format('{"subscription":{"path":"/spanning_tree/mst/0/ports/%d/role","action":"add","method":"changes"}}', i))
  end
  state.ws:Write('{"subscription":{"path":"/spanning_tree/mst/0/root_bridge_address","action":"add","method":"changes"}}')
  state.ws:Write('{"subscription":{"path":"/spanning_tree/mst/0/root_bridge_priority","action":"add","method":"changes"}}')

  -- MultiLinkX LAGs: any notification re-reads the whole list (scheduleLagSync)
  state.ws:Write('{"subscription":{"path":"/ports/lags/lag","action":"add","method":"changes"}}')

  -- LLDP neighbors: the answer carries the whole list (handleLldpPath)
  state.ws:Write('{"subscription":{"path":"/lldp/neighbor","action":"add","method":"changes"}}')
end

-- The switch answers a subscription under a group or PoE port that does not
-- exist with an error message, so these two follow the REST answers instead
-- of fixed ranges. Both flags are reset at Connected.

-- PoE paths only on a PoE unit ("poe" active in /api/features) and only for
-- the model's PoE ports. Runs on every features answer: a PoE licence
-- activated later is picked up by the next reconcile.
state.poeSubscribed = state.poeSubscribed or false

function subscribePoePorts()
  if not state.ws or not state.hasPoe or state.poeSubscribed then return end
  state.poeSubscribed = true
  for i = 1, getPoeCount(resolveModel(Properties)) do
    state.ws:Write(string.format('{"subscription":{"path":"/poe/ports/%d/indication","action":"add","method":"changes"}}', i))
    state.ws:Write(string.format('{"subscription":{"path":"/poe/ports/%d/enabled","action":"add","method":"changes"}}', i))
  end
end

-- Name and id notifications for the groups of the last /api/groups answer
-- (renames show live; a new group is picked up by the next reconcile). A
-- group gone from the list is forgotten, so it is subscribed again if it
-- comes back.
state.groupSubscribed = state.groupSubscribed or {}

function subscribeGroups()
  local present = {}
  for _, g in ipairs(state.groupList) do present[g.id] = true end
  for id in pairs(state.groupSubscribed) do
    if not present[id] then state.groupSubscribed[id] = nil end
  end
  if not state.ws then return end
  for _, g in ipairs(state.groupList) do
    if not state.groupSubscribed[g.id] then
      state.groupSubscribed[g.id] = true
      state.ws:Write(string.format('{"subscription":{"path":"/groups/group/%d/name","action":"add","method":"changes"}}', g.id))
      state.ws:Write(string.format('{"subscription":{"path":"/groups/group/%d/group_id","action":"add","method":"changes"}}', g.id))
    end
  end
end

--------------------------------------------------------------------------------
-- Model detection (REST snapshot)
--------------------------------------------------------------------------------
-- The read-only "model" of /api/device has no space ("GigaCore30i") where the
-- plugin's model names have one ("GigaCore 30i"): compare lowercase letters
-- and digits only. ("name" is the user-set device name.)
local function modelKey(s)
  return (s:lower():gsub("[^%w]", ""))
end

function matchModel(raw)
  local wanted = modelKey(raw)
  for name, _ in pairs(GigaCoreModels) do
    if modelKey(name) == wanted then return name end
  end
  return nil
end

-- Display.Model flashes like the Offline badge while the Model property and
-- the switch disagree. One timer, reused across WebSocket reconnects.
local function startModelPulse(ctrl)
  local bright = true
  pcall(function() ctrl.Color = "#C80000" end)
  state.modelPulseTimer = state.modelPulseTimer or Timer.New()
  state.modelPulseTimer.EventHandler = function()
    bright = not bright
    pcall(function() ctrl.Color = bright and "#C80000" or "#800000" end)
  end
  state.modelPulseTimer:Start(0.5)
end

local function stopModelPulse()
  if state.modelPulseTimer then state.modelPulseTimer:Stop() end
end

-- One-shot GET /api/device at connect. Device.Model and Device.Hostname get
-- the raw values; Display.Model shows the switch's model, flashing red when
-- the Model property names another one: the chassis layout is frozen at
-- design time, so the user has to pick the right model in the plugin
-- properties.
function fetchDeviceInfo()
  HttpClient.Get {
    Url     = string.format("http://%s/api/device", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    EventHandler = function(_tbl, code, body, _err)
      if code ~= 200 or not body then return end
      updateGateway(body:match('"default_gateway"%s*:%s*"([^"]*)"'))
      local hostname = body:match('"hostname"%s*:%s*"([^"]*)"')
      if hostname then setPinString("Device.Hostname", hostname) end
      local raw = body:match('"model"%s*:%s*"([^"]+)"')
      if not raw then return end
      setPinString("Device.Model", raw)
      local name = matchModel(raw)
      local selected = resolveModel(Properties)
      local ctrl = Controls["Display.Model"]
      if name == selected then
        stopModelPulse()
        log("Device model detected => " .. name)
        ctrl.String = name
        paintHeaderBox(ctrl)
        state.modelMismatch = nil
        refreshStatus()
        return
      end
      log("WARNING: Model property is set to '" .. selected ..
          "' but the switch reports '" .. raw ..
          "'. Pick the correct model in plugin properties to fix the chassis layout.")
      ctrl.String = "Switch is " .. (name or raw)
      startModelPulse(ctrl)
      state.modelMismatch = ctrl.String
      refreshStatus()
    end,
  }
end

--------------------------------------------------------------------------------
-- Bulk REST reconciliation
--
-- WebSocket subscriptions are the live path, but a notification missed
-- during the subscription storm at connect stays wrong until that value
-- changes again. Nine bulk GETs (reconcileAll) re-apply the state through the
-- same setters the WS handlers use. They run right after connect, again 3 s
-- later, then every Poll Interval.
--------------------------------------------------------------------------------

-- Reconcile GETs still waiting for their answer. Each has a 10 s Timeout and
-- a timeout still calls its handler, so the count always drains. The poll
-- tick and the 3 s follow-up wait for the previous batch (reconcileIfIdle):
-- a slow switch never gets a second batch on top of the first.
state.getsInFlight = state.getsInFlight or 0

local function counted(handler)
  state.getsInFlight = state.getsInFlight + 1
  return function(...)
    state.getsInFlight = state.getsInFlight - 1
    return handler(...)
  end
end

-- Split a JSON array body into its top-level "{...}" elements by walking
-- brace positions with string.find (a per-character loop over a 50 KB body
-- trips Q-SYS's "Max execution limits exceeded"). No braces inside strings
-- in this API.
local function splitJsonObjects(body)
  local objects, depth, start = {}, 0, nil
  local pos = 1
  while true do
    local i = body:find("[{}]", pos)
    if not i then break end
    if body:sub(i, i) == "{" then
      if depth == 0 then start = i end
      depth = depth + 1
    else
      depth = depth - 1
      if depth == 0 and start then
        objects[#objects + 1] = body:sub(start, i)
        start = nil
      end
    end
    pos = i + 1
  end
  return objects
end

-- RLinkX bulk snapshot: /api/rlinkx => {"enabled":..,"ports":[{"port_number":N,"state":"redundant|non-redundant|disabled"},..]}
function syncRlinkxState()
  HttpClient.Get {
    Url     = string.format("http://%s/api/rlinkx", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/rlinkx => HTTP " .. tostring(code) .. " body=" .. type(body) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      -- Top-level "enabled" (switch-wide flag), matched once ports[] is out
      -- of the way.
      local enabled = body:gsub("%b[]", "[]"):match('"enabled"%s*:%s*(%a+)')
      if enabled == "true" or enabled == "false" then SetRlinkxEnabled(enabled == "true") end
      for portNum, stateStr in body:gmatch('"port_number"%s*:%s*(%d+)%s*,%s*"state"%s*:%s*"([^"]+)"') do
        local n = tonumber(portNum)
        if n and n <= (state.portCount or 0) then SetPortRlinkxState(n, stateStr) end
      end
    end),
  }
end

-- Pull nested objects out of one element so top-level scalars can be
-- matched without ambiguity (e.g. "enabled" exists at top level and inside
-- "rlinkx"). Returns the flattened top-level string and a table of nested
-- object strings keyed by field name.
local function splitNested(elem)
  local nested = {}
  local top = elem:gsub('"([%w_]+)"%s*:%s*(%b{})', function(key, obj)
    nested[key] = obj
    return ""
  end)
  return top, nested
end

local function applyPortObject(elem)
  local top, nested = splitNested(elem)
  local port = tonumber(top:match('"port_number"%s*:%s*(%d+)'))
  if not port or port > (state.portCount or 0) then return end
  state.renderHeld = true

  local ptype = top:match('"type"%s*:%s*"(%w+)"')
  if ptype then getPortState(port).portType = ptype end

  local enabled = top:match('"enabled"%s*:%s*(%a+)')
  if enabled then SetPortEnabled(port, enabled == "true") end

  local link = top:match('"link_state"%s*:%s*"([^"]*)"')
  if link then SetPortLinkState(port, link) end

  local legend = lldpJsonString(top, "legend")
  if legend then SetPortLegend(port, legend) end

  if nested.counters then
    local p = getPortState(port)
    p.rxBitRate = tonumber(nested.counters:match('"rx_bit_rate"%s*:%s*(%d+)'))
    p.txBitRate = tonumber(nested.counters:match('"tx_bit_rate"%s*:%s*(%d+)'))
    p.linkFlaps = tonumber(nested.counters:match('"link_flaps"%s*:%s*(%d+)'))
  end

  if nested.member_of then
    local t  = nested.member_of:match('"type"%s*:%s*"([^"]+)"')
    local id = nested.member_of:match('"id"%s*:%s*(%d+)')
    if t == "group" and id then
      SetPortMemberOf(port, "Group: " .. id)
    elseif t == "trunk" and id then
      SetPortMemberOf(port, "Trunk: " .. id)
    elseif t == "none" then
      SetPortMemberOf(port, nil)
    end
  end

  if nested.link_speed then
    local mode  = nested.link_speed:match('"mode"%s*:%s*"([^"]+)"')
    local speed = nested.link_speed:match('"speed"%s*:%s*%[%s*"([^"]+)"')
    if mode == "auto" then
      SetPortSpeed(port, (speed == "all" or not speed) and "Auto" or speed)
    elseif mode == "fixed" and speed then
      SetPortSpeed(port, speed)
    end
    SetPortLinkSpeedFields(port, mode, speedListFromArray(nested.link_speed:match('"speed"%s*:%s*(%b[])')))
  end

  if nested.rlinkx then
    local flag = nested.rlinkx:match('"enabled"%s*:%s*(%a+)')
    if flag == "true" or flag == "false" then SetPortRlinkxEnabled(port, flag == "true") end
  end
  state.renderHeld = false
  renderPortUI(port)
end

function syncAllPorts()
  HttpClient.Get {
    Url     = string.format("http://%s/api/ports", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/ports => HTTP " .. tostring(code) .. " body=" .. type(body) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      local arr = body:match('"port"%s*:%s*(%b[])')
      if not arr then return end
      for _, elem in ipairs(splitJsonObjects(arr)) do applyPortObject(elem) end
    end),
  }
end

function syncPoePorts()
  HttpClient.Get {
    Url     = string.format("http://%s/api/poe/ports", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, _err)
      if code ~= 200 or type(body) ~= "string" then return end
      for _, elem in ipairs(splitJsonObjects(body)) do
        local top = splitNested(elem)
        local port = tonumber(top:match('"port_number"%s*:%s*(%d+)'))
        if port and port <= (state.portCount or 0) then
          state.renderHeld = true
          local enabled = top:match('"enabled"%s*:%s*(%a+)')
          if enabled then SetPortPoeEnabled(port, enabled == "true") end
          local ind = top:match('"indication"%s*:%s*"([^"]*)"')
          if ind then SetPortIndication(port, ind) end
          state.renderHeld = false
          renderPortUI(port)
        end
      end
    end),
  }
end

-- /api/features: "10g" in the active list means the 10 G licence is on,
-- which decides whether SFP ports may be set to 10 Gbps. "poe" in the
-- active list is the PoE licence ("supported" only says it can be bought);
-- without it renderPortUI shows no PoE pip or toggle state. "fiber" in
-- "supported" but not in "active" draws the rfib ports as not present; old
-- firmware (v1.1.0) has no "supported" list.
function syncFeatures()
  HttpClient.Get {
    Url     = string.format("http://%s/api/features", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/features => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      local active = body:match('"active"%s*:%s*(%b[])') or ""
      local supported = body:match('"supported"%s*:%s*(%b[])') or ""
      state.has10g = active:find('"10g"', 1, true) ~= nil
      refreshTenGFrames()
      local before = { state.hasPoe, state.fiberPossible, state.fiberActive }
      state.hasPoe = active:find('"poe"', 1, true) ~= nil
      state.fiberPossible = supported:find('"fiber"', 1, true) ~= nil
      state.fiberActive = active:find('"fiber"', 1, true) ~= nil
      if state.hasPoe ~= before[1] or state.fiberPossible ~= before[2] or state.fiberActive ~= before[3] then
        for port = 1, (state.portCount or 0) do renderPortUI(port) end
      end
      subscribePoePorts()
    end),
  }
end

-- MultiLinkX: /api/ports/lags/lag => [{"port_number":66,"link_state":"up",
-- "members":[25,26],"active_members":[25]},..]. A port in any active_members
-- gets the white bar, a port only in members the magenta one. The API reports
-- a LAG's RSTP role and router-port status on its own port number (66 and
-- up): every member shows them (portCardView, refreshMrPorts), like Araneo.
state.lagOf             = state.lagOf or {}             -- member port -> LAG port number
state.lagMembers        = state.lagMembers or {}        -- LAG port number -> { member ports }
state.lagRoleSubscribed = state.lagRoleSubscribed or {} -- LAG port -> true once its role is subscribed on this socket

function syncLags()
  HttpClient.Get {
    Url     = string.format("http://%s/api/ports/lags/lag", state.baseIP),
    Headers = MergeTables({ ["Content-Type"] = "application/json" }, getAuthHeaders()),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/ports/lags/lag => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      local roles, lagOf, lagMembers = {}, {}, {}
      for lag in body:gmatch("%b{}") do
        local lagPort = tonumber(lag:match('"port_number"%s*:%s*(%d+)'))
        local members = lag:match('"members"%s*:%s*(%b[])') or ""
        local active  = lag:match('"active_members"%s*:%s*(%b[])') or ""
        if lagPort then lagMembers[lagPort] = {} end
        for n in members:gmatch("%d+") do
          local port = tonumber(n)
          roles[port] = roles[port] or "member"
          if lagPort then
            lagOf[port] = lagPort
            table.insert(lagMembers[lagPort], port)
          end
        end
        for n in active:gmatch("%d+") do roles[tonumber(n)] = "active" end
      end
      local previousLagOf = state.lagOf
      state.lagOf, state.lagMembers = lagOf, lagMembers
      for port = 1, (state.portCount or 0) do
        local p = getPortState(port)
        if p.multilinkx ~= roles[port] or previousLagOf[port] ~= lagOf[port] then
          p.multilinkx = roles[port]
          renderPortUI(port)
        end
      end
      refreshMrPorts()
      subscribeLagRoles()
    end),
  }
end

-- One LAG change arrives as one notification per changed field: the burst
-- re-reads the list once, 0.5 s after its first notification.
function scheduleLagSync()
  if state.lagSyncPending then return end
  state.lagSyncPending = true
  Timer.CallAfter(function()
    state.lagSyncPending = false
    syncLags()
  end, 0.5)
end

--------------------------------------------------------------------------------
-- LLDP neighbors: GET /api/lldp/neighbor in the reconcile, WS /lldp/neighbor
-- (parsing and shown values in lldp.lua).
--------------------------------------------------------------------------------
state.lldp = state.lldp or {}  -- port -> neighbor (lldpParseNeighbors), ports 1..portCount only

function refreshLldpViews()
  refreshLldpRows()
  refreshLldpPanel()
end

-- The whole neighbor list (GET body or subscription answer). A port the
-- model does not have (O26-I lists 32, LAG ports 66 and up) is left out.
function applyLldp(text)
  local lldp = {}
  for port, neighbor in pairs(lldpParseNeighbors(text)) do
    if port <= (state.portCount or 0) then lldp[port] = neighbor end
  end
  state.lldp = lldp
  refreshLldpViews()
end

-- Neighbors page. Rows are redrawn only when their SVG changed (state.lldpSvg).
state.lldpSvg = state.lldpSvg or {}  -- port -> last row SVG written to Lldp.Row N

local function lldpColors()
  local theme = getThemeColors()
  return { fill = rgbHex(theme.cardFill), border = "#CED3DD", text = rgbHex(theme.textPrimary),
    muted = rgbHex(theme.textMuted) }
end

-- Fill of the LLDP text buttons (white text): navy in both themes (the light
-- buttonOffColor is too pale for white text).
local function lldpButtonHex()
  local theme = getThemeColors()
  return rgbHex(state.darkMode and theme.buttonOffColor or theme.textPrimary)
end

-- A text button (-> Legend, Close), shown.
local function showLldpButton(name, label)
  local button = Controls[name]
  local hex = lldpButtonHex()
  button.Legend = label
  button.Color = hex
  pcall(function() button.OffColor = hex end)
  setOverlayVisible(name, true)
end

function refreshLldpRows()
  local model = resolveModel(Properties)
  local geometry = neighborsGeometry(model)
  local columns = neighborsColumns(geometry.blockW, geometry.compact)
  local colors = lldpColors()
  for port = 1, state.portCount do
    local neighbor = state.lldp[port]
    local svg = lldpRowSvg({ port = port, w = geometry.blockW, h = geometry.rowH,
      view = neighbor and lldpView(neighbor) }, colors, columns)
    if state.lldpSvg[port] ~= svg then
      state.lldpSvg[port] = svg
      Controls["Lldp.Row " .. port].Legend = iconLegend(svg)
    end
  end
end

-- Blank the Neighbors page (WS Error / Closed, runtime start) and forget the
-- neighbors, like the cards: Designer keeps the last runtime Legend offline.
function clearLldp()
  state.lldp, state.lldpSvg = {}, {}
  for port = 1, (state.portCount or 0) do
    local row = Controls["Lldp.Row " .. port]
    if row then row.Legend = "" end
  end
end

-- Neighbor panel (main page): opened by a click on a chassis card, over the
-- port-settings grid. The selected card is outlined (portCardView.selected).
-- The buttons' names sort after zLldp.Panel, so they draw on top of it.
local LLDP_PANEL_CONTROLS = { "zLldp.Panel", "zLldp.Panel To Legend", "zLldp.Panel Close" }

function refreshLldpPanel()
  local port = state.lldpPanelPort
  if not port then return end
  local neighbor = state.lldp[port]
  local view = neighbor and lldpView(neighbor)
  local svg = lldpPanelSvg({ port = port, view = view }, lldpColors())
  if svg == state.lldpPanelSvg then return end
  state.lldpPanelSvg = svg
  Controls["zLldp.Panel"].Legend = iconLegend(svg)
  setOverlayVisible("zLldp.Panel", true)
  showLldpButton("zLldp.Panel Close", "Close")
  if view then
    showLldpButton("zLldp.Panel To Legend", "\u{2192} Legend")
  else
    setOverlayVisible("zLldp.Panel To Legend", false)
  end
end

-- Only while online; an open picker closes. The previous and the new
-- selected cards re-render (the card SVG cache skips the others).
function openLldpPanel(port)
  if state.connection ~= "online" then return end
  closeGroupPicker()
  closeSpeedPicker()
  local previous = state.lldpPanelPort
  state.lldpPanelPort, state.lldpPanelSvg = port, nil
  if previous and previous ~= port then renderPortUI(previous) end
  renderPortUI(port)
  refreshLldpPanel()
end

function closeLldpPanel()
  local port = state.lldpPanelPort
  state.lldpPanelPort, state.lldpPanelSvg = nil, nil
  if port then renderPortUI(port) end
  for _, name in ipairs(LLDP_PANEL_CONTROLS) do setOverlayVisible(name, false) end
end

-- A click on the open port's card closes the panel, any other card opens it.
function toggleLldpPanel(port)
  if state.lldpPanelPort == port then
    closeLldpPanel()
  else
    openLldpPanel(port)
  end
end

function syncLldp()
  HttpClient.Get {
    Url     = string.format("http://%s/api/lldp/neighbor", state.baseIP),
    Headers = MergeTables({ ["Content-Type"] = "application/json" }, getAuthHeaders()),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/lldp/neighbor => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      applyLldp(body)
    end),
  }
end

-- A burst of neighbor notifications re-reads the list once, 0.5 s after its
-- first one.
function scheduleLldpSync()
  if state.lldpSyncPending then return end
  state.lldpSyncPending = true
  Timer.CallAfter(function()
    state.lldpSyncPending = false
    syncLldp()
  end, 0.5)
end

-- /lldp/neighbor: the subscription answer carries the whole list; a TTL
-- refresh (one every few seconds per neighbor) is ignored; anything else (the
-- shape of an added or removed neighbor was never observed) re-reads the list.
function handleLldpPath(path, raw)
  if path ~= "/lldp/neighbor" then return false end
  if raw:match('"notification_type"%s*:%s*"([^"]+)"') == "subscription_response" then
    applyLldp(raw)
  elseif not lldpIsTtlOnly(raw) then
    scheduleLldpSync()
  end
  return true
end

function reconcileAll()
  log("reconcileAll: ws=" .. tostring(state.ws ~= nil) .. " ip=" .. tostring(state.baseIP))
  if not state.ws or state.baseIP == "" then return end
  syncAllPorts()
  syncFeatures()
  syncPoePorts()
  syncRlinkxState()
  syncLags()
  fetchCustomColors()
  syncPowerStatus()
  syncSpanningTree()
  syncLldp()
end

-- The poll tick and the 3 s follow-up; the reconcile at Connected always runs.
function reconcileIfIdle()
  if state.getsInFlight > 0 then
    log("reconcile skipped: " .. state.getsInFlight .. " GETs still in flight")
    return
  end
  reconcileAll()
end

--------------------------------------------------------------------------------
-- Status block snapshots (REST). The WebSocket only reports changes, so a
-- PSU state or root bridge that never changes after connect would otherwise
-- stay blank; these GETs feed the same setters as the WS handlers.
--------------------------------------------------------------------------------
-- /api/power: {"total_power_usage":N,"coupling":{"mode":..,"state":..},
--   "psus":[{"name":"psu1",...,"power_usage":N,...,"state":"good",...},...]}
function syncPowerStatus()
  HttpClient.Get {
    Url     = string.format("http://%s/api/power", state.baseIP),
    Headers = MergeTables({ ["Content-Type"] = "application/json" }, getAuthHeaders()),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/power => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      local total = body:match('"total_power_usage"%s*:%s*(%d+)')
      if total then SetTotalPower(total) end
      local max = body:match('"total_power_max"%s*:%s*(%d+)')
      if max then SetTotalPowerMax(max) end
      -- psus[] lists only the powered sources: a slot missing from it gets
      -- "" pins and a grey icon, and fewer sources than max_num_psus marks
      -- the single-PSU install that refreshCoupling does not flag.
      local psus = body:match('"psus"%s*:%s*(%b[])') or "[]"
      local maxPsus = tonumber(body:match('"max_num_psus"%s*:%s*(%d+)'))
      local count, seen = 0, {}
      for obj in psus:gmatch("%b{}") do
        count = count + 1
        local id = tonumber(obj:match('"name"%s*:%s*"psu(%d+)"'))
        if id then
          seen[id] = true
          -- "fans":[{...,"state":..}] nests its own "state"; strip nested
          -- arrays and objects before matching the top-level scalars.
          local flat = obj:gsub("%b[]", "[]")
          local usage = flat:match('"power_usage"%s*:%s*(-?%d+)')
          local pstat = flat:match('"state"%s*:%s*"([^"]*)"')
          local power = flat:match('"power_status"%s*:%s*"([^"]*)"')
          if pstat then SetPsuState(id, pstat) end
          if power then SetPsuPowerStatus(id, power) end
          if usage then SetPsuPower(id, usage) end
        end
      end
      for id = 1, 2 do
        if not seen[id] then
          SetPsuState(id, "")
          SetPsuPowerStatus(id, "")
        end
      end
      state.psuMissing = maxPsus ~= nil and count < maxPsus
      local coupling = body:match('"coupling"%s*:%s*(%b{})')
      if coupling then
        local mode  = coupling:match('"mode"%s*:%s*"([^"]+)"')
        local cstat = coupling:match('"state"%s*:%s*"([^"]+)"')
        if cstat then SetCouplingState(cstat) end
        if mode  then SetPowerCoupling(mode) end
      end
    end),
  }
end

-- /api/spanning_tree/mst/0: bridge_priority, bridge_address,
-- root_bridge_address, root_bridge_priority (+ a "ports" array we skip).
function syncSpanningTree()
  HttpClient.Get {
    Url     = string.format("http://%s/api/spanning_tree/mst/0", state.baseIP),
    Headers = MergeTables({ ["Content-Type"] = "application/json" }, getAuthHeaders()),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/spanning_tree/mst/0 => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      local flat = body:gsub("%b[]", "[]")
      local pri      = flat:match('"bridge_priority"%s*:%s*(%d+)')
      local addr     = flat:match('"bridge_address"%s*:%s*"([^"]+)"')
      local rootAddr = flat:match('"root_bridge_address"%s*:%s*"([^"]+)"')
      local rootPri  = flat:match('"root_bridge_priority"%s*:%s*(%d+)')
      if pri      then SetBridgePriority(pri) end
      if addr     then SetBridgeAddress(addr) end
      if rootPri  then SetRootBridgePriority(rootPri) end
      if rootAddr then SetRootBridgeAddress(rootAddr) end
      local ports = body:match('"ports"%s*:%s*(%b[])')
      if not ports then return end
      for obj in ports:gmatch("%b{}") do
        local n    = obj:match('"port_number"%s*:%s*(%d+)')
        local role = obj:match('"role"%s*:%s*"([^"]+)"')
        if n and role then SetPortRstpRole(tonumber(n), role) end
      end
    end),
  }
end

-- A design saved with the former "5 s" choice polls every 15 s.
function pollIntervalSeconds()
  local secs = tonumber(Properties["Poll Interval"].Value:match("(%d+)")) or 0   -- "Off" => 0
  if secs > 0 and secs < 15 then return 15 end
  return secs
end

function startPollTimer()
  stopPollTimer()
  local secs = pollIntervalSeconds()
  log("poll interval: " .. secs .. " s")
  if secs <= 0 then return end
  state.pollTimer = Timer.New()
  state.pollTimer.EventHandler = function() reconcileIfIdle() end
  state.pollTimer:Start(secs)
end

function stopPollTimer()
  if state.pollTimer then
    state.pollTimer:Stop()
    state.pollTimer = nil
  end
end

--------------------------------------------------------------------------------
-- Custom group / trunk color sync (REST snapshot)
--   /api/groups and /api/trunks return color as "#RRGGBB" per entry.
--   Populates state.customColors so renderPortUI can resolve any memberOf
--   — predefined or user-defined — to its live color.
--------------------------------------------------------------------------------
local function parseHexColor(hex)
  local r = tonumber(hex:sub(2, 3), 16)
  local g = tonumber(hex:sub(4, 5), 16)
  local b = tonumber(hex:sub(6, 7), 16)
  if r and g and b then return { r, g, b } end
end

local function parseBool(s)
  return s == "true"
end

function fetchCustomColors()
  log("fetchCustomColors: GET /api/groups + /api/trunks on " .. tostring(state.baseIP))
  -- Groups
  HttpClient.Get {
    Url     = string.format("http://%s/api/groups", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/groups => HTTP " .. tostring(code) .. " body=" .. type(body) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      state.groupList = {}
      -- Split the body into per-group segments by locating each
      -- '"group_id":' marker; each segment ends where the next marker
      -- begins (or at end-of-body for the last). Each segment contains
      -- that group's top-level fields (name, color, predefined) before
      -- its nested IGMP/AVB/boundary_clock objects — so simple regex
      -- matches within the segment reliably extract them.
      local positions = {}
      for pos in body:gmatch('()"group_id"%s*:') do
        positions[#positions + 1] = pos
      end
      for i, start in ipairs(positions) do
        local finish = (positions[i + 1] or (#body + 1)) - 1
        local chunk = body:sub(start, finish)
        local gid   = chunk:match('"group_id"%s*:%s*(%d+)')
        local name  = chunk:match('"name"%s*:%s*"([^"]*)"')
        local color = chunk:match('"color"%s*:%s*"(#%x+)"')
        local pre   = chunk:match('"predefined"%s*:%s*(%a+)')
        local vid   = tonumber(chunk:match('"vid"%s*:%s*(%d+)'))
        if gid and color then
          local rgb = parseHexColor(color)
          if rgb then
            local key = "Group: " .. gid
            state.customColors[key] = rgb
            state.groupList[#state.groupList + 1] = {
              id = tonumber(gid),
              name = name or "",
              color = rgb,
              predefined = (pre == "true"),
              vid = vid,
            }
          end
        end
      end
      local ids = {}
      for _, g in ipairs(state.groupList) do ids[#ids+1] = tostring(g.id) end
      log("fetchCustomColors groups parsed (" .. #state.groupList .. "): " .. table.concat(ids, ","))
      for p = 1, state.portCount do renderPortUI(p) end
      for _, g in ipairs(state.groupList) do
        state.groupNames[g.id] = g.name
        SetGroupLabel(g.id, g.name)
      end
      refreshCustomSlots()
      updatePortGroupChoices()
      subscribeGroups()
      subscribeVlanStates()
      refreshQuerierBadges()
    end),
  }

  -- Trunks
  HttpClient.Get {
    Url     = string.format("http://%s/api/trunks", state.baseIP),
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    Timeout = 10,
    EventHandler = counted(function(_tbl, code, body, err)
      log("GET /api/trunks => HTTP " .. tostring(code) .. " body=" .. type(body) .. " " .. tostring(err or ""))
      if code ~= 200 or type(body) ~= "string" then return end
      state.trunkList = {}
      -- Per-trunk segment split by "trunk_id" marker (same approach as
      -- groups above — robust against nested objects in the payload).
      local positions = {}
      for pos in body:gmatch('()"trunk_id"%s*:') do
        positions[#positions + 1] = pos
      end
      for i, start in ipairs(positions) do
        local finish = (positions[i + 1] or (#body + 1)) - 1
        local chunk = body:sub(start, finish)
        local tid   = chunk:match('"trunk_id"%s*:%s*(%d+)')
        local name  = chunk:match('"name"%s*:%s*"([^"]*)"')
        local color = chunk:match('"color"%s*:%s*"(#%x+)"')
        local pre   = chunk:match('"predefined"%s*:%s*(%a+)')
        if tid and color then
          local rgb = parseHexColor(color)
          if rgb then
            local key = "Trunk: " .. tid
            state.customColors[key] = rgb
            state.trunkList[#state.trunkList + 1] = {
              id = tonumber(tid),
              name = name or "",
              color = rgb,
              predefined = (pre == "true"),
            }
          end
        end
      end
      local tids = {}
      for _, t in ipairs(state.trunkList) do tids[#tids+1] = tostring(t.id) end
      log("fetchCustomColors trunks parsed (" .. #state.trunkList .. "): " .. table.concat(tids, ","))
      state.trunkNames = state.trunkNames or {}
      for _, t in ipairs(state.trunkList) do
        state.trunkNames[t.id] = t.name
        SetTrunkLabel(t.id, t.name)
      end
      for p = 1, state.portCount do renderPortUI(p) end
      refreshCustomSlots()
      updatePortGroupChoices()
    end),
  }
end

-- Build the Port.Group ComboBox choices from the live group/trunk lists and
-- assign them to every port's control. Choice strings are formatted as
-- "Group N (name)" / "Trunk N (name)" with "(unassigned)" as a no-op option.
function updatePortGroupChoices()
  local choices = { "(unassigned)" }
  for _, g in ipairs(state.groupList or {}) do
    choices[#choices + 1] = string.format("Group %d (%s)", g.id, g.name or "")
  end
  for _, t in ipairs(state.trunkList or {}) do
    choices[#choices + 1] = string.format("Trunk %d (%s)", t.id, t.name or "")
  end
  for p = 1, state.portCount do
    local c = Controls["Port.Group " .. p]
    if c then c.Choices = choices end
  end
end

-- Resolve a memberOf token ("Group: N" / "Trunk: N") to the friendly
-- name. Prefers state.groupNames / state.trunkNames (kept in sync by both
-- the REST snapshot and WS /groups/group/N/name notifications), then
-- falls back to "Group N" / "Trunk N".
function memberOfDisplayName(memberOf)
  if not memberOf or memberOf == "" then return "" end
  local kind, id = memberOf:match("^(%a+):%s*(%d+)$")
  if not kind or not id then return memberOf end
  local idNum = tonumber(id)
  local map = (kind == "Group") and state.groupNames or state.trunkNames
  local nm = map and map[idNum]
  if nm and nm ~= "" then return nm end
  return string.format("%s %d", kind, idNum)
end

--------------------------------------------------------------------------------
-- WebSocket lifecycle
--------------------------------------------------------------------------------
-- Reconnect backoff: 5 s, doubled after every attempt up to 60 s. Every
-- connect replays the whole subscription burst and two reconciles (~70 % CPU
-- on a 30i when looped every 5 s), so a switch that accepts the socket and
-- drops it is not hammered. A connection that holds 60 s (Connected) and the
-- Connect button (connectToSwitch) bring it back to 5 s.
state.reconnectDelay = state.reconnectDelay or 5

function scheduleReconnect()
  if state.reconnectTimer then return end
  local delay = state.reconnectDelay
  state.reconnectDelay = math.min(delay * 2, 60)
  state.reconnectTimer = Timer.New()
  state.reconnectTimer.EventHandler = function()
    state.reconnectTimer:Stop()
    state.reconnectTimer = nil
    if state.baseIP and state.baseIP ~= "" then openWS(state.baseIP) end
  end
  state.reconnectTimer:Start(delay)
end

function openWS(ip)
  state.baseIP = ip

  if state.reconnectTimer then
    state.reconnectTimer:Stop()
    state.reconnectTimer = nil
  end
  if state.ws then
    local old = state.ws
    state.ws = nil
    pcall(function() old:Close() end)
  end

  state.ws = WebSocket.New()
  local thisWs = state.ws

  state.ws.Connected = function()
    log("WebSocket Connected")
    -- The subscription burst, /api/device and /api/power refill these.
    state.modelMismatch, state.psuStates, state.fanStates = nil, {}, {}
    -- A new socket has no VLAN subscriptions; /api/groups writes them again.
    -- The redraws blank a previous switch's querier and MR badges (an IP change
    -- supersedes the old socket without its Closed, so clearPortCards did not run).
    state.querierByVid, state.routerPortsByVid, state.vlanSubscribed = {}, {}, {}
    state.lagRoleSubscribed, state.groupSubscribed, state.poeSubscribed = {}, {}, false
    refreshQuerierBadges()
    refreshMrPorts()
    -- Same reason for the neighbors: Fill or -> Legend must never write a
    -- previous switch's neighbor to this one (the subscription answer refills).
    closeLldpPanel()
    clearLldp()
    SetConnection("online")
    local ok, err = pcall(function()
      updateAuthStatus("Authenticated", "#00A000")
      subscribeAllPorts()
      subscribeAllSystem()
      SetDeviceStatus("online")
      fetchDeviceInfo()
    end)
    if not ok then log("Connected handler error (subscriptions): " .. tostring(err)) end
    -- The follow-up reconcile and the backoff reset belong to this socket:
    -- skipped once it has closed or been superseded.
    local function stillOnline() return state.ws == thisWs and state.connection == "online" end
    ok, err = pcall(function()
      reconcileAll()
      Timer.CallAfter(function() if stillOnline() then reconcileIfIdle() end end, 3)
      Timer.CallAfter(function() if stillOnline() then state.reconnectDelay = 5 end end, 60)
      startPollTimer()
    end)
    if not ok then log("Connected handler error (reconcile): " .. tostring(err)) end
  end

  state.ws.Data = function(_, data)
    if state.verboseWs then log("Data: " .. tostring(data)) end
    if data:find('"api_notification"') then
      parseNotification(data)
    end
  end

  state.ws.Error = function(_, err)
    if state.ws ~= thisWs then return end  -- superseded socket
    log("WebSocket Error: " .. (err or "none"))
    stopPollTimer()
    if err and err:find("unauthorized") then
      updateAuthStatus("Auth failed", "#C80000")
      SetConnection("unauthorized")
    else
      SetConnection("offline")
    end
    SetDeviceStatus("offline")
    clearPortCards()
    scheduleReconnect()
  end

  state.ws.Closed = function()
    if state.ws ~= thisWs then return end  -- superseded socket
    log("WebSocket Closed")
    stopPollTimer()
    -- A close after an auth failure keeps the Fault.
    if state.connection ~= "unauthorized" then SetConnection("offline") end
    SetDeviceStatus("offline")
    clearPortCards()
    scheduleReconnect()
  end

  local user = Controls["Auth.Username"] and Controls["Auth.Username"].String or ""
  local pass = Controls["Auth.Password"] and Controls["Auth.Password"].String or ""
  local headers = {}
  if user ~= "" and pass ~= "" then
    local token = Crypto.Base64Encode(user .. ":" .. pass)
    headers["Authorization"] = "Basic " .. token
  end

  log("Connecting => ws://" .. ip .. "/api/ws on port 80")
  state.ws:Connect("ws", ip, "api/ws", 80, nil, headers)
end

--------------------------------------------------------------------------------
-- Device info formatting
--------------------------------------------------------------------------------
-- Display.Model is transparent at layout time so its static offline
-- placeholder (the model name) shows through. Paint it opaque when live
-- data lands so it covers the placeholder. The other device-info boxes have
-- no placeholder and stay transparent.
function paintHeaderBox(ctrl)
  local theme = getThemeColors()
  pcall(function() ctrl.Color = rgbHex(theme.pageBg) end)
end

-- Display line "<ip>/<prefix> (<mode>)"; the raw values are the
-- Device.Actual IP.* and IP Settings.Mode pins (handleDevicePath).
function updateIPinfo()
  local ip   = (state.currentIP    ~= "" and state.currentIP)    or "???"
  local pref = (state.prefixLength ~= "" and state.prefixLength) or "??"
  local mode = (state.ipMode       ~= "" and state.ipMode)       or "???"
  local combined = string.format("%s/%s (%s)", ip, pref, mode)
  if Controls["Display.IP Info"] then
    Controls["Display.IP Info"].String = combined
  end
end

-- Device.Actual IP.Default Gateway gets the raw value (0.0.0.0 included).
-- The display line stays blank while the switch has no gateway, which the
-- API reports as 0.0.0.0.
function updateGateway(ip)
  if not ip then return end
  setPinString("Device.Actual IP.Default Gateway", ip)
  local ctrl = Controls["Display.Gateway"]
  if not ctrl then return end
  ctrl.String = (ip ~= "" and ip ~= "0.0.0.0") and ("Gateway " .. ip) or ""
end

-- Single line: the boxes are one row tall, a wrapped second line was cut.
function formatDeviceName(rawName)
  return rawName
end

function formatDeviceDesc(rawDesc)
  return rawDesc
end

-- MAC and firmware boxes are the pins: blank until known.
function updateMac_Firmware()
  for name, value in pairs({ ["Device.MAC Address"]     = state.macAddress,
                             ["Device.Firmware.Active"] = state.firmwareVersion }) do
    local ctrl = Controls[name]
    if ctrl then ctrl.String = value or "" end
  end
end

function updateAuthStatus(text, color)
  local ctrl = Controls["Auth.Status"]
  if not ctrl then return end
  ctrl.String = text
  ctrl.Color  = (text ~= "") and (color or "#800000") or "#00000000"
end

--------------------------------------------------------------------------------
-- Group layout helpers (data-driven — called from WS handlers)
--------------------------------------------------------------------------------
function layoutGroupBlock(index)
  local baseX, baseY = 0, 0
  local paddingX, paddingY = 10, 10
  local blockW, blockH = 100, 50
  local gridCols = 4

  if index <= 20 then
    local col = (index - 1) % gridCols
    local row = math.floor((index - 1) / gridCols)
    return baseX + col * (blockW + paddingX),
           baseY + row * (blockH + paddingY)
  else
    local colOffset = index - 21
    return baseX + gridCols * (blockW + paddingX) + colOffset * (blockW + paddingX),
           baseY
  end
end

function createGroupLayout()
  for groupId = 1, 20 do
    if state.groupMeta and state.groupMeta[groupId] then
      local _x, _y = layoutGroupBlock(groupId)
    end
  end
end

--------------------------------------------------------------------------------
-- WebSocket notification parser
--------------------------------------------------------------------------------
function extractPath(raw)   return raw:match('"path"%s*:%s*"([^"]+)"') end
function extractString(raw) return raw:match('"new_value"%s*:%s*"([^"]+)"') end
function extractNumber(raw) return raw:match('"new_value"%s*:%s*(%d+)') end
function extractSignedNumber(raw) return raw:match('"new_value"%s*:%s*(-?%d+)') end
function extractBool(raw)   return raw:match('"new_value"%s*:%s*(%a+)') end

function handleDevicePath(path, raw)
  if path == "/device/name" then
    local v = extractString(raw)
    if v and Controls["Device.Name"] then
      Controls["Device.Name"].String = formatDeviceName(v)
    end
    return true
  end

  if path == "/device/description" then
    local v = extractString(raw)
    if v and Controls["Device.Description"] then
      Controls["Device.Description"].String = formatDeviceDesc(v)
    end
    return true
  end

  if path == "/device/mac_address" then
    local v = extractString(raw)
    if v then state.macAddress = v; updateMac_Firmware() end
    return true
  end

  if path == "/device/firmware/active" then
    local v = extractString(raw)
    if v then state.firmwareVersion = v; updateMac_Firmware() end
    return true
  end

  if path == "/device/hostname" then
    local v = raw:match('"new_value"%s*:%s*"([^"]*)"')
    if v then setPinString("Device.Hostname", v) end
    return true
  end

  if path == "/device/actual_ip/ip_address" then
    local v = extractString(raw)
    if v then
      state.currentIP = v
      setPinString("Device.Actual IP.IP Address", v)
      updateIPinfo()
    end
    return true
  end

  if path == "/device/actual_ip/prefix_length" then
    local v = extractNumber(raw)
    if v then
      state.prefixLength = v
      setPinValue("Device.Actual IP.Prefix Length", v)
      updateIPinfo()
    end
    return true
  end

  if path == "/device/actual_ip/default_gateway" then
    updateGateway(extractString(raw))
    return true
  end

  if path == "/ip_settings/mode" then
    local v = extractString(raw)
    if v then
      state.ipMode = v
      setPinString("IP Settings.Mode", v)
      updateIPinfo()
    end
    return true
  end

  return false
end

function handleGroupPath(path, raw)
  local gid, field = path:match("^/groups/group/(%d+)/(.+)$")
  if not gid then return false end
  gid = tonumber(gid)

  if field == "name" then
    local name = extractString(raw)
    if name then
      state.groupNames = state.groupNames or {}
      state.groupNames[gid] = name
      SetGroupLabel(gid, name)
      -- Refresh every port row so the Group display shows the new name.
      for p = 1, (state.portCount or 0) do renderPortUI(p) end
    end
    return true
  end

  if field == "group_id" then
    local v = extractNumber(raw)
    if v then
      state.groupMeta = state.groupMeta or {}
      state.groupMeta[gid] = state.groupMeta[gid] or {}
      state.groupMeta[gid].id = tonumber(v)

      updateGroupUI(gid)
      SetGroupLabel(gid, state.groupNames[gid] or ("Group " .. gid))
      createGroupLayout()
    end
    return true
  end

  return false
end

function handlePortPath(path, raw)
  local port = path:match("/ports/port/(%d+)/")
              or path:match("/poe/ports/(%d+)/")
              or path:match("/rlinkx/ports/(%d+)/")
  if not port then return false end
  port = tonumber(port)

  if path == ("/ports/port/" .. port .. "/enabled") then
    local v = extractBool(raw)
    if v then SetPortEnabled(port, v == "true") end
    return true
  end

  if path == ("/ports/port/" .. port .. "/legend") then
    -- Decoded (quotes, backslashes); an emptied legend ("") lands too.
    local v = lldpJsonString(raw, "new_value")
    if v then SetPortLegend(port, v) end
    return true
  end

  if path == ("/ports/port/" .. port .. "/link_state") then
    local v = extractString(raw)
    if v then SetPortLinkState(port, v) end
    return true
  end

  if path == ("/ports/port/" .. port .. "/member_of") then
    local obj = raw:match('"new_value"%s*:%s*{(.-)}')
    if obj then
      local t  = obj:match('"type"%s*:%s*"([^"]+)"')
      local id = obj:match('"id"%s*:%s*(%d+)')
      if t and id then
        SetPortMemberOf(port, t == "trunk" and ("Trunk: " .. id) or ("Group: " .. id))
      elseif t == "none" then
        SetPortMemberOf(port, nil)
      end
    else
      local v = extractString(raw)
      if v then SetPortMemberOf(port, v) end
    end
    return true
  end

  if path == ("/poe/ports/" .. port .. "/indication") then
    -- "" is a real value (web UI: same grey as disabled), unlike extractString.
    local v = raw:match('"new_value"%s*:%s*"([^"]*)"')
    if v then SetPortIndication(port, v) end
    return true
  end

  if path == ("/poe/ports/" .. port .. "/enabled") then
    local v = extractBool(raw)
    if v then SetPortPoeEnabled(port, v == "true") end
    return true
  end

  if path == ("/ports/port/" .. port .. "/rlinkx") then
    -- Per-port config: {"enabled": true/false}. We only learn disabled vs
    -- enabled here; the "active" (redundant) state comes from /rlinkx/ports/N/state.
    local obj = raw:match('"new_value"%s*:%s*{(.-)}')
    if obj then
      SetPortRlinkxEnabled(port, obj:match('"enabled"%s*:%s*(%a+)') == "true")
    end
    return true
  end

  if path == ("/rlinkx/ports/" .. port .. "/state") then
    -- State machine values: disabled, non-redundant, redundant,
    -- partial-redundant, invalid-version
    local v = extractString(raw)
    if v then SetPortRlinkxState(port, v) end
    return true
  end

  if path:find("/link_speed") then
    -- new_value is {"mode":..,"speed":[..]}, {"speed":[..]} when only the
    -- speed changed, a bare "fixed" on the /link_speed/mode sub-path or a
    -- bare [..] on /link_speed/speed. The Link Speed pins take each field
    -- as it comes; the displayed label depends on the speed alone ("all" =
    -- Auto).
    local mode, list
    if path:find("/link_speed/mode$") then
      mode = raw:match('"new_value"%s*:%s*"([^"]*)"')
    elseif path:find("/link_speed/speed$") then
      list = speedListFromArray(raw:match('"new_value"%s*:%s*(%b[])'))
    else
      local obj = raw:match('"new_value"%s*:%s*(%b{})')
      if obj then
        mode = obj:match('"mode"%s*:%s*"([^"]*)"')
        list = speedListFromArray(obj:match('"speed"%s*:%s*(%b[])'))
      end
    end
    if mode or list then SetPortLinkSpeedFields(port, mode, list) end

    local speed = raw:match('"speed"%s*:%s*%[%s*"([^"]+)"')
    if not speed and path:find("/link_speed/speed$") then
      speed = raw:match('"new_value"%s*:%s*%[%s*"([^"]+)"')
    end
    if speed then
      SetPortSpeed(port, (speed == "all") and "Auto" or speed)
    end
    return true
  end

  return false
end

function parseNotification(raw)
  if state.verboseWs then log("parseNotification => " .. raw) end
  local path = extractPath(raw)
  if not path then return end
  if handleDevicePath(path, raw)       then return end
  if handleGroupPath(path, raw)        then return end
  if handleLldpPath(path, raw)         then return end
  if path:find("^/ports/lags/lag")     then scheduleLagSync() return end
  if handlePortPath(path, raw)         then return end
  if handleSystemPath(path, raw)       then return end
  if handleFanPath(path, raw)          then return end
  if handlePowerPath(path, raw)        then return end
  if handleSpanningTreePath(path, raw) then return end
  if handleSnoopingPath(path, raw)     then return end
end

--------------------------------------------------------------------------------
-- Port state setters (STATE → UI)
--------------------------------------------------------------------------------
-- Raw link_state ("1gbps fdx", "100mbps hdx", "down", "unknown").
function SetPortLinkState(port, raw)
  getPortState(port).linkState = raw
  renderPortUI(port)
end

function SetPortEnabled(port, enabled)
  getPortState(port).enabled = enabled
  renderPortUI(port)
end

function SetPortMemberOf(port, textVal)
  local p = getPortState(port)
  p.memberOf = textVal
  p.memberOfKnown = true
  renderPortUI(port)
end

function SetPortIndication(port, textVal)
  getPortState(port).poe = textVal
  renderPortUI(port)
end

-- RLinkX state machine value (/rlinkx/ports/N/state, GET /api/rlinkx):
-- disabled, non-redundant, redundant, partial-redundant, invalid-version.
-- The card's jack border shows it; it does not change the enabled pin.
function SetPortRlinkxState(port, raw)
  getPortState(port).rlinkxState = raw
  renderPortUI(port)
end

-- Per-port RLinkX config flag (/ports/port/N/rlinkx, GET /api/ports), the
-- Ports.Port N.RLinkX.Enabled pin.
function SetPortRlinkxEnabled(port, enabled)
  getPortState(port).rlinkxEnabled = enabled
  renderPortUI(port)
end

function SetPortLegend(port, value)
  getPortState(port).legend = value
  setPinString("Ports.Port " .. port .. ".Legend", value)
end

-- Raw link_speed fields for the Link Speed pins; nil leaves a field as is.
function SetPortLinkSpeedFields(port, mode, speedList)
  local p = getPortState(port)
  if mode then p.linkSpeedMode = mode end
  if speedList then p.linkSpeedList = speedList end
  renderPortUI(port)
end

function SetPortSpeed(port, label)
  local p = getPortState(port)
  p.speed          = SPEED_UI_MAP[label] or label
  p.lastValidSpeed = p.speed
  p.speedPending   = false
  renderPortUI(port)
end

function SetPortPoeEnabled(port, enabled)
  getPortState(port).poeEnabled = enabled
  renderPortUI(port)
end

--------------------------------------------------------------------------------
-- System / chassis setters
--------------------------------------------------------------------------------
local function setCtrlString(name, value)
  local c = Controls[name]
  if c then c.String = value end
end

local function setCtrlColor(name, color)
  local c = Controls[name]
  if c then c.Color = color end
end

-- Raw integer pins (degrees C, rpm, %, mW); a sensor, fan or PSU slot the
-- model lacks has no control and is skipped.
function SetCaseTemp(v)
  setPinValue("Temperatures.Case.Current", v)
end

function SetCpuTemp(v)
  setPinValue("Temperatures.CPU.Current", v)
end

function SetFanSpeed(id, v)
  setPinValue("Fans.Fan " .. id .. ".Speed", v)
end

-- PSU icon tinted by state, as the switch web UI draws it. The color lives
-- in the SVG itself, pushed through the Button Legend as EzSVG does
-- ({DrawChrome=false, IconData=<base64 svg>}). Same paths as LogoPSU (the
-- grey offline placeholder drawn under the control), no background, no
-- clip-path: Designer rendered the Inkscape export's clipped paths as a
-- plain dark square, and runtime StrokeColor writes never showed.
local PSU_ICON_COLORS = {
  good = "#00C800", ok = "#00C800", redundant = "#00C800",
  warning = "#E6B400", absent = "#5A6478", [""] = "#5A6478",
}

local function psuIconSvg(color)
  return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 9.9727 9.9668\"><g transform=\"matrix(0.37100573,0,0,-0.37078499,8.72601,0)\"><path fill=\"" .. color .. "\" d=\"m 0,0 h -20.16 c -1.854,-0.006 -3.354,-1.506 -3.36,-3.36 v -15.12 c 0.006,-1.854 1.506,-3.354 3.36,-3.36 h 5.04 v 3.36 h -5.04 v 15.12 h 1.68 V -8.4 h 3.36 v 5.04 h 3.36 V -8.4 h 3.36 v 5.04 h 3.36 V -8.4 h 3.36 v 5.04 H 0 v -15.12 h -5.04 v -3.36 H 0 c 1.854,0.006 3.354,1.506 3.36,3.36 V -3.36 C 3.354,-1.506 1.854,-0.006 0,0\"/></g><g transform=\"matrix(0.37100573,0,0,-0.37078499,5.84222,4.36055)\"><path fill=\"" .. color .. "\" d=\"m 0,0 h -4.332 l -2.734,-6.72 h 3.444 l -2.928,-8.4 8.194,11.76 h -3.552 z\"/></g></svg>"
end

-- PSU state (good / warning / error / invalid, "" for an empty slot): the
-- pin and the status-block icon tint. power_status is a separate pin and
-- does not touch the icon.
function SetPsuState(id, value)
  setPinString("Power.PSU " .. id .. ".State", value)
  state.psuStates[id] = value
  refreshStatus()
  local icon = Controls["PSU." .. id .. " Icon"]
  if not icon then return end
  local svg = psuIconSvg(PSU_ICON_COLORS[value or ""] or "#DC2828")
  icon.Legend = '{"DrawChrome":false,"IconData":"' .. Crypto.Base64Encode(svg) .. '","Legend":""}'
end

function SetPsuPowerStatus(id, value)
  setPinString("Power.PSU " .. id .. ".Power Status", value)
end

function SetPsuPower(id, milliwatts)
  setPinValue("Power.PSU " .. id .. ".Power Usage", milliwatts)
end

function SetTotalPower(milliwatts)
  setPinValue("Power.Total Power Usage", milliwatts)
end

function SetTotalPowerMax(milliwatts)
  setPinValue("Power.Total Power Max", milliwatts)
end

-- Switch-wide RLinkX flag (/rlinkx/enabled, GET /api/rlinkx).
function SetRlinkxEnabled(value)
  setPinBoolean("RLinkX.Enabled", value)
end

-- Coupling indicator between the two PSU icons, as the switch web UI draws
-- it: "▼▲" in redundant mode, "⊕" in shared mode, the glyph itself colored
-- by the coupling state (green good, amber warning, red otherwise, the PSU
-- icon palette) on the screen background. Drawn as an SVG through the Button
-- Legend like the PSU icons; the viewBox is the 48 x 14 box minus the 2 px
-- Button inset. With a PSU slot empty (state.psuMissing, from /api/power) the
-- switch reports "No redundancy because only 1 PSU is powered" as a coupling
-- warning; the plugin keeps that one green.
state.couplingMode  = state.couplingMode  or ""
state.couplingState = state.couplingState or "good"
state.psuMissing    = state.psuMissing    or false

local function couplingGlyphSvg(mode, color)
  local body
  if mode == "redundant" then
    body = '<path d="M13,1 H21 L17,9 Z" fill="' .. color .. '"/><path d="M23,9 H31 L27,1 Z" fill="' .. color .. '"/>'
  elseif mode == "shared" then
    body = '<circle cx="22" cy="5" r="4" fill="none" stroke="' .. color .. '" stroke-width="1.5"/>'
      .. '<path d="M18,5 H26 M22,1 V9" stroke="' .. color .. '" stroke-width="1.5"/>'
  else
    return nil
  end
  return '<svg xmlns="http://www.w3.org/2000/svg" width="44" height="10" viewBox="0 0 44 10">' .. body .. '</svg>'
end

local function refreshCoupling()
  local c = Controls["Power.Coupling Glyph"]
  if not c then return end
  local color = "#DC2828"
  if state.couplingState == "good" or state.psuMissing then color = PSU_ICON_COLORS.good
  elseif state.couplingState == "warning" then color = PSU_ICON_COLORS.warning
  end
  local svg = couplingGlyphSvg(state.couplingMode, color)
  c.Legend = svg and iconLegend(svg) or ""
end

function SetPowerCoupling(mode)
  state.couplingMode = mode or ""
  setPinString("Power.Coupling.Mode", state.couplingMode)
  refreshCoupling()
end

function SetCouplingState(status)
  state.couplingState = status or "good"
  refreshCoupling()
end

-- CPU load averaged over 3 s (cpu_load) and 30 s (cpu_load_long), in %.
function SetCpuLoad(v)
  setPinValue("System.CPU Load", v)
end

function SetCpuLoadLong(v)
  setPinValue("System.CPU Load Long", v)
end

function SetBridgePriority(v)
  setCtrlString("RSTP.Bridge Priority", tostring(v))
end

state.bridgeAddr     = state.bridgeAddr     or ""
state.rootBridgeAddr = state.rootBridgeAddr or ""
state.rootBridgePri  = state.rootBridgePri  or ""

-- "this switch" when the root bridge address is our own bridge address
-- (REST-only field, never changes), otherwise "<mac> (<priority>)".
local function refreshRootBridge()
  if state.rootBridgeAddr == "" and state.rootBridgePri == "" then return end
  if state.bridgeAddr ~= "" and state.rootBridgeAddr == state.bridgeAddr then
    setCtrlString("RSTP.Root Bridge", "this switch")
  else
    local addr = state.rootBridgeAddr ~= "" and state.rootBridgeAddr or "??"
    local pri  = state.rootBridgePri  ~= "" and state.rootBridgePri  or "?"
    setCtrlString("RSTP.Root Bridge", string.format("%s (%s)", addr, pri))
  end
end

function SetBridgeAddress(addr)
  state.bridgeAddr = addr or ""
  refreshRootBridge()
end

function SetRootBridgeAddress(addr)
  state.rootBridgeAddr = addr or ""
  refreshRootBridge()
end

function SetRootBridgePriority(pri)
  state.rootBridgePri = tostring(pri or "")
  refreshRootBridge()
end

-- RSTP role per port; "root" and "alternate" are drawn as the Araneo "root" /
-- "alt" badges inside the port card (portCardView rstpRole). A LAG port's
-- role (66 and up) is drawn on its members.
function SetPortRstpRole(port, role)
  local p = getPortState(port)
  if p.rstpRole == role then return end
  p.rstpRole = role
  renderPortUI(port)
  for _, member in ipairs(state.lagMembers[port] or {}) do renderPortUI(member) end
end

-- The per-port role subscriptions cover the chassis ports only: each LAG port
-- from /api/ports/lags/lag gets its own, once per socket.
function subscribeLagRoles()
  if not state.ws then return end
  for lagPort in pairs(state.lagMembers) do
    if not state.lagRoleSubscribed[lagPort] then
      state.lagRoleSubscribed[lagPort] = true
      state.ws:Write(string.format(
        '{"subscription":{"path":"/spanning_tree/mst/0/ports/%d/role","action":"add","method":"changes"}}', lagPort))
    end
  end
end

-- IGMP snooping router ports: like Araneo, a port is MR when it, or the LAG
-- it is a member of, is a router port in any group VLAN
-- (state.routerPortsByVid, one WS subscription per vid); the MR badge is
-- drawn inside the port card.
function refreshMrPorts()
  local routerPorts = {}
  for _, ports in pairs(state.routerPortsByVid) do
    for _, port in ipairs(ports) do routerPorts[port] = true end
  end
  for port = 1, state.portCount do
    local p = getPortState(port)
    local lag = state.lagOf[port]
    local mr = routerPorts[port] == true or (lag ~= nil and routerPorts[lag] == true)
    if p.mr ~= mr then
      p.mr = mr
      renderPortUI(port)
    end
  end
end

--------------------------------------------------------------------------------
-- WS path handlers for system/power/fans/spanning_tree/snooping
--------------------------------------------------------------------------------
-- Temperatures can be negative: matched with a sign. The case temperature
-- comes from the case sensor only (/system/temperature/current is the CPU's).
function handleSystemPath(path, raw)
  if path == "/system/cpu_load" then
    local v = extractNumber(raw); if v then SetCpuLoad(v) end
    return true
  end
  if path == "/system/cpu_load_long" then
    local v = extractNumber(raw); if v then SetCpuLoadLong(v) end
    return true
  end
  if path == "/temperatures/temperature/case/current" then
    local v = extractSignedNumber(raw); if v then SetCaseTemp(v) end
    return true
  end
  if path == "/temperatures/temperature/cpu/current" then
    local v = extractSignedNumber(raw); if v then SetCpuTemp(v) end
    return true
  end
  if path == "/rlinkx/enabled" then
    local v = extractBool(raw)
    if v == "true" or v == "false" then SetRlinkxEnabled(v == "true") end
    return true
  end
  return false
end

function handleFanPath(path, raw)
  local id = path:match("^/fans/fan/(%d+)/speed$")
  if id then
    local v = extractNumber(raw); if v then SetFanSpeed(tonumber(id), v) end
    return true
  end
  local id2 = path:match("^/fans/fan/(%d+)/state$")
  if id2 then
    local v = extractString(raw); if v then SetFanState(tonumber(id2), v) end
    return true
  end
  return false
end

function handlePowerPath(path, raw)
  if path == "/power/coupling/mode" then
    local v = extractString(raw); if v then SetPowerCoupling(v) end
    return true
  end
  if path == "/power/coupling/state" then
    local v = extractString(raw); if v then SetCouplingState(v) end
    return true
  end
  if path == "/power/total_power_usage" then
    local v = extractNumber(raw); if v then SetTotalPower(v) end
    return true
  end
  if path == "/power/total_power_max" then
    local v = extractNumber(raw); if v then SetTotalPowerMax(v) end
    return true
  end
  local psu, field = path:match("^/power/psus/(psu%d+)/(.+)$")
  if not psu then return false end
  local id = tonumber(psu:match("(%d+)"))
  if field == "state" then
    local v = extractString(raw); if v then SetPsuState(id, v) end
    return true
  end
  if field == "power_status" then
    local v = extractString(raw); if v then SetPsuPowerStatus(id, v) end
    return true
  end
  if field == "power_usage" then
    -- -1 is the API error marker
    local v = extractSignedNumber(raw); if v then SetPsuPower(id, v) end
    return true
  end
  return false
end

function handleSpanningTreePath(path, raw)
  if path == "/spanning_tree/mst/0/bridge_priority" then
    local v = extractNumber(raw); if v then SetBridgePriority(v) end
    return true
  end
  if path == "/spanning_tree/mst/0/root_bridge_address" then
    local v = extractString(raw); if v then SetRootBridgeAddress(v) end
    return true
  end
  if path == "/spanning_tree/mst/0/root_bridge_priority" then
    local v = extractNumber(raw); if v then SetRootBridgePriority(v) end
    return true
  end
  local port = path:match("^/spanning_tree/mst/0/ports/(%d+)/role$")
  if port then
    local v = extractString(raw); if v then SetPortRstpRole(tonumber(port), v) end
    return true
  end
  return false
end

function handleSnoopingPath(path, raw)
  local routerVid = path:match("^/snooping/vlan/(%d+)/router_ports$")
  if routerVid then
    -- new_value is an array: "new_value":[3,5,7]
    local arr = raw:match('"new_value"%s*:%s*%[(.-)%]')
    local ports = {}
    if arr then
      for n in arr:gmatch("%d+") do ports[#ports+1] = tonumber(n) end
    end
    state.routerPortsByVid[tonumber(routerVid)] = ports
    refreshMrPorts()
    return true
  end
  local vid = path:match("^/snooping/vlan/(%d+)/igmp_querier_state$")
  if vid then
    local v = extractString(raw); if v then SetQuerierState(tonumber(vid), v) end
    return true
  end
  return false
end

--------------------------------------------------------------------------------
-- Device status (with offline pulse)
--------------------------------------------------------------------------------
offlinePulseTimer = nil
pulseOn = false

-- The badge in the left display block and the dot in the right status
-- block (as on the switch web UI) share one color.
local function paintDeviceStatus(color)
  local badge = Controls["Display.Status"]
  if badge then badge.Color = color end
  local dot = Controls["Display.Status Dot"]
  if dot then
    dot.Color = color
    pcall(function() dot.OffColor = color end)
  end
end

function SetDeviceStatus(status)
  local ctrl = Controls["Display.Status"]
  if not ctrl then return end

  if status == "online" then
    if offlinePulseTimer then
      offlinePulseTimer:Stop()
      offlinePulseTimer = nil
    end
    pulseOn = false
    ctrl.String = "Online"
    paintDeviceStatus("#00C800")
  elseif status == "offline" then
    ctrl.String = "Offline"
    if not offlinePulseTimer then
      offlinePulseTimer = Timer.New()
      offlinePulseTimer.EventHandler = function()
        pulseOn = not pulseOn
        paintDeviceStatus(pulseOn and "#C80000" or "#800000")
      end
      offlinePulseTimer:Start(0.5)
    end
  end
end

--------------------------------------------------------------------------------
-- Querier panel (status block, under the RSTP lines): one badge per group this
-- switch is the active IGMP querier for. The state comes only from the WS
-- subscription /snooping/vlan/<vid>/igmp_querier_state, one per group vid
-- learned from /api/groups (it answers with the current value at once). The
-- same vids carry the MR subscriptions /snooping/vlan/<vid>/router_ports.
--------------------------------------------------------------------------------
state.querierByVid     = state.querierByVid or {}      -- vid -> disabled | querier | non-querier
state.routerPortsByVid = state.routerPortsByVid or {}  -- vid -> { router port numbers }
state.vlanSubscribed   = state.vlanSubscribed or {}    -- vid -> true once subscribed on this socket
state.querierSvg       = state.querierSvg or ""        -- last SVG written to Querier.Badges

-- A vid no group uses any more is forgotten (its VLAN is gone, and the switch
-- may drop the subscription with it): a vid that comes back is subscribed
-- again and shows no stale state.
function subscribeVlanStates()
  local used = {}
  for _, g in ipairs(state.groupList) do
    if g.vid then used[g.vid] = true end
  end
  for vid in pairs(state.vlanSubscribed) do
    if not used[vid] then state.vlanSubscribed[vid] = nil end
  end
  for vid in pairs(state.querierByVid) do
    if not used[vid] then state.querierByVid[vid] = nil end
  end
  local forgotRouterPorts = false
  for vid in pairs(state.routerPortsByVid) do
    if not used[vid] then
      state.routerPortsByVid[vid] = nil
      forgotRouterPorts = true
    end
  end
  if forgotRouterPorts then refreshMrPorts() end
  if not state.ws then return end
  for _, g in ipairs(state.groupList) do
    if g.vid and not state.vlanSubscribed[g.vid] then
      state.vlanSubscribed[g.vid] = true
      state.ws:Write(string.format(
        '{"subscription":{"path":"/snooping/vlan/%d/igmp_querier_state","action":"add","method":"changes"}}', g.vid))
      state.ws:Write(string.format(
        '{"subscription":{"path":"/snooping/vlan/%d/router_ports","action":"add","method":"changes"}}', g.vid))
    end
  end
end

-- The subscription answers arrive one vid at a time: one redraw per burst.
function SetQuerierState(vid, value)
  state.querierByVid[vid] = value
  if state.querierRefreshPending then return end
  state.querierRefreshPending = true
  Timer.CallAfter(function()
    state.querierRefreshPending = false
    refreshQuerierBadges()
  end, 0.2)
end

function refreshQuerierBadges()
  local list = {}
  for _, g in ipairs(state.groupList) do
    if g.vid and state.querierByVid[g.vid] == "querier" then
      list[#list + 1] = { id = g.id, color = rgbHex(g.color) }
    end
  end
  table.sort(list, function(a, b) return a.id < b.id end)
  local svg = querierBadgesSvg(list, rgbHex(getThemeColors().textMuted))
  if svg == state.querierSvg then return end
  state.querierSvg = svg
  Controls["Querier.Badges"].Legend = svg == "" and "" or iconLegend(svg)
end

--------------------------------------------------------------------------------
-- Status pin: the Q-SYS status indicator (outside the API), wireable to a
-- Monitoring Proxy or a Status Combiner. state.connection is noip,
-- connecting, online, offline or unauthorized; once online, a model mismatch
-- or a PSU / fan not good makes it Compromised. Reconnect attempts keep the
-- offline / unauthorized state (no flapping through Initializing).
--------------------------------------------------------------------------------
local STATUS_VALUES = { ok = 0, compromised = 1, fault = 2, missing = 4, initializing = 5 }

-- state.modelMismatch: "Switch is <model>" while the Model property differs.
state.connection = state.connection or "noip"
state.psuStates  = state.psuStates or {}
state.fanStates  = state.fanStates or {}

function refreshStatus()
  local ctrl = Controls["Status"]
  if not ctrl then return end
  local kind, text
  if state.connection == "noip" then
    kind, text = "fault", "No IP address"
  elseif state.connection == "unauthorized" then
    kind, text = "fault", "Authentication failed"
  elseif state.connection == "connecting" then
    kind, text = "initializing", "Connecting"
  elseif state.connection == "offline" then
    kind, text = "missing", "Offline"
  else
    local problems = {}
    if state.modelMismatch then problems[#problems + 1] = state.modelMismatch end
    for id = 1, 2 do
      local value = state.psuStates[id]
      if value and value ~= "" and value ~= "good" then
        problems[#problems + 1] = "PSU " .. id .. " " .. value
      end
    end
    for id = 1, 3 do
      local value = state.fanStates[id]
      if value and value ~= "" and value ~= "good" then
        problems[#problems + 1] = "Fan " .. id .. " " .. value
      end
    end
    if #problems > 0 then
      kind, text = "compromised", table.concat(problems, ", ")
    else
      kind, text = "ok", "Connected"
    end
  end
  ctrl.Value  = STATUS_VALUES[kind]
  ctrl.String = text
end

function SetConnection(connection)
  state.connection = connection
  refreshStatus()
end

function SetFanState(id, value)
  state.fanStates[id] = value
  refreshStatus()
end

--------------------------------------------------------------------------------
-- Group label (color + badge)
--------------------------------------------------------------------------------
-- Custom groups (id > 20) and custom trunks (id > 1) live in reserved slots
-- assigned in id order by refreshCustomSlots(). state.customGroupSlot /
-- state.customTrunkSlot map id → slot control index.
function groupSlotFor(groupId)
  if groupId <= 20 then return groupId end
  return state.customGroupSlot and state.customGroupSlot[groupId]
end

function trunkSlotFor(trunkId)
  if trunkId == 1 then return 1 end
  return state.customTrunkSlot and state.customTrunkSlot[trunkId]
end

function refreshCustomSlots()
  state.customGroupSlot = {}
  state.customTrunkSlot = {}

  local customs = {}
  for _, g in ipairs(state.groupList or {}) do
    if g.id and not g.predefined then customs[#customs + 1] = g end
  end
  table.sort(customs, function(a, b) return a.id < b.id end)
  for i = 1, CUSTOM_GROUP_SLOTS do
    local slot  = 20 + i
    local ctrl  = Controls["group_label_" .. slot]
    local badge = Controls["group_id_badge_" .. slot]
    local g = customs[i]
    if g then
      state.customGroupSlot[g.id] = slot
      if ctrl then
        ctrl.String = g.name or ""
        ctrl.Color  = rgbHex(g.color)
        pcall(function() ctrl.IsInvisible = false end)
      end
      if badge then
        badge.String = tostring(g.id)
        badge.Color  = "#1A2238"
        pcall(function() badge.IsInvisible = false end)
      end
    else
      if ctrl then
        ctrl.String = ""
        ctrl.Color  = "#00000000"
        pcall(function() ctrl.IsInvisible = true end)
      end
      if badge then
        badge.String = ""
        badge.Color  = "#00000000"
        pcall(function() badge.IsInvisible = true end)
      end
    end
  end

  local trunks = {}
  for _, t in ipairs(state.trunkList or {}) do
    if t.id and not t.predefined then trunks[#trunks + 1] = t end
  end
  table.sort(trunks, function(a, b) return a.id < b.id end)
  for i = 1, CUSTOM_TRUNK_SLOTS do
    local slot  = 1 + i
    local ctrl  = Controls["trunk_label_" .. slot]
    local badge = Controls["trunk_id_badge_" .. slot]
    local t = trunks[i]
    if t then
      state.customTrunkSlot[t.id] = slot
      if ctrl then
        ctrl.String = t.name or ""
        ctrl.Color  = rgbHex(t.color)
        pcall(function() ctrl.IsInvisible = false end)
      end
      if badge then
        badge.String = tostring(t.id)
        badge.Color  = "#1A2238"
        pcall(function() badge.IsInvisible = false end)
      end
    else
      if ctrl then
        ctrl.String = ""
        ctrl.Color  = "#00000000"
        pcall(function() ctrl.IsInvisible = true end)
      end
      if badge then
        badge.String = ""
        badge.Color  = "#00000000"
        pcall(function() badge.IsInvisible = true end)
      end
    end
  end
end

function SetGroupLabel(groupId, name)
  local slot = groupSlotFor(groupId)
  if not slot then return end  -- custom group not placed yet; refreshCustomSlots will
  local ctrl = Controls["group_label_" .. slot]
  if not ctrl then return end

  ctrl.String = name

  local key = "Group: " .. groupId
  local color = (state.customColors and state.customColors[key]) or GROUP_COLORS[key]
  if color then
    ctrl.Color = rgbHex(color)
  else
    ctrl.Color = "#00000000"
  end

  local badgeCtrl = Controls["group_id_badge_" .. slot]
  if badgeCtrl then
    badgeCtrl.String = tostring(groupId)
    badgeCtrl.Color  = "#1A2238"
  end
end

function SetTrunkLabel(trunkId, name)
  local slot = trunkSlotFor(trunkId)
  if not slot then return end
  local ctrl = Controls["trunk_label_" .. slot]
  if not ctrl then return end

  ctrl.String = name

  local key = "Trunk: " .. trunkId
  local color = state.customColors and state.customColors[key]
  if color then
    ctrl.Color = rgbHex(color)
  else
    ctrl.Color = "#00000000"
  end

  local badgeCtrl = Controls["trunk_id_badge_" .. slot]
  if badgeCtrl then
    badgeCtrl.String = tostring(trunkId)
    badgeCtrl.Color  = "#1A2238"
  end
end

function updateGroupUI(groupId)
  -- Controls repaint themselves when their properties change; nothing to do.
end

--------------------------------------------------------------------------------
-- Group picker panel (main page): opened by a Port.Group cell click, lists
-- every group and trunk slot (the same slots as the Groups and Trunks page)
-- and PUTs the pick to /api/ports/port/N/member_of. The zPicker.* controls
-- are declared in controls.lua and placed by buildGroupPickerPanel
-- (layout.lua); everything here runs at runtime only.
--------------------------------------------------------------------------------
PICKER_SECTION_TITLES = { "Groups", "Custom groups", "Trunks", "Custom trunks" }

local function pickerControlNames()
  local names = { "zPicker.Bg", "zPicker.Title", "zPicker.None", "zPicker.Cancel" }
  for i = 1, #PICKER_SECTION_TITLES do names[#names + 1] = "zPicker.Label " .. i end
  for i = 1, 20 + CUSTOM_GROUP_SLOTS do names[#names + 1] = "zPicker.Group " .. i end
  for i = 1, 1 + CUSTOM_TRUNK_SLOTS do names[#names + 1] = "zPicker.Trunk " .. i end
  return names
end

-- Pickers, LLDP buttons. Hiding also blanks the control: Designer keeps the
-- last runtime Legend and String when the design goes offline but resets
-- IsInvisible, so any leftover text would paint over the page through the
-- transparent button.
function setOverlayVisible(name, visible)
  local ctrl = Controls[name]
  if not ctrl then return end
  pcall(function() ctrl.IsInvisible = not visible end)
  if not visible then
    pcall(function() ctrl.Legend = "" end)
    pcall(function() ctrl.String = "" end)
    pcall(function() ctrl.Color = "#00000000" end)
    pcall(function() ctrl.OffColor = "#00000000" end)
  end
end

function closeGroupPicker()
  state.pickerPort = nil
  for _, name in ipairs(pickerControlNames()) do setOverlayVisible(name, false) end
end

-- One picker button: Legend = name (check mark on the port's current
-- membership), fill = the group/trunk color.
local function paintPickerItem(name, label, hex, isCurrent)
  local ctrl = Controls[name]
  if not ctrl then return end
  ctrl.Legend = isCurrent and (label .. " ✓") or label
  ctrl.Color  = hex
  pcall(function() ctrl.OffColor = hex end)
  setOverlayVisible(name, true)
end

local function memberColorHex(key)
  local color = (state.customColors and state.customColors[key]) or GROUP_COLORS[key]
  return color and rgbHex(color) or PICKER_UNASSIGNED_HEX
end

function openGroupPicker(port)
  if state.baseIP == "" then return end
  closeLldpPanel()
  state.pickerPort = port
  local current = getPortState(port).memberOf
  local theme   = getThemeColors()

  -- slot → id for every section (custom sections: inverse of refreshCustomSlots)
  state.pickerSlotGroupId = {}
  state.pickerSlotTrunkId = {}
  for i = 1, 20 do state.pickerSlotGroupId[i] = i end
  for id, slot in pairs(state.customGroupSlot or {}) do state.pickerSlotGroupId[slot] = id end
  state.pickerSlotTrunkId[1] = 1
  for id, slot in pairs(state.customTrunkSlot or {}) do state.pickerSlotTrunkId[slot] = id end

  paintPickerItem("zPicker.Bg", "", rgbHex(theme.cardFill), false)
  local title = Controls["zPicker.Title"]
  if title then
    title.String = string.format("Port %d: assign to a group or trunk", port)
    setOverlayVisible("zPicker.Title", true)
  end
  for i, text in ipairs(PICKER_SECTION_TITLES) do
    local lbl = Controls["zPicker.Label " .. i]
    if lbl then
      lbl.String = text
      setOverlayVisible("zPicker.Label " .. i, true)
    end
  end
  paintPickerItem("zPicker.None",   "None",   PICKER_UNASSIGNED_HEX, current == nil)
  paintPickerItem("zPicker.Cancel", "Cancel", rgbHex(theme.buttonOffColor), false)

  for slot = 1, 20 + CUSTOM_GROUP_SLOTS do
    local id, name = state.pickerSlotGroupId[slot], "zPicker.Group " .. slot
    if id then
      local key = "Group: " .. id
      paintPickerItem(name, memberOfDisplayName(key), memberColorHex(key), current == key)
    else
      setOverlayVisible(name, false)
    end
  end
  for slot = 1, 1 + CUSTOM_TRUNK_SLOTS do
    local id, name = state.pickerSlotTrunkId[slot], "zPicker.Trunk " .. slot
    if id then
      local key = "Trunk: " .. id
      paintPickerItem(name, memberOfDisplayName(key), memberColorHex(key), current == key)
    else
      setOverlayVisible(name, false)
    end
  end
end

-- kind = "group" | "trunk" | "none". Closes the panel, PUTs the new
-- membership and applies it locally on HTTP 200 (the WS member_of
-- notification and the REST reconcile confirm it afterwards).
function pickerAssign(kind, id)
  local port = state.pickerPort
  closeGroupPicker()
  if not port or state.baseIP == "" then return end
  local body = (kind == "none") and '{"type":"none"}'
            or string.format('{"type":"%s","id":%d}', kind, id)
  HttpClient.Upload {
    Url     = string.format("http://%s/api/ports/port/%d/member_of", state.baseIP, port),
    Method  = "PUT",
    Data    = body,
    Headers = MergeTables(
      { ["Content-Type"] = "application/json" },
      getAuthHeaders()
    ),
    EventHandler = function(_tbl, code, _body, err)
      log("PUT member_of port " .. port .. " " .. body .. " => HTTP " .. tostring(code) .. " " .. tostring(err or ""))
      if code == 200 then SetPortMemberOf(port, memberOfKey(kind, id)) end
    end,
  }
end


--------------------------------------------------------------------------------
-- Speed picker (main page). A Port.Speed Cell click opens a modal card that
-- lists SPEED_CHOICES; a pick calls applyPortSpeed. zSpeed.* controls are declared in
-- controls.lua and placed by buildSpeedPickerPanel (layout.lua).
--------------------------------------------------------------------------------
local function speedPickerControlNames()
  local names = { "zSpeed.Bg", "zSpeed.Title", "zSpeed.Cancel" }
  for i = 1, #SPEED_CHOICES do names[#names + 1] = "zSpeed.Item " .. i end
  return names
end

function closeSpeedPicker()
  state.speedPickerPort = nil
  for _, name in ipairs(speedPickerControlNames()) do setOverlayVisible(name, false) end
end

-- Speeds offered for a port. Unknown type (no /api/ports snapshot yet)
-- offers everything; the API rejects what the port cannot do.
function speedChoicesForPort(port)
  local ptype = getPortState(port).portType
  if ptype == "rj45" then return SPEED_CHOICES_COPPER end
  if ptype == "sfp" then return state.has10g and SPEED_CHOICES_SFP_10G or SPEED_CHOICES_SFP_1G end
  return SPEED_CHOICES
end

function openSpeedPicker(port)
  if state.baseIP == "" then return end
  closeLldpPanel()
  state.speedPickerPort = port
  local pstate  = getPortState(port)
  local current = (pstate.enabled == false) and "Disabled" or pstate.speed
  local theme   = getThemeColors()
  local allowed = {}
  for _, label in ipairs(speedChoicesForPort(port)) do allowed[label] = true end

  paintPickerItem("zSpeed.Bg", "", rgbHex(theme.cardFill), false)
  local title = Controls["zSpeed.Title"]
  if title then
    title.String = string.format("Port %d: link speed", port)
    setOverlayVisible("zSpeed.Title", true)
  end
  paintPickerItem("zSpeed.Cancel", "Cancel", rgbHex(theme.buttonOffColor), false)
  for i, label in ipairs(SPEED_CHOICES) do
    local name = "zSpeed.Item " .. i
    if allowed[label] then
      local isCurrent = (label == current)
      paintPickerItem(name, label,
        rgbHex(isCurrent and theme.accentCyan or theme.buttonOffColor), isCurrent)
    else
      setOverlayVisible(name, false)
    end
  end
end

-- Apply a SPEED_CHOICES label to a port. "Disabled" turns the port off;
-- anything else turns it on, then PUTs link_speed. WS confirms the new
-- speed via SetPortSpeed; a rejected PUT rolls back to the last known value.
function applyPortSpeed(port, label)
  if state.baseIP == "" then return end
  local pstate  = getPortState(port)
  local headers = MergeTables({ ["Content-Type"] = "application/json" }, getAuthHeaders())

  if label == "Disabled" then
    HttpClient.Upload {
      Url     = string.format("http://%s/api/ports/port/%d/enabled", state.baseIP, port),
      Method  = "PUT",
      Data    = "false",
      Headers = headers,
      EventHandler = function(_tbl, status, _body, err)
        log("Disabled port " .. port .. " => status: " .. tostring(status) .. ", err: " .. tostring(err))
      end,
    }
    return
  end

  -- Ensure the port is enabled before setting the speed
  HttpClient.Upload {
    Url     = string.format("http://%s/api/ports/port/%d/enabled", state.baseIP, port),
    Method  = "PUT",
    Data    = "true",
    Headers = headers,
    EventHandler = function(_tbl, status, _body, err)
      log("Enabled port " .. port .. " => status: " .. tostring(status) .. ", err: " .. tostring(err))
    end,
  }

  pstate.speedPending = true
  renderPortUI(port)

  local apiSpeed = SPEED_API_MAP[label]
  local payload
  if label == "Auto" then
    payload = '{"mode":"auto","speed":["all"]}'
  elseif apiSpeed == "1gbps fdx" then
    payload = '{"mode":"auto","speed":["1gbps fdx"]}'
  else
    payload = string.format('{"mode":"fixed","speed":["%s"]}', apiSpeed or label)
  end

  HttpClient.Upload {
    Url     = string.format("http://%s/api/ports/port/%d/link_speed", state.baseIP, port),
    Method  = "PUT",
    Data    = payload,
    Headers = headers,
    EventHandler = function(_tbl, status, body, err)
      log("Set link_speed on port " .. port .. " => " .. payload ..
          " | status: " .. tostring(status) .. ", err: " .. tostring(err))
      if status ~= 200 then
        local reason = (type(body) == "string") and body:match('"reason"%s*:%s*"([^"]*)"') or nil
        log("Link speed rejected on port " .. port .. (reason and (": " .. reason) or ""))
        pstate.speedPending = false
        if pstate.lastValidSpeed then
          pstate.speed = pstate.lastValidSpeed
        end
        renderPortUI(port)
        -- Flash the cell amber for 3 s, then repaint the real value.
        local cell = Controls["Port.Speed Cell " .. port]
        if cell then
          local amber = rgbHex(getThemeColors().accentAmber)
          cell.Legend = "Rejected"
          cell.Color  = amber
          pcall(function() cell.OffColor = amber end)
          Timer.CallAfter(function() renderPortUI(port) end, 3)
        end
      end
      -- On success WS confirms via SetPortSpeed()
    end,
  }
end

--------------------------------------------------------------------------------
-- Q-SYS tile appearance
--------------------------------------------------------------------------------
function GetColor(props)
  return { 15, 58, 83 }
end

function GetPrettyName(props)
  return PluginInfo.Name .. " v" .. PluginInfo.Version
end

-- SVG logos are referenced from layout.lua — expose them as globals
_G.LogoLuminex = LogoLuminex
_G.LogoPSU     = LogoPSU

-- Web UI chassis layout per model (cards, dividers, speed frames).
-- chassis_layout.lua
-- Per-model chassis layout of the switch web UI. A group is { divider = true } or a list of port
-- sets; tenG = true draws the 10G frame when the 10g licence is active,
-- speedLabel is an always-shown speed frame (O26-I).
-- etherCON / rfib sets hold one full-height card; rj45 / sfp / qsfp sets are a
-- column of two half-height cards (first port on top, direction ttb).

CHASSIS_LAYOUT = {
  ["GigaCore 10i"] = {
    { sets = { { connector = "rj45", ports = { 1, 2 } }, { connector = "rj45", ports = { 3, 4 } }, { connector = "rj45", ports = { 5, 6 } }, { connector = "rj45", ports = { 7, 8 } } } },
    { sets = { { connector = "sfp", ports = { 9, 10 } } }, tenG = true },
  },
  ["GigaCore 10t"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } } } },
    { sets = { { connector = "rfib", ports = { 9 } }, { connector = "rfib", ports = { 10 } } }, tenG = true },
    { divider = true },
    { sets = { { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } } } },
  },
  ["GigaCore 10t-IP"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } }, { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } } } },
    { divider = true },
    { sets = { { connector = "rfib", ports = { 9 } }, { connector = "rfib", ports = { 10 } } }, tenG = true },
  },
  ["GigaCore 16i"] = {
    { sets = { { connector = "rj45", ports = { 1, 2 } }, { connector = "rj45", ports = { 3, 4 } }, { connector = "rj45", ports = { 5, 6 } }, { connector = "rj45", ports = { 7, 8 } }, { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } } } },
    { sets = { { connector = "sfp", ports = { 13, 14 } }, { connector = "sfp", ports = { 15, 16 } } }, tenG = true },
  },
  ["GigaCore 16t"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } } } },
    { divider = true },
    { sets = { { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } } } },
    { sets = { { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } }, { connector = "rj45", ports = { 13, 14 } }, { connector = "rj45", ports = { 15, 16 } } } },
  },
  ["GigaCore 16tf"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } }, { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } }, { connector = "ethercon", ports = { 9 } }, { connector = "ethercon", ports = { 10 } }, { connector = "ethercon", ports = { 11 } }, { connector = "ethercon", ports = { 12 } } } },
    { sets = { { connector = "rfib", ports = { 13 } }, { connector = "rfib", ports = { 14 } }, { connector = "rfib", ports = { 15 } }, { connector = "rfib", ports = { 16 } } }, tenG = true },
  },
  ["GigaCore 18t"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } } } },
    { divider = true },
    { sets = { { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } } } },
    { sets = { { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } }, { connector = "rj45", ports = { 13, 14 } }, { connector = "rj45", ports = { 15, 16 } } } },
    { sets = { { connector = "sfp", ports = { 17, 18 } } }, tenG = true },
  },
  ["GigaCore 20t"] = {
    { sets = { { connector = "ethercon", ports = { 1 } }, { connector = "ethercon", ports = { 2 } }, { connector = "ethercon", ports = { 3 } }, { connector = "ethercon", ports = { 4 } } } },
    { divider = true },
    { sets = { { connector = "ethercon", ports = { 5 } }, { connector = "ethercon", ports = { 6 } }, { connector = "ethercon", ports = { 7 } }, { connector = "ethercon", ports = { 8 } } } },
    { sets = { { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } }, { connector = "rj45", ports = { 13, 14 } }, { connector = "rj45", ports = { 15, 16 } } } },
    { sets = { { connector = "sfp", ports = { 17, 18 } }, { connector = "sfp", ports = { 19, 20 } } }, tenG = true },
  },
  ["GigaCore 30i"] = {
    { sets = { { connector = "rj45", ports = { 1, 2 } }, { connector = "rj45", ports = { 3, 4 } }, { connector = "rj45", ports = { 5, 6 } }, { connector = "rj45", ports = { 7, 8 } }, { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } } } },
    { sets = { { connector = "rj45", ports = { 13, 14 } }, { connector = "rj45", ports = { 15, 16 } }, { connector = "rj45", ports = { 17, 18 } }, { connector = "rj45", ports = { 19, 20 } }, { connector = "rj45", ports = { 21, 22 } }, { connector = "rj45", ports = { 23, 24 } } } },
    { sets = { { connector = "sfp", ports = { 25, 26 } }, { connector = "sfp", ports = { 27, 28 } }, { connector = "sfp", ports = { 29, 30 } } }, tenG = true },
  },
  ["GigaCore O26-I"] = {
    { sets = { { connector = "sfp", ports = { 1, 2 } }, { connector = "sfp", ports = { 3, 4 } }, { connector = "sfp", ports = { 5, 6 } }, { connector = "sfp", ports = { 7, 8 } }, { connector = "sfp", ports = { 9, 10 } }, { connector = "sfp", ports = { 11, 12 } }, { connector = "sfp", ports = { 13, 14 } }, { connector = "sfp", ports = { 15, 16 } } } },
    { sets = { { connector = "sfp", ports = { 17, 18 } }, { connector = "sfp", ports = { 19, 20 } } } },
    { sets = { { connector = "sfp", ports = { 21, 22 } }, { connector = "sfp", ports = { 23, 24 } } }, speedLabel = "25G" },
    { sets = { { connector = "qsfp", ports = { 25, 26 } } }, speedLabel = "40G" },
  },
  ["GigaCore S30-I"] = {
    { sets = { { connector = "rj45", ports = { 1, 2 } }, { connector = "rj45", ports = { 3, 4 } }, { connector = "rj45", ports = { 5, 6 } }, { connector = "rj45", ports = { 7, 8 } }, { connector = "rj45", ports = { 9, 10 } }, { connector = "rj45", ports = { 11, 12 } } } },
    { sets = { { connector = "rj45", ports = { 13, 14 } }, { connector = "rj45", ports = { 15, 16 } }, { connector = "rj45", ports = { 17, 18 } }, { connector = "rj45", ports = { 19, 20 } }, { connector = "rj45", ports = { 21, 22 } }, { connector = "rj45", ports = { 23, 24 } } } },
    { sets = { { connector = "sfp", ports = { 25, 26 } }, { connector = "sfp", ports = { 27, 28 } }, { connector = "sfp", ports = { 29, 30 } } } },
  },
}

local CHASSIS_BORDER = 1
local CHASSIS_PADDING = 16
local CHASSIS_HEIGHT = 142
local CARD_TOP = CHASSIS_BORDER + CHASSIS_PADDING
local CARD_HEIGHT = CHASSIS_HEIGHT - 2 * CARD_TOP
local HALF_CARD_HEIGHT = math.floor(CARD_HEIGHT / 2)
local GROUP_GAP = 24
local FRAME_OUTSET = 3
local FULL_CARD_WIDTH = 60
local COLUMN_WIDTH = { rj45 = 44, sfp = 44, qsfp = 57 }

-- Chassis-local geometry (origin = outer top-left of the chassis box) of every
-- card, divider line and speed frame of a model, or nil for an unknown model.
function chassisGeometry(modelName)
  local layout = CHASSIS_LAYOUT[modelName]
  if not layout then return nil end
  local geometry = { h = CHASSIS_HEIGHT, cards = {}, dividers = {}, frames = {} }
  local x = CARD_TOP
  for index, group in ipairs(layout) do
    if index > 1 then x = x + GROUP_GAP end
    if group.divider then
      table.insert(geometry.dividers, { x = x, y = CARD_TOP, h = CARD_HEIGHT })
    else
      local groupX = x
      for _, set in ipairs(group.sets) do
        local kind = set.connector
        if kind == "ethercon" or kind == "rfib" then
          geometry.cards[set.ports[1]] = { x = x, y = CARD_TOP, w = FULL_CARD_WIDTH, h = CARD_HEIGHT,
                                           kind = kind, direction = "btt" }
          x = x + FULL_CARD_WIDTH
        else
          local width = COLUMN_WIDTH[kind]
          geometry.cards[set.ports[1]] = { x = x, y = CARD_TOP, w = width, h = HALF_CARD_HEIGHT,
                                           kind = kind, direction = "ttb" }
          if set.ports[2] then
            geometry.cards[set.ports[2]] = { x = x, y = CARD_TOP + HALF_CARD_HEIGHT, w = width, h = HALF_CARD_HEIGHT,
                                             kind = kind, direction = "btt" }
          end
          x = x + width
        end
      end
      if group.tenG or group.speedLabel then
        table.insert(geometry.frames, {
          x = groupX - FRAME_OUTSET, y = CARD_TOP - FRAME_OUTSET,
          w = x - groupX + 2 * FRAME_OUTSET, h = CARD_HEIGHT + 2 * FRAME_OUTSET,
          label = group.speedLabel or "10G", tenG = group.tenG,
        })
      end
    end
  end
  geometry.w = x + CHASSIS_PADDING + CHASSIS_BORDER
  return geometry
end

-- Page sizes and grid geometry per model (layouts and runtime).
-- page_geometry.lua
-- Page sizes and grid geometry per model: the chassis strip, the port-settings
-- grid and the Groups and Trunks sections. Top-level, so GetControlLayout and
-- the runtime size things the same way.

-- Port-settings grid geometry, shared by the chassis page and the page
-- size helpers. One column = label + enable + legend + rlinkx + poe toggle
-- + poe bounce + group + speed. GRID_COL_W, with the narrowest legend,
-- sets the column count; the legend then takes the width left over.
local GRID_LEGEND_MIN_W = 50
local GRID_LEGEND_MAX_W = 96  -- 16 characters (the API maxLength) in Roboto 10
local GRID_COL_W   = 16 + 20 + GRID_LEGEND_MIN_W + 20 + 20 + 20 + 68 + 110
local GRID_COL_PAD = 6
local GRID_X_START = 12
local GRID_ROW_H   = 22

-- Plugin width per model so that every chassis has the same right-side
-- margin (380px from chassis right edge to plugin right edge). Reserves
-- consistent space for future info controls regardless of chassis width.
-- Chassis strip geometry shared by the page builders: [display block]
-- [web UI chassis box] [status block], all CHASSIS_H tall, starting at
-- CHASSIS_X / _Y.
local CHASSIS_X  = 20
local CHASSIS_Y  = 4
local CHASSIS_H  = 142   -- web UI chassis box (chassisGeometry h)
local DISPLAY_W  = 190   -- device display block (logo, model, status, IP...)
local DISPLAY_GAP = 8    -- display block to chassis box
local STATUS_GAP  = 8    -- chassis box to status block
local STATUS_W    = 210  -- status block (RSTP lines, querier panel, PSU column)

-- The status block keeps a CHASSIS_X margin to the page's right edge, like
-- the display block's on the left.
function pageWidthForModel(model)
  local rightMargin = STATUS_GAP + STATUS_W + CHASSIS_X
  return CHASSIS_X + DISPLAY_W + DISPLAY_GAP + chassisGeometry(model).w + rightMargin
end

-- Grid columns: as many as the page width fits with the GRID_X_START margin
-- kept on the right too; rows: ceil(ports / cols). Ports fill column by
-- column (1..rows down the first column, then the next), so the page stays
-- as short as the width allows.
function gridDimsForModel(model)
  local pageW = pageWidthForModel(model)
  local cols  = math.floor((pageW - GRID_X_START * 2 + GRID_COL_PAD) / (GRID_COL_W + GRID_COL_PAD))
  local pc    = getPortCount(model) or 30
  cols = math.max(1, math.min(cols, pc))
  local rows = math.ceil(pc / cols)
  return cols, rows
end

-- Legend TextBox width: the page width the grid columns leave free on the
-- right, shared between the columns, up to GRID_LEGEND_MAX_W. Neither the
-- page size nor the column count changes.
function gridLegendWidth(model)
  local cols  = gridDimsForModel(model)
  local spare = pageWidthForModel(model) - GRID_X_START * 2 - (cols * GRID_COL_W + (cols - 1) * GRID_COL_PAD)
  return math.min(GRID_LEGEND_MAX_W, GRID_LEGEND_MIN_W + math.floor(spare / cols))
end

-- Groups and Trunks page geometry. Sections sit side by side (groups,
-- custom groups, trunks, custom trunks); each is a vertical list that
-- spills into extra sub-columns. Rows per section = the smallest count that
-- keeps all four sections inside the page width.
local GT_TOP_Y, GT_LABEL_H, GT_CARD_W, GT_CARD_H, GT_GAP_Y, GT_SECTION_GAP, GT_MARGIN_X = 55, 16, 90, 18, 3, 14, 16
local GT_SECTION_ITEMS = { 20, CUSTOM_GROUP_SLOTS, 1, CUSTOM_TRUNK_SLOTS }

function groupsPageWidthForRows(rows)
  local w = GT_MARGIN_X
  for i, n in ipairs(GT_SECTION_ITEMS) do
    local subCols = math.max(1, math.ceil(n / rows))
    w = w + subCols * GT_CARD_W + (subCols - 1) * 4
    if i < #GT_SECTION_ITEMS then w = w + GT_SECTION_GAP end
  end
  return w + GT_MARGIN_X
end

function groupsRowsForModel(model)
  local pageW = pageWidthForModel(model)
  for rows = 4, 20 do
    if groupsPageWidthForRows(rows) <= pageW then return rows end
  end
  return 20
end

function groupsPageHeightForModel(model)
  local rows = groupsRowsForModel(model)
  return GT_TOP_Y + GT_LABEL_H + 6 + rows * (GT_CARD_H + GT_GAP_Y) - GT_GAP_Y + 10
end

function chassisPageHeightForModel(model)
  local topGap = 6
  local _cols, rows = gridDimsForModel(model)
  return CHASSIS_Y + CHASSIS_H + topGap + (rows * GRID_ROW_H) + topGap
end

-- Neighbors page (LLDP): the column header row at GT_TOP_Y, then one 18 px
-- row per port, cut into blocks of rows side by side.
local LLDP_ROW_H       = 18
local LLDP_ROWS_Y      = GT_TOP_Y + 14   -- 69
local LLDP_BOTTOM      = 8
local LLDP_MARGIN_X    = 20
local LLDP_BLOCK_GAP   = 20
local LLDP_BLOCK_MIN_W = 400   -- narrowest block (compact: no Description column)
local LLDP_FULL_W      = 500   -- a narrower block drops the Description column
local LLDP_GAP         = 4

-- Smallest block count (1..3) whose rows fit the height the chassis and
-- groups pages already need; when none fits, the most blocks still at least
-- LLDP_BLOCK_MIN_W wide (the page then grows).
function neighborsGeometry(model)
  local pageW = pageWidthForModel(model)
  local available = math.max(chassisPageHeightForModel(model), groupsPageHeightForModel(model))
  local ports = getPortCount(model) or 30
  local chosen
  for blocks = 1, 3 do
    local blockW = math.floor((pageW - 2 * LLDP_MARGIN_X - LLDP_BLOCK_GAP * (blocks - 1)) / blocks)
    if blockW >= LLDP_BLOCK_MIN_W then
      chosen = { blocks = blocks, blockW = blockW, rows = math.ceil(ports / blocks) }
      if LLDP_ROWS_Y + LLDP_ROW_H * chosen.rows + LLDP_BOTTOM <= available then break end
    end
  end
  chosen.compact = chosen.blockW < LLDP_FULL_W
  chosen.rowH    = LLDP_ROW_H
  chosen.rowsY   = LLDP_ROWS_Y
  chosen.height  = LLDP_ROWS_Y + LLDP_ROW_H * chosen.rows + LLDP_BOTTOM
  return chosen
end

-- Row columns, x relative to the block: number, Neighbor, Description (full
-- blocks only), Port, IP, 4 px apart. Neighbor and Description share the
-- slack (45 / 55 %).
function neighborsColumns(blockW, compact)
  local order = compact and { "number", "name", "remotePort", "ip" }
    or { "number", "name", "device", "remotePort", "ip" }
  local widths = { number = 20, remotePort = 40, ip = 95 }
  local slack = blockW - LLDP_GAP * (#order - 1)
    - widths.number - widths.remotePort - widths.ip
  if compact then
    widths.name = slack
  else
    widths.name = math.floor(slack * 0.45)
    widths.device = slack - widths.name
  end
  local columns, x = {}, 0
  for _, key in ipairs(order) do
    columns[key] = { x = x, w = widths[key] }
    x = x + widths[key] + LLDP_GAP
  end
  return columns
end

-- Top-left of port N's row: ports run down a block, then on to the next one.
function neighborsRowPosition(model, port)
  local geometry = neighborsGeometry(model)
  local block = math.floor((port - 1) / geometry.rows)
  return LLDP_MARGIN_X + block * (geometry.blockW + LLDP_BLOCK_GAP),
    geometry.rowsY + ((port - 1) % geometry.rows) * geometry.rowH
end

-- One height for every page of a model so tab switches don't resize the
-- plugin: the tallest of the chassis, groups and neighbors pages.
function pageHeightForModel(model)
  return math.max(chassisPageHeightForModel(model), groupsPageHeightForModel(model),
    neighborsGeometry(model).height)
end

-- Web UI port cards drawn as SVG (runtime cards and the offline chassis).
-- port_card.lua
-- Web UI port cards drawn as SVG: one IconData SVG per port at runtime, and the
-- static offline chassis graphic built from the same drawing functions (the
-- build-time tool tools/gen_offline_chassis.py calls chassisOfflineSvg).
-- Colors and sizes are the web UI's and do not follow the plugin theme.

local CARD_BORDER_COLOR = "#CED3DD"
CARD_BAR_SPACE = 10             -- room for the MultiLinkX bar on the bar side
FRAME_LABEL_SPACE = 24          -- room for the rotated 10G / speed label
local FRAME_COLOR = "#00FFA1"
local CHASSIS_FILL = "#0B1220"
local FONT = 'font-family="Roboto, Arial, sans-serif"'

local function svgNumber(value)
  return string.format("%g", value)
end

local function rectElement(x, y, width, height, extra)
  return '<rect x="' .. svgNumber(x) .. '" y="' .. svgNumber(y) .. '" width="' .. svgNumber(width)
    .. '" height="' .. svgNumber(height) .. '" ' .. extra .. '/>'
end

-- Baseline that centres digits and capitals on a given y: dominant-baseline
-- is outside SVG Tiny, so the offset is computed (cap height ~0.7 em).
local function baseline(centreY, size)
  return centreY + 0.35 * size
end

-- Bold text centred on (x, centreY).
local function textElement(x, centreY, size, fill, content)
  return '<text x="' .. svgNumber(x) .. '" y="' .. svgNumber(baseline(centreY, size)) .. '" ' .. FONT .. ' font-size="'
    .. size .. '" font-weight="bold" text-anchor="middle" fill="' .. fill .. '">' .. content .. '</text>'
end

local function point(x, y)
  return svgNumber(x) .. "," .. svgNumber(y)
end

local function isFullHeight(kind)
  return kind == "ethercon" or kind == "rfib"
end

-- The MultiLinkX bar sits above etherCON / rfib and ttb cards, below btt
-- cards (card = a chassisGeometry card or a card view).
function cardBarOnTop(card)
  return isFullHeight(card.kind) or card.direction == "ttb"
end

local function numberColor(fill)
  local r, g, b = (fill or ""):match("^#(%x%x)(%x%x)(%x%x)")
  if not r then return "#fff" end
  local luminance = tonumber(r, 16) * 0.299 + tonumber(g, 16) * 0.587 + tonumber(b, 16) * 0.114
  if luminance > 130 then return "#333" end
  return "#fff"
end

-- Card border: all corners rounded on etherCON / rfib, the outer corners only
-- on half-height cards (a ttb / btt pair meets square at the midline).
local function cardOutline(view)
  local style = 'fill="' .. (view.cardFill or "none") .. '" stroke="' .. CARD_BORDER_COLOR .. '" stroke-width="1"'
  local w, h = view.w, view.h
  if isFullHeight(view.kind) then
    return rectElement(0.5, 0.5, w - 1, h - 1, 'rx="4" ' .. style)
  end
  local left, right, top, bottom = 0.5, w - 0.5, 0.5, h - 0.5
  local d
  if view.direction == "ttb" then
    d = "M" .. point(left, bottom) .. " L" .. point(left, top + 4) .. " Q" .. point(left, top) .. " " .. point(left + 4, top)
      .. " L" .. point(right - 4, top) .. " Q" .. point(right, top) .. " " .. point(right, top + 4)
      .. " L" .. point(right, bottom) .. " Z"
  else
    d = "M" .. point(left, top) .. " L" .. point(right, top) .. " L" .. point(right, bottom - 4)
      .. " Q" .. point(right, bottom) .. " " .. point(right - 4, bottom) .. " L" .. point(left + 4, bottom)
      .. " Q" .. point(left, bottom) .. " " .. point(left, bottom - 4) .. " Z"
  end
  return '<path d="' .. d .. '" ' .. style .. '/>'
end

-- Jack and PoE boxes (web UI border-box sizes, card-local px).
local function jackBox(view)
  if isFullHeight(view.kind) then return 14, 44, 32, 20 end
  return 5, (view.direction == "ttb") and 29 or 5, view.w - 10, 20
end

local function poeBox(view)
  if view.kind == "ethercon" then return 24, 58, 12, 10 end
  if view.kind == "rj45" then return (view.w - 12) / 2, (view.direction == "ttb") and 25 or 19, 12, 10 end
  return nil
end

-- 7 x 7 disabled icon centred in the jack, pushed 2.5 px away from the PoE square.
local function disabledIcon(view, jx, jy, jw, jh)
  local offset = (view.direction == "ttb") and 2.5 or -2.5
  local x = jx + jw / 2 - 3.5
  local y = jy + jh / 2 - 3.5 + offset
  return rectElement(x, y, 7, 7, 'rx="1.5" fill="#FF2D55"')
    .. '<path d="M' .. point(x + 2, y + 2) .. " L" .. point(x + 5, y + 5) .. " M" .. point(x + 5, y + 2)
    .. " L" .. point(x + 2, y + 5) .. '" stroke="#00011F" stroke-width="1" fill="none"/>'
end

-- Araneo port badges: the RSTP role (root / alternate) and the IGMP multicast
-- router port, white-bordered, packed from the left over the number row.
local BADGE_W, BADGE_H = 20, 16
local RSTP_BADGE = {
  root      = { fill = "#a56de2", rx = 3, text = "#000", label = "root" },
  alternate = { fill = "#c6262e", rx = 0, text = "#fff", label = "alt" },
}
local MR_BADGE = { fill = "#000", rx = 3, text = "#fff", label = "MR" }

local function badge(x, centreY, style)
  return rectElement(x + 0.75, centreY - BADGE_H / 2 + 0.75, BADGE_W - 1.5, BADGE_H - 1.5, 'rx="' .. style.rx
      .. '" fill="' .. style.fill .. '" stroke="#fff" stroke-width="1.5"')
    .. textElement(x + BADGE_W / 2, centreY, 8, style.text, style.label)
end

-- Card drawn with its own box at the local origin (no MultiLinkX bar space).
local function portCardBody(view)
  local w, h = view.w, view.h
  local parts = { cardOutline(view) }
  local present = not view.notPresent

  if isFullHeight(view.kind) then
    table.insert(parts, '<circle cx="30" cy="54" r="24.5" fill="' .. (present and "#434342" or "#000")
      .. '" stroke="#fff" stroke-width="1"/>')
    if view.kind == "ethercon" then
      table.insert(parts, rectElement(16.5, 16, 27, 13, 'rx="6.5" fill="#fff"'))
    end
  end

  if present then
    local jx, jy, jw, jh = jackBox(view)
    table.insert(parts, rectElement(jx + 1.5, jy + 1.5, jw - 3, jh - 3, 'fill="' .. view.linkFill .. '" stroke="'
      .. view.jackBorder .. '" stroke-width="3"'))
    if view.enabled == false then
      table.insert(parts, disabledIcon(view, jx, jy, jw, jh))
    end
    local px, py, pw, ph = poeBox(view)
    if px then
      table.insert(parts, rectElement(px + 0.5, py + 0.5, pw - 1, ph - 1, 'fill="' .. view.poeFill .. '" stroke="'
        .. view.poeBorder .. '" stroke-width="1"'))
    end
  end

  local numberY
  if isFullHeight(view.kind) then numberY = 95
  elseif view.direction == "ttb" then numberY = 12
  else numberY = h - 12 end
  table.insert(parts, textElement(w / 2, numberY, 12, numberColor(view.cardFill), tostring(view.number)))

  if view.trunk and present then
    table.insert(parts, '<path d="M1,9 L1,3 Q1,0.5 3.5,0.5 L9.5,0.5 Z" fill="#00011f"/>')
  end

  -- Like Araneo, the badges cover the number (and the trunk triangle on a ttb card).
  local badges = {}
  if RSTP_BADGE[view.rstpRole] then table.insert(badges, RSTP_BADGE[view.rstpRole]) end
  if view.mr then table.insert(badges, MR_BADGE) end
  for slot, style in ipairs(badges) do
    table.insert(parts, badge(1 + (slot - 1) * BADGE_W, numberY, style))
  end

  return table.concat(parts)
end

-- One port card as a standalone SVG: the card plus CARD_BAR_SPACE px on its
-- MultiLinkX side. One SVG unit = one screen pixel.
function portCardSvg(view)
  local w, h = view.w, view.h
  local topBar = cardBarOnTop(view)
  local parts = { '<svg xmlns="http://www.w3.org/2000/svg" width="' .. svgNumber(w) .. '" height="' .. svgNumber(h + CARD_BAR_SPACE)
    .. '" viewBox="0 0 ' .. svgNumber(w) .. " " .. svgNumber(h + CARD_BAR_SPACE) .. '">' }
  if view.mlx then
    table.insert(parts, rectElement(1, topBar and 1 or (h + 5), w - 2, 4, 'rx="2" fill="' .. view.mlx .. '"'))
  end
  if topBar then
    table.insert(parts, '<g transform="translate(0,' .. CARD_BAR_SPACE .. ')">')
  else
    table.insert(parts, '<g>')
  end
  table.insert(parts, portCardBody(view))
  if view.selected then  -- the port shown in the LLDP neighbor panel
    table.insert(parts, rectElement(1, 1, w - 2, h - 2, 'rx="2" fill="none" stroke="#fff" stroke-width="2"'))
  end
  table.insert(parts, '</g></svg>')
  return table.concat(parts)
end

-- View of a card when the design is offline (spec section 7).
function offlineCardView(card, port)
  return {
    kind = card.kind, direction = card.direction, w = card.w, h = card.h, number = port,
    cardFill = nil, enabled = true, notPresent = false,
    linkFill = "#000", jackBorder = CARD_BORDER_COLOR, poeFill = "#d6d7d7", poeBorder = "#d6d7d7",
    trunk = false, mlx = nil, mr = false, rstpRole = nil,
  }
end

local LINK_SLOW_FILL = "#ff6600"
local RLINKX_BORDER = {
  ["non-redundant"] = "#96ffff", ["redundant"] = "#0044ff",
  ["partial-redundant"] = "#ff6600", ["invalid-version"] = "#ff6600",
}
local POE_FILL = {
  enabled = "#f9c440", sourcing = "#ff6600", error = "#c6262E", disabled = "#424242", [""] = "#424242",
}

local MULTILINKX_BAR = { active = "#fff", member = "#cc00cc" }

local function linkFill(linkState)
  if not linkState or linkState == "down" or linkState == "unknown" then return "#000" end
  if linkState:find("^10mbps") or linkState:find("^100mbps") then return LINK_SLOW_FILL end
  return "#9bdb4d"
end

-- View of one live card (web UI port.vue color getters) from the port state;
-- card = chassisGeometry(model).cards[port].
function portCardView(port, card)
  local p = getPortState(port)
  local disabled = p.enabled == false
  local memberOf = p.memberOf
  local color = memberOf and ((state.customColors and state.customColors[memberOf]) or GROUP_COLORS[memberOf])
  local cardFill
  if color then cardFill = disabled and "#2B2B2B" or rgbHex(color) end
  -- Triangle whenever the reported membership is not a resolved group:
  -- trunk, unresolved id or type none (port.vue isTrunk).
  local isTrunk = p.memberOfKnown == true and (memberOf == nil or memberOf:sub(1, 6) == "Trunk:" or color == nil)
  -- RSTP role: the port's own root / alternate, else the role of its LAG (the
  -- API reports a MultiLinkX link's role on the LAG port, 66 and up).
  local rstpRole = p.rstpRole
  local lag = state.lagOf[port] and state.ports[state.lagOf[port]]
  if rstpRole ~= "root" and rstpRole ~= "alternate" and lag then rstpRole = lag.rstpRole end
  return {
    kind = card.kind, direction = card.direction, w = card.w, h = card.h, number = port,
    cardFill = cardFill,
    enabled = not disabled,
    notPresent = card.kind == "rfib" and state.fiberPossible == true and state.fiberActive ~= true,
    linkFill = disabled and "#000" or linkFill(p.linkState),
    jackBorder = disabled and "#505050" or (RLINKX_BORDER[p.rlinkxState] or CARD_BORDER_COLOR),
    poeFill = (p.poe ~= nil and POE_FILL[p.poe]) or "#d6d7d7",
    poeBorder = disabled and "#505050" or ((p.rlinkxEnabled == true) and "#154259" or "#d6d7d7"),
    trunk = isTrunk,
    mlx = MULTILINKX_BAR[p.multilinkx],
    mr = p.mr == true,
    rstpRole = rstpRole,
    selected = state.lldpPanelPort == port,
  }
end

-- Frame and rotated label, with the frame's own box starting FRAME_LABEL_SPACE
-- px from the left.
local function frameBody(frame)
  local labelX, labelY = FRAME_LABEL_SPACE - 10, 18
  return rectElement(FRAME_LABEL_SPACE + 0.5, 0.5, frame.w - 1, frame.h - 1,
      'rx="4" fill="none" stroke="' .. FRAME_COLOR .. '" stroke-width="1"')
    .. '<text x="' .. svgNumber(labelX) .. '" y="' .. svgNumber(baseline(labelY, 10)) .. '" ' .. FONT
    .. ' font-size="10" text-anchor="middle" fill="' .. FRAME_COLOR
    .. '" transform="rotate(-90 ' .. svgNumber(labelX) .. " " .. svgNumber(labelY) .. ')">' .. frame.label .. '</text>'
end

function tenGFrameSvg(frame)
  local w, h = frame.w + FRAME_LABEL_SPACE, frame.h
  return '<svg xmlns="http://www.w3.org/2000/svg" width="' .. svgNumber(w) .. '" height="' .. svgNumber(h)
    .. '" viewBox="0 0 ' .. svgNumber(w) .. " " .. svgNumber(h) .. '">' .. frameBody(frame) .. '</svg>'
end

-- Querier panel of the status block: a "Querier" title line, then one badge
-- per group this switch is the IGMP querier for, 9 per row on 4 rows (13 px
-- badges in the status block's 145 px text column). Past 36 groups the last
-- slot counts the groups left out.
QUERIER_W = 145
QUERIER_H = 74
local QUERIER_TITLE_H = 14
local QUERIER_BADGE = 13
local QUERIER_PITCH = 15
local QUERIER_PER_ROW = 9
local QUERIER_SLOTS = 36
local QUERIER_NUMBER_SIZE = 8
local QUERIER_OVERFLOW_FILL = "#424242"

local function querierBadge(slot, fill, label)
  local x = ((slot - 1) % QUERIER_PER_ROW) * QUERIER_PITCH
  local y = QUERIER_TITLE_H + math.floor((slot - 1) / QUERIER_PER_ROW) * QUERIER_PITCH
  local half = QUERIER_BADGE / 2
  return rectElement(x, y, QUERIER_BADGE, QUERIER_BADGE, 'rx="3" fill="' .. fill .. '"')
    .. textElement(x + half, y + half, QUERIER_NUMBER_SIZE, numberColor(fill), label)
end

-- groups: array of { id, color = "#RRGGBB" } sorted by id; "" when empty.
function querierBadgesSvg(groups, titleColor)
  if #groups == 0 then return "" end
  local parts = { '<svg xmlns="http://www.w3.org/2000/svg" width="' .. QUERIER_W .. '" height="' .. QUERIER_H
    .. '" viewBox="0 0 ' .. QUERIER_W .. " " .. QUERIER_H .. '">',
    '<text x="0" y="' .. svgNumber(baseline(QUERIER_TITLE_H / 2, 10)) .. '" ' .. FONT .. ' font-size="10" fill="'
      .. titleColor .. '">Querier</text>' }
  local drawn = #groups
  if drawn > QUERIER_SLOTS then drawn = QUERIER_SLOTS - 1 end
  for slot = 1, drawn do
    table.insert(parts, querierBadge(slot, groups[slot].color, tostring(groups[slot].id)))
  end
  if drawn < #groups then
    table.insert(parts, querierBadge(QUERIER_SLOTS, QUERIER_OVERFLOW_FILL, "+" .. (#groups - drawn)))
  end
  table.insert(parts, '</svg>')
  return table.concat(parts)
end

-- Whole chassis box as drawn offline: frame, dividers and always-shown speed
-- frames at full opacity (the graphic stays under the live cards, and the box
-- keeps its dark fill in both themes), every card at 75 % opacity like the
-- web UI when not live.
function chassisOfflineSvg(modelName)
  local geometry = chassisGeometry(modelName)
  if not geometry then return nil end
  local w, h = geometry.w, geometry.h
  local parts = { '<svg xmlns="http://www.w3.org/2000/svg" width="' .. svgNumber(w) .. '" height="' .. svgNumber(h)
    .. '" viewBox="0 0 ' .. svgNumber(w) .. " " .. svgNumber(h) .. '">',
    rectElement(0.5, 0.5, w - 1, h - 1, 'rx="4" fill="' .. CHASSIS_FILL .. '" stroke="#fff" stroke-width="1"') }
  for _, divider in ipairs(geometry.dividers) do
    table.insert(parts, '<line x1="' .. svgNumber(divider.x + 0.5) .. '" y1="' .. svgNumber(divider.y) .. '" x2="'
      .. svgNumber(divider.x + 0.5) .. '" y2="' .. svgNumber(divider.y + divider.h) .. '" stroke="#fff" stroke-width="1"/>')
  end
  for _, frame in ipairs(geometry.frames) do
    if not frame.tenG then
      table.insert(parts, '<g transform="translate(' .. point(frame.x - FRAME_LABEL_SPACE, frame.y) .. ')">'
        .. frameBody(frame) .. '</g>')
    end
  end
  local ports = {}
  for port in pairs(geometry.cards) do table.insert(ports, port) end
  table.sort(ports)
  table.insert(parts, '<g opacity="0.75">')
  for _, port in ipairs(ports) do
    local card = geometry.cards[port]
    table.insert(parts, '<g transform="translate(' .. point(card.x, card.y) .. ')">'
      .. portCardBody(offlineCardView(card, port)) .. '</g>')
  end
  table.insert(parts, '</g></svg>')
  return table.concat(parts)
end

-- LLDP neighbors: parsing, shown values, panel and Neighbors row SVGs.
-- lldp.lua
-- LLDP neighbors: parsing of /api/lldp/neighbor (GET body or WS notification),
-- the values shown for a neighbor, and the SVGs of the neighbor panel (main
-- page) and of a Neighbors page row. Pure functions; uses port_card.lua's
-- svgNumber, rectElement, baseline and FONT (same chunk). Every SVG is ASCII:
-- text goes through xmlText.

local EM_DASH = "\u{2014}"
local MIDDLE_DOT = "\u{B7}"
local ELLIPSIS = "\u{2026}"

local XML_ESCAPES = { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;" }

local function xmlCodePoint(sequence)
  if utf8.len(sequence) == 1 then return "&#" .. utf8.codepoint(sequence) .. ";" end
  return "&#65533;"
end

-- Text for an SVG text node or attribute, ASCII only: & < > " escaped, every
-- non-ASCII character as &#N; (an invalid byte as U+FFFD), control characters
-- as spaces.
function xmlText(s)
  return (tostring(s):gsub("%c", " "):gsub('[&<>"]', XML_ESCAPES)
    :gsub("[\xC2-\xF4][\x80-\xBF]*", xmlCodePoint):gsub("[\x80-\xFF]", "&#65533;"))
end

-- First n characters of a UTF-8 string.
function utf8Cut(s, n)
  local cut = utf8.offset(s, n + 1)
  if cut then return s:sub(1, cut - 1) end
  return s
end

local JSON_ESCAPES = { ['"'] = '"', ["\\"] = "\\", ["/"] = "/", b = "\b", f = "\f", n = "\n", r = "\r", t = "\t" }

-- Value of "key":"..." in a JSON object's text, decoded; nil when the key is
-- absent or its value is not a string. Scans escape to escape, never per
-- character.
function lldpJsonString(object, key)
  local _, valueStart = object:find('"' .. key .. '"%s*:%s*"')
  if not valueStart then return nil end
  local parts, pos = {}, valueStart + 1
  while true do
    local i = object:find('["\\]', pos)
    if not i then return nil end
    parts[#parts + 1] = object:sub(pos, i - 1)
    if object:sub(i, i) == '"' then break end
    local escape = object:sub(i + 1, i + 1)
    if escape == "u" then
      local code = tonumber(object:sub(i + 2, i + 5), 16) or 0xFFFD
      pos = i + 6
      if code >= 0xD800 and code <= 0xDBFF then
        local low = object:match("^\\u(%x%x%x%x)", pos)
        low = low and tonumber(low, 16)
        if low and low >= 0xDC00 and low <= 0xDFFF then
          code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
          pos = pos + 6
        end
      end
      if code >= 0xD800 and code <= 0xDFFF then code = 0xFFFD end
      parts[#parts + 1] = utf8.char(code)
    else
      parts[#parts + 1] = JSON_ESCAPES[escape] or escape
      pos = i + 2
    end
  end
  return table.concat(parts)
end

-- { [port] = neighbor } from a /api/lldp/neighbor array (GET body or WS
-- notification). One chunk per "port_number", up to the next one, so braces
-- inside a string never shift a field; text before the first is ignored. The
-- first neighbor of a port is kept, extra counts the others.
function lldpParseNeighbors(text)
  local starts, pos = {}, 1
  while true do
    local s, e, port = text:find('"port_number"%s*:%s*(%d+)', pos)
    if not s then break end
    starts[#starts + 1] = { at = s, port = tonumber(port) }
    pos = e + 1
  end
  local neighbors = {}
  for i, entry in ipairs(starts) do
    local nextEntry = starts[i + 1]
    local chunk = text:sub(entry.at, nextEntry and (nextEntry.at - 1) or #text)
    local known = neighbors[entry.port]
    if known then
      known.extra = known.extra + 1
    else
      neighbors[entry.port] = {
        chassisId             = lldpJsonString(chunk, "chassis_id") or "",
        chassisIdSubtype      = lldpJsonString(chunk, "chassis_id_subtype") or "",
        sysName               = lldpJsonString(chunk, "sys_name") or "",
        sysDescription        = lldpJsonString(chunk, "sys_description") or "",
        remotePort            = lldpJsonString(chunk, "remote_port") or "",
        remotePortSubtype     = lldpJsonString(chunk, "remote_port_id_subtype") or "",
        remotePortDescription = lldpJsonString(chunk, "remote_port_description") or "",
        mgmtAddress           = lldpJsonString(chunk, "mgmt_address") or "",
        extra                 = 0,
      }
    end
  end
  return neighbors
end

-- Values shown for a neighbor (spec section 4).
function lldpView(neighbor)
  local description = neighbor.sysDescription
  local cut = math.min(description:find(",", 1, true) or #description + 1,
    description:find(" (", 1, true) or #description + 1)
  local model = description:sub(1, cut - 1)
  if cut > #description or model == "" then model = nil end
  local firmware = description:match("%f[%w](v%d+%.%d+%.%d+)")

  local device = EM_DASH
  if model and firmware then
    device = model .. " " .. MIDDLE_DOT .. " " .. firmware
  elseif description ~= "" then
    device = description
  end

  local name = EM_DASH
  if neighbor.sysName ~= "" then
    name = neighbor.sysName
  elseif model and firmware then
    name = model
  elseif neighbor.chassisId ~= "" then
    name = neighbor.chassisId
  end

  local remotePort
  if neighbor.remotePortSubtype == "Local" then
    remotePort = neighbor.remotePort:gsub("^%d+/", "")
  elseif neighbor.remotePortSubtype == "MAC Address" then
    remotePort = neighbor.remotePortDescription
  else
    remotePort = neighbor.remotePort
  end
  if remotePort == "" then remotePort = EM_DASH end

  local remoteNote = neighbor.remotePortDescription
  if remoteNote == "" or remoteNote == remotePort then remoteNote = nil end

  local ip = neighbor.mgmtAddress
  -- 16 characters (the API maxLength); a long name is shortened so the
  -- " p<remote port>" suffix stays.
  local suffix = remotePort:match("^%d+$") and (" p" .. remotePort) or ""
  local legend = utf8Cut(name, 16 - #suffix):gsub("%s+$", "") .. suffix

  return {
    name = name, device = device, remotePort = remotePort, remoteNote = remoteNote,
    ip = ip ~= "" and ip or EM_DASH, ipMuted = ip:lower():sub(1, 5) == "fe80:",
    legend = legend,
    chassisKey = neighbor.chassisIdSubtype == "MAC Address" and "MAC" or "Chassis",
    chassisId = neighbor.chassisId, extra = neighbor.extra, sysName = neighbor.sysName,
  }
end

-- True when a /lldp/neighbor notification only refreshes TTLs: its new_value
-- array holds at least one "ttl" and no key other than port_number / ttl.
function lldpIsTtlOnly(raw)
  local _, open = raw:find('"new_value"%s*:%s*%[')
  if not open then return false end
  local close = raw:find("]", open + 1, true)
  if not close then return false end
  local sawTtl = false
  for key in raw:sub(open + 1, close - 1):gmatch('"([^"]*)"%s*:') do
    if key == "ttl" then
      sawTtl = true
    elseif key ~= "port_number" then
      return false
    end
  end
  return sawTtl
end

-- ~Average Roboto glyph width per px of font size.
local GLYPH_W = 0.56
local GLYPH_W_BOLD = 0.6

-- text cut to the characters that fit width px, with an ellipsis when cut.
local function lldpFit(text, width, glyphWidth)
  local chars = math.floor(width / glyphWidth)
  if (utf8.len(text) or #text) > chars then
    return utf8Cut(text, chars - 1) .. ELLIPSIS
  end
  return text
end

-- Left-aligned text centred vertically on centreY; content already escaped.
local function lldpText(x, centreY, size, fill, content, attributes)
  return '<text x="' .. svgNumber(x) .. '" y="' .. svgNumber(baseline(centreY, size)) .. '" ' .. FONT
    .. ' font-size="' .. size .. '"' .. (attributes or "") .. ' fill="' .. fill .. '">' .. content .. '</text>'
end

local function svgOpen(w, h)
  return '<svg xmlns="http://www.w3.org/2000/svg" width="' .. svgNumber(w) .. '" height="' .. svgNumber(h)
    .. '" viewBox="0 0 ' .. svgNumber(w) .. " " .. svgNumber(h) .. '">'
end

local function nameWithExtra(view)
  if view.extra > 0 then return view.name .. " +" .. view.extra end
  return view.name
end

-- Neighbor panel (main page): title row, then two key / value columns.
LLDP_PANEL_W = 520
LLDP_PANEL_H = 87
local PANEL_BUTTONS_W = 160          -- right part of the title row: -> Legend, Close
local PANEL_ROW_Y = { 40, 56, 72 }   -- row centres
local PANEL_LEFT_KEY_X, PANEL_LEFT_VALUE_X = 8, 76
local PANEL_RIGHT_KEY_X, PANEL_RIGHT_VALUE_X = 270, 320
local PANEL_TITLE_SIZE, PANEL_KEY_SIZE, PANEL_VALUE_SIZE = 11, 10, 11

-- panel = { port, view = lldpView | nil };
-- colors = { fill, border, text, muted }.
function lldpPanelSvg(panel, colors)
  local w, h = LLDP_PANEL_W, LLDP_PANEL_H
  local view = panel.view
  local parts = { svgOpen(w, h),
    rectElement(0.5, 0.5, w - 1, h - 1, 'rx="4" fill="' .. colors.fill .. '" stroke="' .. colors.border
      .. '" stroke-width="1"') }
  local title = "Port " .. panel.port .. " " .. EM_DASH .. " "
    .. (view and nameWithExtra(view) or "no LLDP neighbor")
  table.insert(parts, lldpText(PANEL_LEFT_KEY_X, 18, PANEL_TITLE_SIZE, colors.text,
    xmlText(lldpFit(title, w - PANEL_LEFT_KEY_X - PANEL_BUTTONS_W, PANEL_TITLE_SIZE * GLYPH_W_BOLD)),
    ' font-weight="bold"'))
  if view then
    local leftW = PANEL_RIGHT_KEY_X - PANEL_LEFT_VALUE_X - 8
    local rightW = w - PANEL_RIGHT_VALUE_X - 8
    local valueGlyph = PANEL_VALUE_SIZE * GLYPH_W
    local function key(x, row, label)
      table.insert(parts, lldpText(x, PANEL_ROW_Y[row], PANEL_KEY_SIZE, colors.muted, label))
    end
    local function value(x, row, text, width, fill)
      table.insert(parts, lldpText(x, PANEL_ROW_Y[row], PANEL_VALUE_SIZE, fill or colors.text,
        xmlText(lldpFit(text, width, valueGlyph))))
    end
    local remote = view.remotePort
    if view.remoteNote then remote = remote .. '  "' .. view.remoteNote .. '"' end
    key(PANEL_LEFT_KEY_X, 1, "Description")
    value(PANEL_LEFT_VALUE_X, 1, view.device, leftW)
    key(PANEL_LEFT_KEY_X, 2, "Port")
    value(PANEL_LEFT_VALUE_X, 2, remote, leftW)
    key(PANEL_LEFT_KEY_X, 3, "IP")
    value(PANEL_LEFT_VALUE_X, 3, view.ip, leftW, view.ipMuted and colors.muted or nil)
    key(PANEL_RIGHT_KEY_X, 1, view.chassisKey)
    value(PANEL_RIGHT_VALUE_X, 1, view.chassisId ~= "" and view.chassisId or EM_DASH, rightW)
  end
  table.insert(parts, "</svg>")
  return table.concat(parts)
end

local ROW_SIZE = 10

-- One Neighbors page row: row = { port, w, h, view = lldpView | nil };
-- columns = { number, name, device | nil, remotePort, ip }, each { x, w }
-- relative to the row.
function lldpRowSvg(row, colors, columns)
  local view = row.view
  local centre = row.h / 2
  local glyph = ROW_SIZE * GLYPH_W
  local parts = { svgOpen(row.w, row.h) }
  local number = columns.number
  table.insert(parts, lldpText(number.x + number.w, centre, ROW_SIZE, view and colors.text or colors.muted,
    tostring(row.port), ' font-weight="bold" text-anchor="end"'))
  local function cell(column, text, fill)
    table.insert(parts, lldpText(column.x, centre, ROW_SIZE, fill, xmlText(lldpFit(text, column.w, glyph))))
  end
  if not view then
    cell(columns.name, EM_DASH, colors.muted)
  else
    cell(columns.name, nameWithExtra(view), colors.text)
    if columns.device then cell(columns.device, view.device, colors.text) end
    cell(columns.remotePort, view.remotePort, colors.text)
    cell(columns.ip, view.ip, view.ipMuted and colors.muted or colors.text)
  end
  table.insert(parts, "</svg>")
  return table.concat(parts)
end

-- Offline chassis graphic per model (generated by tools/gen_offline_chassis.py).
-- Auto-generated by tools/gen_offline_chassis.py, do not edit.
-- Offline chassis graphic per model: base64 of chassisOfflineSvg(model).
CHASSIS_OFFLINE_SVG = {
  ["GigaCore 10i"] = "",
  ["GigaCore 10t"] = "",
  ["GigaCore 10t-IP"] = "",
  ["GigaCore 16i"] = "",
  ["GigaCore 16t"] = "",
  ["GigaCore 16tf"] = "",
  ["GigaCore 18t"] = "",
  ["GigaCore 20t"] = "",
  ["GigaCore 30i"] = "",
  ["GigaCore O26-I"] = "",
  ["GigaCore S30-I"] = "",
}

function GetProperties(props)
  local modelChoices = {}
  for modelName, _ in pairs(GigaCoreModels) do
    table.insert(modelChoices, modelName)
  end
  table.sort(modelChoices)
  
  return {
    {
      Name    = "Model",
      Type    = "enum",
      Choices = modelChoices,
      Value   = "GigaCore 30i",
    },
    {
      Name    = "Dark Mode",
      Type    = "enum",
      Choices = { "Yes", "No" },
      Value   = "Yes",
    },
    -- Periodic REST re-sync (reconcileAll) of every port, PoE, RLinkX, LAG,
    -- group, power and spanning tree state, so a WebSocket notification missed
    -- during the subscription storm heals itself. No 5 s choice: it costs the
    -- switch about 5 points of CPU.
    {
      Name    = "Poll Interval",
      Type    = "enum",
      Choices = { "Off", "15 s", "30 s", "60 s" },
      Value   = "15 s",
    },
  }
end

function GetControls(props)
  -- Controls follow the selected model: per-port controls for its ports, PoE
  -- controls for its PoE ports, fan / PSU / case temperature pins for its
  -- hardware (MODEL_HARDWARE).
  local model     = resolveModel(props)
  local portCount = getPortCount(model)
  local poeCount  = getPoeCount(model)
  local hardware  = getModelHardware(model)
  
  local c = {}
  
  -- Read-only integer pin (API integer leaf), raw value.
  local function integerPin(name, min, max)
    c[#c+1] = {
      Name        = name,
      ControlType = "Knob",
      ControlUnit = "Integer",
      Min         = min,
      Max         = max,
      PinStyle    = "Output",
      UserPin     = true,
      IsReadOnly  = true,
    }
  end
  
  -- Read-only text pin (API string or enum leaf), raw value.
  local function textPin(name)
    c[#c+1] = {
      Name        = name,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "Output",
      UserPin     = true,
      IsReadOnly  = true,
      Value       = "",
    }
  end
  
  -- Per-port pins follow the API tree: Ports.Port N.<leaf> (/ports/port/N/<leaf>).
  for p = 1, portCount do
    local port = "Ports.Port " .. p .. "."
    textPin(port .. "Link State")
    textPin(port .. "Type")
    integerPin(port .. "Counters.Rx Bit Rate", 0, 100000000000)
    integerPin(port .. "Counters.Tx Bit Rate", 0, 100000000000)
    integerPin(port .. "Counters.Link Flaps", 0, 4294967295)
  
    -- Web UI port card on the chassis: a flat Button whose Legend carries the
    -- whole card as an IconData SVG (portCardSvg); a click opens the LLDP
    -- neighbor panel.
    c[#c+1] = {
      Name        = "Port.Card " .. p,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  
    -- Grid controls that are pins too: the live value out, a write PUTs it.
    c[#c+1] = {
      Name        = port .. "Enabled",
      ControlType = "Button",
      ButtonType  = "Toggle",
      PinStyle    = "Both",
      UserPin     = true,
    }
  
    c[#c+1] = {
      Name        = port .. "Legend",
      ControlType = "Text",
      TextBoxType = "Normal",
      PinStyle    = "Both",
      UserPin     = true,
      IsReadOnly  = false,
      Value       = "",
    }
  
    c[#c+1] = {
      Name        = port .. "RLinkX.Enabled",
      ControlType = "Button",
      ButtonType  = "Toggle",
      PinStyle    = "Both",
      UserPin     = true,
    }
  
    -- link_speed {mode, speed[]} and member_of {type, id}: one pin per API
    -- object, so one write is one PUT. Link Speed is "<mode> <speed, speed>"
    -- ("auto all", "fixed 100mbps fdx"); Member Of is "group 22", "trunk 1"
    -- or "none".
    c[#c+1] = {
      Name        = port .. "Link Speed",
      ControlType = "Text",
      TextBoxType = "Normal",
      PinStyle    = "Both",
      UserPin     = true,
      Value       = "",
    }
  
    c[#c+1] = {
      Name        = port .. "Member Of",
      ControlType = "Text",
      TextBoxType = "Normal",
      PinStyle    = "Both",
      UserPin     = true,
      Value       = "",
    }
  
    -- Speed cell — Button showing the current link speed; click opens the
    -- speed picker panel (zSpeed.* controls below).
    c[#c+1] = {
      Name        = "Port.Speed Cell " .. p,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  
    -- Port group membership cell — Button colored with the group's color,
    -- Legend = friendly group/trunk name. Click opens the group picker panel
    -- (zPicker.* controls below) to reassign the port.
    c[#c+1] = {
      Name        = "Port.Group " .. p,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  
    -- Per-port identify button (the port-number label in the settings grid).
    -- Clicking PUTs /api/port_identify with this port number.
    c[#c+1] = {
      Name        = "Port Identify.Port " .. p,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "Input",
      UserPin     = true,
    }
  end
  
  -- PoE controls for the model's PoE ports only (PORT_LAYOUT poe), under the
  -- API tree PoE.Port N.<leaf> (/poe/ports/N/<leaf>).
  for p = 1, poeCount do
    textPin("PoE.Port " .. p .. ".Indication")
  
    -- Grid toggle and pin: the live value out, a write PUTs it.
    c[#c+1] = {
      Name        = "PoE.Port " .. p .. ".Enabled",
      ControlType = "Button",
      ButtonType  = "Toggle",
      PinStyle    = "Both",
      UserPin     = true,
    }
  
    -- Grid button only (off, 3 s, on): not an API field, no pin.
    c[#c+1] = {
      Name        = "PoE.Bounce " .. p,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  end
  
  -- Group picker panel (main page). Hidden until a Port.Group cell is clicked;
  -- items mirror the Groups and Trunks page slots: zPicker.Group 1..20
  -- predefined, 21.. custom slots, zPicker.Trunk 1 = ISL, 2.. custom slots.
  local function pickerButton(name)
    c[#c+1] = {
      Name        = name,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  end
  local function pickerText(name)
    c[#c+1] = {
      Name        = name,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = "",
    }
  end
  pickerButton("zPicker.Bg")
  pickerText("zPicker.Title")
  pickerButton("zPicker.None")
  pickerButton("zPicker.Cancel")
  for i = 1, 4 do pickerText("zPicker.Label " .. i) end
  for i = 1, 20 + CUSTOM_GROUP_SLOTS do pickerButton("zPicker.Group " .. i) end
  for i = 1, 1 + CUSTOM_TRUNK_SLOTS do pickerButton("zPicker.Trunk " .. i) end
  
  -- Speed picker panel (main page). Hidden until a Port.Speed Cell is clicked;
  -- zSpeed.Item i shows SPEED_CHOICES[i].
  pickerButton("zSpeed.Bg")
  pickerText("zSpeed.Title")
  pickerButton("zSpeed.Cancel")
  for i = 1, #SPEED_CHOICES do pickerButton("zSpeed.Item " .. i) end
  
  -- Group labels + ID badges (slots 1..40)
  for i = 1, 40 do
    c[#c+1] = {
      Name        = "group_label_" .. i,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = "",
    }
  end
  
  for i = 1, 40 do
    c[#c+1] = {
      Name        = "group_id_badge_" .. i,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = "",
    }
  end
  
  -- Trunk labels + ID badges (slots 1..10)
  for i = 1, 10 do
    c[#c+1] = {
      Name        = "trunk_label_" .. i,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = "",
    }
    c[#c+1] = {
      Name        = "trunk_id_badge_" .. i,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = "",
    }
  end
  
  -- Device pins follow the API tree (/device/..., /ip_settings/mode). The
  -- display block shows Device.Name, Description, MAC Address and
  -- Firmware.Active as they are; formatted lines (model, IP, gateway, status)
  -- are internal Display.* controls.
  c[#c+1] = {
    Name        = "Device.Name",
    ControlType = "Text",
    TextBoxType = "ReadOnly",
    PinStyle    = "Output",
    UserPin     = true,
    IsReadOnly  = true,
    Value       = "",
    MultiLine   = true,
  }
  
  c[#c+1] = {
    Name        = "Device.Description",
    ControlType = "Text",
    TextBoxType = "ReadOnly",
    PinStyle    = "Output",
    UserPin     = true,
    IsReadOnly  = true,
    Value       = "",
    MultiLine   = true,
  }
  
  -- Raw /api/device model ("GigaCore30i"); Display.Model shows the model line.
  textPin("Device.Model")
  textPin("Device.Hostname")
  textPin("Device.MAC Address")
  textPin("Device.Firmware.Active")
  textPin("Device.Actual IP.IP Address")
  integerPin("Device.Actual IP.Prefix Length", 0, 32)
  textPin("Device.Actual IP.Default Gateway")
  textPin("IP Settings.Mode")
  
  -- Identify (PUT /api/identify): the logo on the main page and the
  -- Configuration page button.
  c[#c+1] = {
    Name        = "Identify",
    ControlType = "Button",
    ButtonType  = "Momentary",
    PinStyle    = "Input",
    UserPin     = true,
  }
  
  -- Q-SYS status pin, outside the API (refreshStatus, info.lua): OK connected,
  -- Initializing connecting, Missing offline, Fault no IP / auth failure,
  -- Compromised on a model mismatch or a PSU / fan not good.
  c[#c+1] = {
    Name          = "Status",
    ControlType   = "Indicator",
    IndicatorType = "Status",
    PinStyle      = "Output",
    UserPin       = true,
    IsReadOnly    = true,
  }
  
  -- Display block lines, no pin: "GigaCore 30i" or "Switch is <model>"
  -- flashing, "<ip>/<prefix> (<mode>)", "Gateway <ip>" (blank on 0.0.0.0),
  -- and the Online / Offline badge.
  local function displayText(name, value)
    c[#c+1] = {
      Name        = name,
      ControlType = "Text",
      TextBoxType = "ReadOnly",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
      Value       = value or "",
    }
  end
  displayText("Display.Model")
  displayText("Display.IP Info")
  displayText("Display.Gateway")
  c[#c+1] = {
    Name        = "Display.Status",
    ControlType = "Text",
    TextBoxType = "ReadOnly",
    PinStyle    = "None",
    UserPin     = false,
    IsReadOnly  = false,
    Value       = "Offline",
  }
  
  -- Configuration page (connection settings, no pin)
  c[#c+1] = {
    Name        = "Auth.IP Address",
    ControlType = "Text",
    TextBoxType = "Normal",
    PinStyle    = "None",
    UserPin     = false,
    Value       = "Enter your IP",
  }
  
  c[#c+1] = {
    Name        = "Auth.Username",
    ControlType = "Text",
    TextBoxType = "Normal",
    PinStyle    = "None",
    UserPin     = false,
    Value       = "",
  }
  
  c[#c+1] = {
    Name        = "Auth.Password",
    ControlType = "Text",
    PinStyle    = "None",
    UserPin     = false,
    Value       = "",
  }
  
  -- Bullets shown under the password box (its own text is transparent).
  c[#c+1] = {
    Name        = "Auth.Masked Password",
    ControlType = "Indicator",
    IndicatorType = "Text",
    PinStyle    = "None",
    UserPin     = false,
  }
  
  c[#c+1] = {
    Name        = "Auth.Status",
    ControlType = "Text",
    TextBoxType = "ReadOnly",
    PinStyle    = "None",
    UserPin     = false,
    Value       = "",
  }
  
  c[#c+1] = {
    Name        = "Auth.Connect",
    ControlType = "Button",
    ButtonType  = "Toggle",
    PinStyle    = "None",
    UserPin     = false,
  }
  
  -- System, temperatures, fans and power pins (API tree, raw integers: %,
  -- degrees C, rpm, mW). Fans, PSU slots and the case sensor follow the model
  -- (MODEL_HARDWARE). The ranges hold the API error markers (a Knob clamps
  -- its Value): temperature -1000, PSU power_usage -1.
  integerPin("System.CPU Load", 0, 100)
  integerPin("System.CPU Load Long", 0, 100)
  integerPin("Temperatures.CPU.Current", -1000, 150)
  if hardware.caseTemp then
    integerPin("Temperatures.Case.Current", -1000, 150)
  end
  for i = 1, hardware.fans do
    integerPin("Fans.Fan " .. i .. ".Speed", 0, 100000)
  end
  integerPin("Power.Total Power Usage", 0, 100000000)
  integerPin("Power.Total Power Max", 0, 100000000)
  textPin("Power.Coupling.Mode")
  for i = 1, hardware.psus do
    textPin("Power.PSU " .. i .. ".State")
    textPin("Power.PSU " .. i .. ".Power Status")
    integerPin("Power.PSU " .. i .. ".Power Usage", -1, 100000000)
  end
  
  -- Switch-wide RLinkX flag (/rlinkx/enabled), read only.
  c[#c+1] = {
    Name        = "RLinkX.Enabled",
    ControlType = "Button",
    ButtonType  = "Toggle",
    PinStyle    = "Output",
    UserPin     = true,
    IsReadOnly  = true,
  }
  
  -- RSTP lines of the status block (formatted text, no pin)
  c[#c+1] = { Name = "RSTP.Bridge Priority", ControlType = "Text", TextBoxType = "ReadOnly", PinStyle = "None", UserPin = false, Value = "" }
  c[#c+1] = { Name = "RSTP.Root Bridge",     ControlType = "Text", TextBoxType = "ReadOnly", PinStyle = "None", UserPin = false, Value = "" }
  
  -- Status block paint targets (right of the chassis, like the switch web UI):
  -- PSU icons, coupling glyph, status dot. Internal only, laid out as Buttons.
  for _, name in ipairs({ "PSU.1 Icon", "PSU.2 Icon", "Power.Coupling Glyph", "Display.Status Dot" }) do
    c[#c+1] = { Name = name, ControlType = "Text", TextBoxType = "ReadOnly", PinStyle = "None", UserPin = false, Value = "" }
  end
  
  -- Querier panel under the RSTP lines: a flat read-only Button whose Legend
  -- carries the title and the group badges as one IconData SVG (querierBadgesSvg).
  c[#c+1] = {
    Name        = "Querier.Badges",
    ControlType = "Button",
    ButtonType  = "Toggle",
    PinStyle    = "None",
    UserPin     = false,
    IsReadOnly  = true,
  }
  
  -- LLDP neighbor panel (main page), opened from a chassis card: the panel SVG
  -- (clickable, so a click on it never reaches the grid underneath) and its two
  -- buttons, named to sort (and draw) above it.
  c[#c+1] = {
    Name        = "zLldp.Panel",
    ControlType = "Button",
    ButtonType  = "Momentary",
    PinStyle    = "None",
    UserPin     = false,
  }
  for _, name in ipairs({ "zLldp.Panel To Legend", "zLldp.Panel Close" }) do
    c[#c+1] = {
      Name        = name,
      ControlType = "Button",
      ButtonType  = "Momentary",
      PinStyle    = "None",
      UserPin     = false,
    }
  end
  
  -- Neighbors page (LLDP): per port a row (one IconData SVG drawing every cell,
  -- lldpRowSvg).
  for p = 1, portCount do
    c[#c+1] = {
      Name        = "Lldp.Row " .. p,
      ControlType = "Button",
      ButtonType  = "Toggle",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
    }
  end
  
  -- 10G frame per tenG group (IconData Button, like Port.Card), shown while the
  -- 10g licence is active. Declared for the model with the most tenG groups.
  local tenGFrameCount = 0
  for _, layout in pairs(CHASSIS_LAYOUT) do
    local count = 0
    for _, group in ipairs(layout) do
      if group.tenG then count = count + 1 end
    end
    if count > tenGFrameCount then tenGFrameCount = count end
  end
  for i = 1, tenGFrameCount do
    c[#c+1] = {
      Name        = "Chassis.10G " .. i,
      ControlType = "Button",
      ButtonType  = "Toggle",
      PinStyle    = "None",
      UserPin     = false,
      IsReadOnly  = true,
    }
  end
  
  return c
end

function GetControlLayout(props)
  -- Dark mode from property
  local darkProp = props["Dark Mode"]
  local darkModeValue = (type(darkProp) == "table") and darkProp.Value or darkProp
  state.darkMode = (darkModeValue == "Yes")
  
  local modelString    = resolveModel(props)
  local portCount      = getPortCount(modelString)
  state.portCount      = portCount
  state.selectedModel  = modelString  -- design time only; the runtime reads Properties["Model"]
  
  -- Two-row device header (Araneo-style), three columns left-aligned:
  --   Col 1: [Status]      / [Firmware]      — narrow, left edge
  --   Col 2: [Switch Name] / [Description]   — middle
  --   Col 3: [IP/Subnet]   / [MAC]           — right
  local function defineCommonDeviceInfo(layout, gfx, theme, lumCenterX, ipSpacing)
    local row1Y, row2Y = 2, 22
    local rowH = 20
    local x0 = 10
  
    local statusW = 60
    local nameW   = 220
    local infoW   = 220   -- IP+Subnet / MAC width (3rd column)
    local gap     = 10
    local col2X = x0 + statusW + gap
    local col3X = col2X + nameW + gap
  
    -- Grey badge under the transparent status control. No text placeholders:
    -- Designer keeps the last runtime text offline but drops the runtime fill,
    -- so a placeholder would show through the stale value.
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { x0, row1Y },
      Size         = { statusW, rowH },
      Fill         = theme.badgeOffBg,
      StrokeWidth  = 0,
      CornerRadius = 6,
    }
  
    layout["Display.Status"] = {
      Style        = "Text",
      Position     = { x0, row1Y },
      Size         = { statusW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      Font         = "Roboto",
      FontSize     = 11,
      TextColor    = { 255, 255, 255 },
      StrokeWidth  = 0,
      CornerRadius = 6,
      HTextAlign   = "Center",
      VTextAlign   = "Center",
      Legend       = "Offline",
    }
  
    layout["Device.Name"] = {
      Style        = "Indicator",
      Position     = { col2X, row1Y },
      Size         = { nameW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      StrokeColor  = theme.strokeColor,
      StrokeWidth  = 0,
      TextColor    = theme.textColor,
      HTextAlign   = "Left",
      VTextAlign   = "Center",
      FontSize     = 11,
      Font         = "Roboto",
      CornerRadius = 1,
    }
  
    layout["Device.Description"] = {
      Style        = "Indicator",
      Position     = { col2X, row2Y },
      Size         = { nameW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      StrokeColor  = theme.strokeColor,
      StrokeWidth  = 0,
      TextColor    = theme.textColor,
      HTextAlign   = "Left",
      VTextAlign   = "Center",
      FontSize     = 11,
      Font         = "Roboto",
      CornerRadius = 1,
    }
  
    layout["Display.IP Info"] = {
      Style        = "Indicator",
      Position     = { col3X, row1Y },
      Size         = { infoW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      StrokeColor  = theme.strokeColor,
      StrokeWidth  = 0,
      TextColor    = theme.textColor,
      FontSize     = 11,
      Font         = "Roboto",
      HTextAlign   = "Left",
      VTextAlign   = "Center",
      CornerRadius = 1,
    }
  
    layout["Device.MAC Address"] = {
      Style        = "Indicator",
      Position     = { col3X, row2Y },
      Size         = { infoW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      StrokeColor  = theme.strokeColor,
      StrokeWidth  = 0,
      TextColor    = theme.textColor,
      FontSize     = 11,
      Font         = "Roboto",
      HTextAlign   = "Left",
      VTextAlign   = "Center",
      CornerRadius = 1,
    }
  
    layout["Device.Firmware.Active"] = {
      Style        = "Indicator",
      Position     = { x0, row2Y },
      Size         = { statusW, rowH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      StrokeColor  = theme.strokeColor,
      StrokeWidth  = 0,
      TextColor    = theme.textColor,
      FontSize     = 10,
      Font         = "Roboto",
      HTextAlign   = "Center",
      VTextAlign   = "Center",
      CornerRadius = 1,
    }
  end
  
  --------------------------------------------------------------------------------
  -- Helper: rounded card (info panel)
  --------------------------------------------------------------------------------
  local function drawCard(gfx, x, y, w, h, theme)
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { x, y },
      Size         = { w, h },
      Fill         = theme.cardFill,
      StrokeColor  = theme.cardStroke,
      StrokeWidth  = 1,
      CornerRadius = 8,
    }
  end
  
  --------------------------------------------------------------------------------
  -- Helper: grid background (faint lines every 40px)
  --------------------------------------------------------------------------------
  local function drawGridBackground(gfx, w, h, theme)
    gfx[#gfx+1] = {
      Type        = "Rectangle",
      Position    = { 0, 0 },
      Size        = { w, h },
      Fill        = theme.pageBg,
      StrokeWidth = 0,
    }
    for x = 0, w, 40 do
      gfx[#gfx+1] = {
        Type        = "Rectangle",
        Position    = { x, 0 },
        Size        = { 1, h },
        Fill        = theme.gridLine,
        StrokeWidth = 0,
      }
    end
    for y = 0, h, 40 do
      gfx[#gfx+1] = {
        Type        = "Rectangle",
        Position    = { 0, y },
        Size        = { w, 1 },
        Fill        = theme.gridLine,
        StrokeWidth = 0,
      }
    end
  end
  
  --------------------------------------------------------------------------------
  -- Main page: device display block, the web UI chassis box (offline graphic
  -- plus one Port.Card button per port), status block, port-settings grid.
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  -- Status block: the black "screen" the switch web UI draws right of the
  -- chassis. Status dot top-left, RSTP root bridge lines under it, PSU column
  -- at the right (PSU1 label, icon, coupling glyph, icon, PSU2 label).
  -- The runtime fills the RSTP text controls, pushes a state-tinted PSU icon
  -- into PSU.N Icon (Legend IconData, over the grey gfx icon) and the coupling
  -- glyph. No text placeholders under the RSTP values: Designer keeps the last
  -- runtime text offline, a placeholder would show through it.
  --------------------------------------------------------------------------------
  -- Flat read-only Button whose Legend carries an IconData SVG (Port.Card N,
  -- Chassis.10G N, Querier.Badges). Designer draws a Button's content 2 px
  -- inside its box, so the box grows by that inset (the SVG viewBox is the box
  -- without it).
  local BUTTON_INSET = 2
  local function iconButton(layout, name, x, y, w, h)
    layout[name] = {
      Style             = "Button",
      ButtonStyle       = "Toggle",
      ButtonVisualStyle = "Flat",
      Position          = { x - BUTTON_INSET, y - BUTTON_INSET },
      Size              = { w + BUTTON_INSET * 2, h + BUTTON_INSET * 2 },
      IsReadOnly        = true,
      Color             = { 0, 0, 0, 0 },
      OffColor          = { 0, 0, 0, 0 },
      StrokeColor       = { 0, 0, 0, 0 },
      StrokeWidth       = 0,
      Legend            = "",
    }
  end
  
  -- The same, clickable (Momentary, not read-only): Port.Card N, zLldp.Panel.
  local function clickableIconButton(layout, name, x, y, w, h)
    iconButton(layout, name, x, y, w, h)
    layout[name].ButtonStyle = "Momentary"
    layout[name].IsReadOnly  = nil
  end
  
  local function buildStatusBlock(layout, gfx, theme, x, y, h, outlineW)
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { x, y },
      Size         = { STATUS_W, h },
      Fill         = theme.pageBg,
      StrokeColor  = { 255, 255, 255, 255 },
      StrokeWidth  = outlineW,
      CornerRadius = 4,
    }
    local pad   = 5
    local inX   = x + outlineW + pad
    local inY   = y + outlineW + pad
    local inW   = STATUS_W - (outlineW + pad) * 2
    local lineH = 14
  
    local function text(tx, ty, w, h2, str, color, align, size)
      gfx[#gfx+1] = {
        Type       = "Text",
        Text       = str,
        Position   = { tx, ty },
        Size       = { w, h2 },
        Font       = "Roboto",
        FontSize   = size or 10,
        Color      = color,
        HTextAlign = align or "Left",
        VTextAlign = "Center",
      }
    end
    local function valueBox(name, bx, by, w)
      layout[name] = {
        Style        = "Text",
        Position     = { bx, by },
        Size         = { w, lineH },
        IsReadOnly   = true,
        Color        = { 0, 0, 0, 0 },
        Font         = "Roboto",
        FontSize     = 10,
        TextColor    = theme.textPrimary,
        StrokeWidth  = 0,
        CornerRadius = 1,
        HTextAlign   = "Left",
        VTextAlign   = "Center",
      }
    end
    local function flatButton(name, bx, by, w, h2, extra)
      local entry = {
        Style             = "Button",
        ButtonStyle       = "Momentary",
        ButtonVisualStyle = "Flat",
        Position          = { bx, by },
        Size              = { w, h2 },
        Color             = { 0, 0, 0, 0 },
        OffColor          = { 0, 0, 0, 0 },
        StrokeColor       = { 0, 0, 0, 0 },
        StrokeWidth       = 0,
        Legend            = "",
      }
      for k, v in pairs(extra or {}) do entry[k] = v end
      layout[name] = entry
    end
  
    -- Status dot (grey placeholder offline; runtime paints green / red pulse)
    local dotD = 7
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { inX, inY + 2 },
      Size         = { dotD, dotD },
      Fill         = theme.badgeOffBg,
      StrokeWidth  = 0,
      CornerRadius = 3,
    }
    flatButton("Display.Status Dot", inX, inY + 2, dotD, dotD, { CornerRadius = 3 })
  
    -- RSTP lines, left of the PSU column
    local psuColW = 48
    local textW   = inW - psuColW - pad
    local line2   = inY + lineH
    text(inX, line2, textW, lineH, "Root bridge", theme.textMuted)
    valueBox("RSTP.Root Bridge", inX, line2 + lineH, textW)
    local prioW = 44
    text(inX, line2 + lineH * 2, prioW, lineH, "Priority", theme.textMuted)
    valueBox("RSTP.Bridge Priority", inX + prioW, line2 + lineH * 2, textW - prioW)
  
    -- Querier panel under the Priority line (textW = QUERIER_W at this block
    -- width). Blank until the runtime draws badges.
    iconButton(layout, "Querier.Badges", inX, inY + lineH * 4, QUERIER_W, QUERIER_H)
  
    -- PSU column: label, icon in a halo ring, coupling glyph, icon, label
    local colX   = inX + inW - psuColW
    local labelH = 12
    local haloD  = 24
    local iconD  = 18
    local glyphH = 14
    local iconX  = colX + math.floor((psuColW - iconD) / 2)
    local cy     = inY
    local function psu(id)
      local labelY = (id == 1) and cy or (cy + haloD)
      local haloY  = (id == 1) and (cy + labelH) or cy
      text(colX, labelY, psuColW, labelH, "PSU" .. id, theme.textPrimary, "Center")
      gfx[#gfx+1] = {
        Type     = "Svg",
        Image    = LogoPSU,
        Position = { iconX, haloY + math.floor((haloD - iconD) / 2) },
        Size     = { iconD, iconD },
      }
      flatButton("PSU." .. id .. " Icon", iconX, haloY + math.floor((haloD - iconD) / 2), iconD, iconD)
    end
    psu(1)
    cy = cy + labelH + haloD
    flatButton("Power.Coupling Glyph", colX, cy, psuColW, glyphH)
    cy = cy + glyphH
    psu(2)
  end
  
  local function buildChassisPage(layout, gfx, model, theme)
    local geometry = chassisGeometry(model)
    local blockX, blockY = CHASSIS_X, CHASSIS_Y
    local chassisX, chassisY = blockX + DISPLAY_W + DISPLAY_GAP, CHASSIS_Y
    local svgH = CHASSIS_H
  
    -- Per-port settings grid below the chassis. Bottom gap matches the top
    -- gap so the page is symmetrically padded; column and row counts come
    -- from gridDimsForModel.
    local topGap    = 6
    local gridY     = chassisY + CHASSIS_H + topGap
    local cols, rows = gridDimsForModel(model)
    local portCount = getPortCount(model)
    local rowH      = GRID_ROW_H
    local pageH     = pageHeightForModel(model)
  
    gfx[#gfx+1] = {
      Type        = "Groupbox",
      Fill        = theme.groupboxFill,
      StrokeColor = GROUPBOX_STROKE_COLOR,
      StrokeWidth = GROUPBOX_STROKE_WIDTH,
      Position    = GROUPBOX_POSITION,
      Size        = { pageWidthForModel(model), pageH },
    }
  
    -- Device display block (the web UI's left screen): page-bg fill, 1 px
    -- white outline like the chassis box.
    local outlineW = 1
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { blockX, blockY },
      Size         = { DISPLAY_W, svgH },
      Fill         = theme.pageBg,
      StrokeColor  = { 255, 255, 255, 255 },
      StrokeWidth  = outlineW,
      CornerRadius = 4,
    }
    local scrX, scrY = blockX + outlineW, blockY + outlineW
    local scrW = DISPLAY_W - outlineW * 2
  
    -- Chassis box as the web UI draws it when not live (generated by
    -- tools/gen_offline_chassis.py); the Port.Card buttons on top carry the
    -- live cards and cover their offline twins.
    gfx[#gfx+1] = {
      Type     = "Svg",
      Image    = CHASSIS_OFFLINE_SVG[model],
      Position = { chassisX, chassisY },
      Size     = { geometry.w, CHASSIS_H },
    }
  
    -- Status block right of the chassis (the web UI's right-hand screen);
    -- lives inside the 380px right margin.
    buildStatusBlock(layout, gfx, theme, chassisX + geometry.w + STATUS_GAP, blockY, svgH, outlineW)
  
    -- Screen contents: logo + status badge on the first row, then model,
    -- device name, description, IP, gateway (blank when the switch has none),
    -- firmware + MAC. Only the model line has a static placeholder (the same
    -- text Display.Model shows); the other lines have none because Designer
    -- keeps the last runtime text offline and a placeholder would show through.
    local pad   = 5
    local logoH = 28
    local logoW = math.floor(logoH * 3.3 + 0.5)
    local logoX, logoY = scrX + pad, scrY + pad
    gfx[#gfx+1] = {
      Type     = "Svg",
      Image    = LogoLuminex,
      Position = { logoX, logoY },
      Size     = { logoW, logoH },
    }
    -- Invisible button covering the logo — click triggers /api/identify.
    layout["Identify"] = {
      Style             = "Button",
      ButtonStyle       = "Momentary",
      ButtonVisualStyle = "Flat",
      Position          = { logoX, logoY },
      Size              = { logoW, logoH },
      Color             = { 0, 0, 0, 0 },
      OffColor          = { 0, 0, 0, 0 },
      StrokeColor       = { 0, 0, 0, 0 },
      StrokeWidth       = 0,
      Legend            = "",
    }
  
    local statusW, statusH = 56, 16
    local statusX = scrX + scrW - pad - statusW
    local statusY = logoY + math.floor((logoH - statusH) / 2)
    gfx[#gfx+1] = {
      Type         = "Rectangle",
      Position     = { statusX, statusY },
      Size         = { statusW, statusH },
      Fill         = theme.badgeOffBg,
      StrokeWidth  = 0,
      CornerRadius = 6,
    }
    layout["Display.Status"] = {
      Style        = "Text",
      Position     = { statusX, statusY },
      Size         = { statusW, statusH },
      IsReadOnly   = true,
      Color        = { 0, 0, 0, 0 },
      Font         = "Roboto",
      FontSize     = 10,
      TextColor    = { 255, 255, 255 },
      StrokeWidth  = 0,
      CornerRadius = 6,
      HTextAlign   = "Center",
      VTextAlign   = "Center",
    }
  
    local lineH = 14
    local lineX = scrX + pad
    local lineW = scrW - pad * 2
    local line1 = logoY + logoH + 4
    local function screenText(x, y, w, text, color, bold)
      gfx[#gfx+1] = {
        Type       = "Text",
        Text       = text,
        Position   = { x, y },
        Size       = { w, lineH },
        Font       = "Roboto",
        FontSize   = 10,
        Color      = color,
        HTextAlign = "Left",
        VTextAlign = "Center",
        IsBold     = bold or false,
      }
    end
    local function screenBox(name, x, y, w, bold)
      layout[name] = {
        Style        = "Text",
        Position     = { x, y },
        Size         = { w, lineH },
        IsReadOnly   = true,
        Color        = { 0, 0, 0, 0 },
        Font         = "Roboto",
        FontSize     = 10,
        IsBold       = bold or false,
        TextColor    = theme.textPrimary,
        StrokeWidth  = 0,
        CornerRadius = 1,
        HTextAlign   = "Left",
        VTextAlign   = "Center",
      }
    end
    screenText(lineX, line1, lineW, model, theme.textPrimary, true)
    local fwW = 44
    screenBox("Display.Model",      lineX, line1, lineW, true)
    screenBox("Device.Name",        lineX, line1 + lineH, lineW)
    screenBox("Device.Description", lineX, line1 + lineH * 2, lineW)
    screenBox("Display.IP Info",    lineX, line1 + lineH * 3, lineW)
    screenBox("Display.Gateway",    lineX, line1 + lineH * 4, lineW)
    screenBox("Device.Firmware.Active", lineX, line1 + lineH * 5, fwW)
    screenBox("Device.MAC Address", lineX + fwW + 4, line1 + lineH * 5, lineW - fwW - 4)
  
    -- One IconData Button per port card (Port.Card N) and per 10G frame
    -- (Chassis.10G N). A card box is the card plus CARD_BAR_SPACE on its
    -- MultiLinkX side; a frame box adds FRAME_LABEL_SPACE on the left for the
    -- rotated label.
    for port, card in pairs(geometry.cards) do
      local y = chassisY + card.y
      if cardBarOnTop(card) then y = y - CARD_BAR_SPACE end
      -- Clickable: opens the LLDP neighbor panel.
      clickableIconButton(layout, "Port.Card " .. port, chassisX + card.x, y, card.w, card.h + CARD_BAR_SPACE)
    end
    local frameIndex = 0
    for _, frame in ipairs(geometry.frames) do
      if frame.tenG then
        frameIndex = frameIndex + 1
        iconButton(layout, "Chassis.10G " .. frameIndex, chassisX + frame.x - FRAME_LABEL_SPACE, chassisY + frame.y,
          frame.w + FRAME_LABEL_SPACE, frame.h)
      end
    end
  
    -- Per-port settings grid below the chassis (columns and rows from
    -- gridDimsForModel): port number, enable toggle, legend TextBox, RLinkX
    -- toggle, PoE toggle, PoE bounce, group cell, speed cell. Ports above the
    -- model's PoE count leave the two PoE cells empty.
    local poeCount   = getPoeCount(model)
    local labelW     = 16
    local enableW    = 20
    local legendW    = gridLegendWidth(model)
    local rlinkxW    = 20
    local poeToggleW = 20
    local poeBounceW = 20
    local groupW     = 68
    local speedW     = 110
    local colPad     = GRID_COL_PAD
    local colW       = GRID_COL_W + legendW - GRID_LEGEND_MIN_W
    local cellH      = 18
    local xStart     = GRID_X_START
    local cSpacing   = colW + colPad
  
    for p = 1, portCount do
      local col = math.floor((p - 1) / rows)
      local rowI = (p - 1) % rows
      local y = gridY + rowI * rowH
      local x = xStart + col * cSpacing
  
      local labelX     = x
      local enableX    = labelX + labelW
      local legendX    = enableX + enableW
      local rlinkxX    = legendX + legendW
      local poeToggleX = rlinkxX + rlinkxW
      local poeBounceX = poeToggleX + poeToggleW
      local groupX     = poeBounceX + poeBounceW
      local speedX     = groupX + groupW
  
      layout["Ports.Port " .. p .. ".Enabled"] = {
        Style             = "Button",
        ButtonStyle       = "Toggle",
        Position          = { enableX, y },
        Size              = { enableW, cellH },
        FontSize          = 9,
        TextColor         = { 255, 255, 255 },
        Color             = { 30, 200, 60 },
        OffColor          = { 0, 0, 0 },
        CornerRadius      = 2,
        HTextAlign        = "Center",
        VTextAlign        = "Center",
        ButtonVisualStyle = "Flat",
        Legend            = "",
      }
  
      -- Port number is a clickable Button (identifies the port via API).
      layout["Port Identify.Port " .. p] = {
        Style             = "Button",
        ButtonStyle       = "Momentary",
        ButtonVisualStyle = "Flat",
        Position          = { labelX, y },
        Size              = { labelW, cellH },
        Font              = "Roboto",
        FontSize          = 10,
        Legend            = tostring(p),
        TextColor         = theme.textPrimary,
        Color             = { 0, 0, 0, 0 },
        OffColor          = { 0, 0, 0, 0 },
        StrokeColor       = { 0, 0, 0, 0 },
        StrokeWidth       = 0,
      }
  
      layout["Ports.Port " .. p .. ".Legend"] = {
        Style        = "TextBox",
        Position     = { legendX + 1, y },
        Size         = { legendW - 2, cellH },
        Font         = "Roboto",
        FontSize     = 10,
        HTextAlign   = "Left",
        TextColor    = theme.textPrimary,
        Color        = { 0, 0, 0, 0 },
        StrokeColor  = theme.cardStroke,
        StrokeWidth  = 1,
        CornerRadius = 1,
      }
  
      layout["Ports.Port " .. p .. ".RLinkX.Enabled"] = {
        Style             = "Button",
        ButtonStyle       = "Toggle",
        Position          = { rlinkxX, y },
        Size              = { rlinkxW, cellH },
        Color             = { 0, 200, 255 },
        CornerRadius      = 2,
        OffColor          = { 40, 40, 40 },
        HTextAlign        = "Center",
        VTextAlign        = "Center",
        ButtonVisualStyle = "Flat",
        Legend            = "",
      }
  
      if p <= poeCount then
        layout["PoE.Port " .. p .. ".Enabled"] = {
          Style             = "Button",
          ButtonStyle       = "Toggle",
          Position          = { poeToggleX, y },
          Size              = { poeToggleW, cellH },
          Color             = { 0, 0, 0, 0 },
          CornerRadius      = 2,
          ButtonVisualStyle = "Flat",
          Legend            = "",
        }
  
        layout["PoE.Bounce " .. p] = {
          Style             = "Button",
          ButtonStyle       = "Momentary",
          Position          = { poeBounceX, y },
          Size              = { poeBounceW, cellH },
          Legend            = "↻",
          FontSize          = 10,
          TextColor         = theme.textPrimary,
          Color             = theme.accentCyan,
          OffColor          = theme.buttonOffColor,
          CornerRadius      = 2,
          ButtonVisualStyle = "Flat",
        }
      end
  
      layout["Port.Group " .. p] = {
        Style             = "Button",
        ButtonStyle       = "Momentary",
        ButtonVisualStyle = "Flat",
        Position          = { groupX, y },
        Size              = { groupW, cellH },
        Font              = "Roboto",
        FontSize          = 10,
        Legend            = "",
        TextColor         = { 255, 255, 255, 255 },
        Color             = { 60, 70, 90, 255 },
        OffColor          = { 60, 70, 90, 255 },
        StrokeColor       = theme.cardStroke,
        StrokeWidth       = 1,
        CornerRadius      = 2,
      }
  
      layout["Port.Speed Cell " .. p] = {
        Style             = "Button",
        ButtonStyle       = "Momentary",
        ButtonVisualStyle = "Flat",
        Position          = { speedX, y },
        Size              = { speedW, cellH },
        Font              = "Roboto",
        FontSize          = 10,
        Legend            = "",
        TextColor         = { 255, 255, 255, 255 },
        Color             = { 60, 70, 90, 255 },
        OffColor          = { 60, 70, 90, 255 },
        StrokeColor       = theme.cardStroke,
        StrokeWidth       = 1,
        CornerRadius      = 2,
      }
    end
  
  end
  
  --------------------------------------------------------------------------------
  -- Groups and Trunks sections (groups | custom groups | trunks | custom
  -- trunks): a vertical card list per section that spills into sub-columns
  -- after groupsRowsForModel(model) items. Shared by the Groups and Trunks
  -- page and the main-page group picker. onSection(index, title, x, labelY,
  -- widthPx) fires once per section, onCard(kind, item, x, y) once per card
  -- (item = { slot, name, key } or { slot, placeholder = true } for a reserved
  -- custom slot the runtime fills later).
  --------------------------------------------------------------------------------
  local function walkGroupTrunkSections(model, originX, labelY, cardsY, onSection, onCard)
    local rows = groupsRowsForModel(model)
    local sections = {
      { title = "Groups",        kind = "group", items = {} },
      { title = "Custom groups", kind = "group", items = {} },
      { title = "Trunks",        kind = "trunk", items = {} },
      { title = "Custom trunks", kind = "trunk", items = {} },
    }
    for i = 1, 20 do
      local name = state.groupNames[i] or (i == 1 and "Management" or ("Group " .. string.format("%02d", i)))
      sections[1].items[i] = { slot = i, name = name, key = "Group: " .. i }
    end
    for i = 1, CUSTOM_GROUP_SLOTS do
      sections[2].items[i] = { slot = 20 + i, placeholder = true }
    end
    sections[3].items[1] = { slot = 1, name = "ISL", key = "Trunk: 1" }
    for i = 1, CUSTOM_TRUNK_SLOTS do
      sections[4].items[i] = { slot = 1 + i, placeholder = true }
    end
  
    local cursorX = originX
    for si, s in ipairs(sections) do
      local subCols    = math.max(1, math.ceil(#s.items / rows))
      local sectionWpx = subCols * GT_CARD_W + (subCols - 1) * 4
      onSection(si, s.title, cursorX, labelY, sectionWpx)
      for idx, item in ipairs(s.items) do
        local subCol = math.floor((idx - 1) / rows)
        local rowI   = (idx - 1) % rows
        onCard(s.kind, item, cursorX + subCol * (GT_CARD_W + 4), cardsY + rowI * (GT_CARD_H + GT_GAP_Y))
      end
      cursorX = cursorX + sectionWpx + GT_SECTION_GAP
    end
  end
  
  --------------------------------------------------------------------------------
  -- Group picker panel (main page). A modal card over the chassis page that
  -- lists every group and trunk slot; the runtime paints and shows it when a
  -- Port.Group cell is clicked (openGroupPicker in info.lua) and hides it
  -- again after a pick. Every control is transparent at layout time (offline
  -- look) and IsInvisible from runtime start. The "zPicker" prefix sorts after
  -- every other main-page control so the panel renders on top of the grid.
  --------------------------------------------------------------------------------
  local PICKER_PAD, PICKER_TITLE_H, PICKER_BTN_W = 8, 20, 70
  
  local PICKER_CLEAR = { 0, 0, 0, 0 }
  
  local function pickerButton(layout, name, x, y, w, h)
    layout[name] = {
      Style             = "Button",
      ButtonStyle       = "Momentary",
      ButtonVisualStyle = "Flat",
      Position          = { x, y },
      Size              = { w, h },
      Font              = "Roboto",
      FontSize          = 10,
      Legend            = "",
      TextColor         = { 255, 255, 255 },
      Color             = PICKER_CLEAR,
      OffColor          = PICKER_CLEAR,
      StrokeColor       = PICKER_CLEAR,
      StrokeWidth       = 0,
      CornerRadius      = 3,
      HTextAlign        = "Center",
      VTextAlign        = "Center",
    }
  end
  local function pickerText(layout, name, x, y, w, h, textColor)
    layout[name] = {
      Style        = "Text",
      Position     = { x, y },
      Size         = { w, h },
      Font         = "Roboto",
      FontSize     = 11,
      IsBold       = true,
      HTextAlign   = "Left",
      VTextAlign   = "Center",
      TextColor    = textColor,
      Color        = PICKER_CLEAR,
      StrokeWidth  = 0,
      IsReadOnly   = true,
      String       = "",
    }
  end
  
  local function buildGroupPickerPanel(layout, model, theme)
    local rows   = groupsRowsForModel(model)
    local pageW  = pageWidthForModel(model)
    local panelW = groupsPageWidthForRows(rows) - 2 * GT_MARGIN_X + 2 * PICKER_PAD
    local panelH = PICKER_PAD + PICKER_TITLE_H + 6 + GT_LABEL_H + 6
                 + rows * (GT_CARD_H + GT_GAP_Y) - GT_GAP_Y + PICKER_PAD
    local panelX = math.floor((pageW - panelW) / 2 + 0.5)
    local panelY = 10
    pickerButton(layout, "zPicker.Bg", panelX, panelY, panelW, panelH)
    layout["zPicker.Bg"].CornerRadius = 4
  
    local titleY  = panelY + PICKER_PAD
    local cancelX = panelX + panelW - PICKER_PAD - PICKER_BTN_W
    local noneX   = cancelX - 6 - PICKER_BTN_W
    pickerText(layout, "zPicker.Title", panelX + PICKER_PAD, titleY, noneX - 6 - (panelX + PICKER_PAD), PICKER_TITLE_H, theme.textPrimary)
    pickerButton(layout, "zPicker.None",   noneX,   titleY, PICKER_BTN_W, PICKER_TITLE_H)
    pickerButton(layout, "zPicker.Cancel", cancelX, titleY, PICKER_BTN_W, PICKER_TITLE_H)
  
    local labelY = titleY + PICKER_TITLE_H + 6
    walkGroupTrunkSections(model, panelX + PICKER_PAD, labelY, labelY + GT_LABEL_H + 6,
      function(si, _title, x, y, w)
        pickerText(layout, "zPicker.Label " .. si, x, y, w, GT_LABEL_H, theme.textMuted)
      end,
      function(kind, item, x, y)
        pickerButton(layout, ((kind == "group") and "zPicker.Group " or "zPicker.Trunk ") .. item.slot, x, y, GT_CARD_W, GT_CARD_H)
      end)
  end
  
  
  --------------------------------------------------------------------------------
  -- Speed picker panel (main page). Same mechanics as the group picker: a
  -- Port.Speed Cell click makes the runtime paint and show it (openSpeedPicker
  -- in info.lua); zSpeed.Item i is SPEED_CHOICES[i], laid out as a 3-column
  -- grid of cards under a title row.
  --------------------------------------------------------------------------------
  local SPEED_PICKER_COLS, SPEED_CARD_W, SPEED_CARD_GAP_X = 3, 130, 6
  
  local function buildSpeedPickerPanel(layout, model, theme)
    local n      = #SPEED_CHOICES
    local rows   = math.ceil(n / SPEED_PICKER_COLS)
    local pageW  = pageWidthForModel(model)
    local panelW = 2 * PICKER_PAD + SPEED_PICKER_COLS * SPEED_CARD_W + (SPEED_PICKER_COLS - 1) * SPEED_CARD_GAP_X
    local panelH = PICKER_PAD + PICKER_TITLE_H + 6 + rows * (GT_CARD_H + GT_GAP_Y) - GT_GAP_Y + PICKER_PAD
    local panelX = math.floor((pageW - panelW) / 2 + 0.5)
    local panelY = 10
  
    pickerButton(layout, "zSpeed.Bg", panelX, panelY, panelW, panelH)
    layout["zSpeed.Bg"].CornerRadius = 4
  
    local titleY  = panelY + PICKER_PAD
    local cancelX = panelX + panelW - PICKER_PAD - PICKER_BTN_W
    pickerText(layout, "zSpeed.Title", panelX + PICKER_PAD, titleY, cancelX - 6 - (panelX + PICKER_PAD), PICKER_TITLE_H, theme.textPrimary)
    pickerButton(layout, "zSpeed.Cancel", cancelX, titleY, PICKER_BTN_W, PICKER_TITLE_H)
  
    local cardsY = titleY + PICKER_TITLE_H + 6
    for i = 1, n do
      local col = (i - 1) % SPEED_PICKER_COLS
      local row = math.floor((i - 1) / SPEED_PICKER_COLS)
      pickerButton(layout, "zSpeed.Item " .. i,
        panelX + PICKER_PAD + col * (SPEED_CARD_W + SPEED_CARD_GAP_X),
        cardsY + row * (GT_CARD_H + GT_GAP_Y), SPEED_CARD_W, GT_CARD_H)
    end
  end
  
  --------------------------------------------------------------------------------
  -- LLDP neighbor panel (main page): centred under the chassis box, over the
  -- port-settings grid; zLldp.Panel carries the panel SVG (lldpPanelSvg), its
  -- two buttons sit in the title row's right part. Blank and hidden until the
  -- runtime opens it (openLldpPanel in info.lua).
  --------------------------------------------------------------------------------
  local LLDP_PANEL_BUTTON_W, LLDP_PANEL_BUTTON_H, LLDP_PANEL_PAD = 70, 20, 8
  
  local function buildLldpPanel(layout, model)
    local chassisX = CHASSIS_X + DISPLAY_W + DISPLAY_GAP
    local x = chassisX + math.floor((chassisGeometry(model).w - LLDP_PANEL_W) / 2)
    local y = CHASSIS_Y + CHASSIS_H + 6
    -- Clickable, so a click on the panel never reaches the grid underneath.
    clickableIconButton(layout, "zLldp.Panel", x, y, LLDP_PANEL_W, LLDP_PANEL_H)
    local closeX = x + LLDP_PANEL_W - LLDP_PANEL_PAD - LLDP_PANEL_BUTTON_W
    local buttonY = y + LLDP_PANEL_PAD
    pickerButton(layout, "zLldp.Panel Close", closeX, buttonY, LLDP_PANEL_BUTTON_W, LLDP_PANEL_BUTTON_H)
    pickerButton(layout, "zLldp.Panel To Legend", closeX - 6 - LLDP_PANEL_BUTTON_W, buttonY, LLDP_PANEL_BUTTON_W,
      LLDP_PANEL_BUTTON_H)
  end
  
  local function buildControlsPage(layout, gfx, model)
    local theme = getThemeColors()
    buildChassisPage(layout, gfx, model, theme)
    buildGroupPickerPanel(layout, model, theme)
    buildSpeedPickerPanel(layout, model, theme)
    buildLldpPanel(layout, model)
  end
  
  --------------------------------------------------------------------------------
  -- Configuration page
  --------------------------------------------------------------------------------
  local function buildConfigurationPage(layout, gfx, props)
    local theme  = getThemeColors()
    -- Match main-page height (computed in buildChassisPage); use
    -- pageHeightForModel so tabs don't resize the window.
    local model = resolveModel(props)
    local totalW = pageWidthForModel(model)
    local totalH = pageHeightForModel(model)
  
    gfx[#gfx+1] = {
      Type        = "Groupbox",
      Fill        = theme.groupboxFill,
      StrokeColor = { 0, 0, 0 },
      StrokeWidth = 0,
      Position    = { 0, 0 },
      Size        = { totalW, totalH },
    }
  
    defineCommonDeviceInfo(layout, gfx, theme, 0, 0)
  
    local labelX = 30
    local inputX = 110
    local rowY   = 90
    local rowGap = 40
    local boxW   = 140
    local boxH   = 24
    local labelW = 70
  
    local connectX = 270
    local btnW     = 120
    local btnH     = 30
  
    gfx[#gfx+1] = {
      Type       = "Text",
      Text       = "IP Address",
      Position   = { labelX, rowY + 0 },
      Size       = { labelW, boxH },
      Font       = "Roboto",
      FontSize   = 10,
      Color      = theme.labelGray,
      HTextAlign = "Right",
      VTextAlign = "Center",
    }
  
    layout["Auth.IP Address"] = {
      Style      = "TextBox",
      Position   = { inputX, rowY + 0 },
      Size       = { boxW, boxH },
      Font       = "Roboto",
      FontSize   = 14,
      HTextAlign = "Center",
      Color      = { 0, 0, 0, 0 },
      TextColor  = { 255, 255, 255 },
    }
  
    layout["Auth.Connect"] = {
      Legend      = "Connect",
      Style       = "Button",
      ButtonStyle = "Momentary",
      Color       = { 0, 255, 0 },
      OffColor    = theme.buttonOffColor,
      Position    = { connectX, rowY },
      Size        = { btnW, btnH },
      Font        = "Roboto",
      FontSize    = 13,
      HTextAlign  = "Center",
    }
  
    gfx[#gfx+1] = {
      Type       = "Text",
      Text       = "Username",
      Position   = { labelX, rowY + rowGap },
      Size       = { labelW, boxH },
      Font       = "Roboto",
      FontSize   = 10,
      TextColor  = { 255, 255, 255 },
      Color      = theme.labelGray,
      HTextAlign = "Right",
      VTextAlign = "Center",
    }
  
    layout["Auth.Username"] = {
      Style      = "TextBox",
      Position   = { inputX, rowY + rowGap },
      Size       = { boxW, boxH },
      Font       = "Roboto",
      FontSize   = 14,
      HTextAlign = "Center",
      Color      = { 0, 0, 0, 0 },
      TextColor  = { 255, 255, 255 },
    }
  
    layout["Identify"] = {
      Legend      = "Identify",
      Style       = "Button",
      ButtonStyle = "Momentary",
      Color       = { 0, 150, 255 },
      OffColor    = { 30, 30, 30 },
      Position    = { connectX, rowY + rowGap },
      Size        = { btnW, btnH },
      Font        = "Roboto",
      FontSize    = 13,
      HTextAlign  = "Center",
    }
  
    gfx[#gfx+1] = {
      Type       = "Text",
      Text       = "Password",
      Position   = { labelX, rowY + rowGap * 2 },
      Size       = { labelW, boxH },
      Font       = "Roboto",
      FontSize   = 10,
      Color      = theme.labelGray,
      HTextAlign = "Right",
      VTextAlign = "Center",
    }
  
    -- Q-SYS has no masked text box for plugins: the password box draws its
    -- text transparent, over Auth.Masked Password (alphabetically before it,
    -- so drawn below), where the runtime writes the bullets.
    layout["Auth.Masked Password"] = {
      Style      = "Text",
      Position   = { inputX, rowY + rowGap * 2 },
      Size       = { boxW, boxH },
      Font       = "Roboto",
      FontSize   = 14,
      HTextAlign = "Center",
      Color      = { 0, 0, 0, 0 },
      TextColor  = { 255, 255, 255 },
      StrokeWidth = 0,
      IsReadOnly = true,
    }
  
    -- Designer's hover tooltip shows the value of a text box whose PrettyName
    -- is empty: name it so the tooltip shows "Password", not the password.
    layout["Auth.Password"] = {
      Style      = "TextBox",
      PrettyName = "Password",
      Position   = { inputX, rowY + rowGap * 2 },
      Size       = { boxW, boxH },
      Font       = "Roboto",
      FontSize   = 14,
      HTextAlign = "Center",
      Color      = { 0, 0, 0, 0 },
      TextColor  = { 0, 0, 0, 0 },
    }
  
    layout["Auth.Status"] = {
      Style       = "Text",
      Position    = { connectX, rowY + rowGap * 2 },
      Size        = { btnW, boxH },
      Font        = "Roboto",
      FontSize    = 11,
      TextColor   = { 255, 255, 255 },
      StrokeWidth = 0,
      Color       = { 0, 0, 0, 0 },
      HTextAlign  = "Center",
      VTextAlign  = "Center",
      IsReadOnly  = true,
      Legend      = "Auth.Status",
    }
  end
  
  --------------------------------------------------------------------------------
  -- Groups and Trunks settings page (Araneo-inspired, sectioned)
  --
  -- Sections, top to bottom:
  --   • Predefined Groups   — 5×4 grid (ids 1..20)
  --   • Custom Groups       — row of state.groupList entries with predefined=false
  --   • Predefined Trunks   — row of state.trunkList entries with predefined=true
  --   • Custom Trunks       — row of state.trunkList entries with predefined=false
  --
  -- Each card renders via a group_label_N / trunk_label_N text control. The card
  -- fill color comes from state.customColors (live API), falling back to the
  -- hardcoded GROUP_COLORS palette so a pre-connect view still renders something.
  -- Trunk cards get a "◤" overlay in the top-left corner to visually match the
  -- chassis-view trunk indicator.
  --------------------------------------------------------------------------------
  local function buildGroupTrunkSettingsPage(layout, gfx, props)
    local theme = getThemeColors()
  
    local model = resolveModel(props)
    local pageW, pageH = pageWidthForModel(model), pageHeightForModel(model)
  
    gfx[#gfx+1] = {
      Type        = "Groupbox",
      Fill        = theme.groupboxFill,
      StrokeColor = GROUPBOX_STROKE_COLOR,
      StrokeWidth = GROUPBOX_STROKE_WIDTH,
      Position    = GROUPBOX_POSITION,
      Size        = { pageW, pageH },
    }
  
    defineCommonDeviceInfo(layout, gfx, theme, 0, 0)
  
    -- Compact 4-section layout (left→right): Predefined Groups | Custom
    -- Groups | Predefined Trunks | Custom Trunks. Each section is a vertical
    -- list of small cards that fits within the page's content height.
    local marginX = GT_MARGIN_X
    local topY    = GT_TOP_Y
    local cardW   = GT_CARD_W
    local cardH   = GT_CARD_H
    local labelH  = GT_LABEL_H
  
    state.groupList    = state.groupList    or {}
    state.trunkList    = state.trunkList    or {}
    state.customColors = state.customColors or {}
    state.groupNames   = state.groupNames   or {}
  
    local function sectionLabel(x, y, text, widthPx)
      gfx[#gfx+1] = {
        Type       = "Text",
        Text       = text,
        Position   = { x, y },
        Size       = { widthPx, labelH },
        Font       = "Roboto",
        FontSize   = 11,
        Color      = theme.textMuted,
        HTextAlign = "Left",
        VTextAlign = "Center",
        IsBold     = true,
      }
      gfx[#gfx+1] = {
        Type        = "Rectangle",
        Position    = { x, y + labelH + 1 },
        Size        = { widthPx, 1 },
        Fill        = theme.cardStroke,
        StrokeWidth = 0,
      }
    end
  
    -- placeholder = reserved custom slot: invisible until the runtime fills it
    -- (refreshCustomSlots in info.lua).
    local function placeCard(kind, slot, name, keyForColor, x, y, isTrunk, placeholder)
      local labelName = (kind == "group") and ("group_label_" .. slot) or ("trunk_label_" .. slot)
      local badgeName = (kind == "group") and ("group_id_badge_" .. slot) or ("trunk_id_badge_" .. slot)
      layout[labelName] = {
        Style        = "Text",
        Position     = { x, y },
        Size         = { cardW, cardH },
        IsReadOnly   = true,
        FontSize     = 10,
        Font         = "Roboto",
        Color        = { 0, 0, 0, 0 },   -- transparent offline; runtime paints the group color
        TextColor    = { 255, 255, 255 },
        StrokeWidth  = 0,
        CornerRadius = 3,
        HTextAlign   = "Center",
        VTextAlign   = "Center",
        String       = name or "",
      }
      layout[badgeName] = {
        Style        = "Text",
        Position     = { x + cardW - 14, y + 2 },
        Size         = { 12, 9 },
        FontSize     = 7,
        Font         = "Roboto",
        TextColor    = { 255, 255, 255 },
        Color        = { 0, 0, 0, 0 },   -- transparent offline; runtime paints it
        CornerRadius = 2,
        StrokeWidth  = 0,
        IsReadOnly   = true,
        HTextAlign   = "Center",
        VTextAlign   = "Center",
        String       = placeholder and "" or tostring(slot),
      }
    end
  
    -- Fixed sections (walkGroupTrunkSections): groups 1..20 and the ISL
    -- trunk always exist; custom groups/trunks only exist on the switch, so
    -- the layout reserves invisible slots (group_label_21.., trunk_label_2..)
    -- that the runtime fills in id order.
    walkGroupTrunkSections(model, marginX, topY, topY + labelH + 6,
      function(_si, title, x, y, w) sectionLabel(x, y, title, w) end,
      function(kind, item, x, y)
        placeCard(kind, item.slot, item.name, item.key, x, y, kind == "trunk", item.placeholder)
      end)
  end
  
  --------------------------------------------------------------------------------
  -- Neighbors page (LLDP): the device header of Groups and Trunks, the column
  -- headers of each block, then per port Lldp.Row N (every cell in one IconData
  -- SVG, lldpRowSvg). The runtime fills the rows (refreshLldpRows in info.lua);
  -- blank offline.
  --------------------------------------------------------------------------------
  local function buildNeighborsPage(layout, gfx, props)
    local theme = getThemeColors()
    local model = resolveModel(props)
    local pageW, pageH = pageWidthForModel(model), pageHeightForModel(model)
  
    gfx[#gfx+1] = {
      Type        = "Groupbox",
      Fill        = theme.groupboxFill,
      StrokeColor = GROUPBOX_STROKE_COLOR,
      StrokeWidth = GROUPBOX_STROKE_WIDTH,
      Position    = GROUPBOX_POSITION,
      Size        = { pageW, pageH },
    }
    defineCommonDeviceInfo(layout, gfx, theme, 0, 0)
  
    local geometry = neighborsGeometry(model)
    local columns  = neighborsColumns(geometry.blockW, geometry.compact)
  
    local headers = { { "name", "Neighbor" }, { "device", "Description" }, { "remotePort", "Port" }, { "ip", "IP" } }
    local headerH = 14
    for block = 0, geometry.blocks - 1 do
      local blockX = LLDP_MARGIN_X + block * (geometry.blockW + LLDP_BLOCK_GAP)
      for _, header in ipairs(headers) do
        local column = columns[header[1]]
        if column then
          gfx[#gfx+1] = {
            Type       = "Text",
            Text       = header[2],
            Position   = { blockX + column.x, geometry.rowsY - headerH },
            Size       = { column.w, headerH },
            Font       = "Roboto",
            FontSize   = 10,
            Color      = theme.textMuted,
            HTextAlign = "Left",
            VTextAlign = "Center",
          }
        end
      end
    end
  
    for port = 1, getPortCount(model) do
      local x, y = neighborsRowPosition(model, port)
      iconButton(layout, "Lldp.Row " .. port, x, y, geometry.blockW, geometry.rowH)
    end
  end
  
  -- Q-SYS lists a pin in Control Pins only when its control has a layout
  -- entry. Every pin the main page does not place gets a Style "None" entry
  -- (hidden, pin kept); the PrettyName pass below files it in its folder.
  local function addPinOnlyEntries(layout, props)
    for _, ctl in ipairs(GetControls(props)) do
      if ctl.UserPin == true and layout[ctl.Name] == nil then
        layout[ctl.Name] = { Style = "None", Position = { 0, 0 }, Size = { 1, 1 } }
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Page dispatcher — model-named page falls through to buildControlsPage
  --------------------------------------------------------------------------------
  local pageBuilders = {
    ["Configuration"] = buildConfigurationPage,
    ["Groups and Trunks"] = buildGroupTrunkSettingsPage,
    ["Neighbors"] = buildNeighborsPage,
  }
  
  setmetatable(pageBuilders, {
    __index = function(_, _key)
      return function(layout, gfx, props)
        buildControlsPage(layout, gfx, resolveModel(props))
        addPinOnlyEntries(layout, props)
      end
    end,
  })
  
  --------------------------------------------------------------------------------
  -- GetControlLayout body
  --------------------------------------------------------------------------------
  local pages = GetPages(props)
  local idx = props["page_index"] and props["page_index"].Value or 1
  local pageObj = pages[idx]
  local pageName = pageObj and pageObj.name or modelString
  
  local layout = {}
  local gfx = {}
  
  local builder = pageBuilders[pageName]
  if builder then
    builder(layout, gfx, props)
  end
  
  -- Q-SYS trees the Control Pins panel on the `PrettyName` of each layout
  -- entry using "~" as the delimiter. Our control Names already carry the
  -- API tree with "." (e.g. "PoE.Port 1.Enabled"), so we just swap "." → "~"
  -- and assign as PrettyName. Keeps Name unchanged (stable pin ID) while the
  -- display in Q-SYS Designer nests into folders: PoE > Port 1 > Enabled, etc.
  --
  -- Designer's hover tooltip shows the PrettyName. Controls that expose no pin
  -- get an empty PrettyName, which shrinks the tooltip to an empty bubble (it
  -- cannot be removed from plugin code). Pinned controls keep the "~" tree name.
  local noPin = {}
  for _, ctl in ipairs(GetControls(props)) do
    if ctl.UserPin == false and (ctl.PinStyle == nil or ctl.PinStyle == "None") then
      noPin[ctl.Name] = true
    end
  end
  for key, entry in pairs(layout) do
    if type(key) == "string" and type(entry) == "table" and entry.PrettyName == nil then
      if noPin[key] then
        entry.PrettyName = ""
      else
        local pretty = key:gsub("%.", "~")
        if pretty ~= key then entry.PrettyName = pretty end
      end
    end
  end
  
  return layout, gfx
end

function GetPages(props)
  local modelString = resolveModel(props)
  
  local pages = {}
  table.insert(pages, { name = modelString })
  table.insert(pages, { name = "Groups and Trunks" })
  table.insert(pages, { name = "Neighbors" })
  table.insert(pages, { name = "Configuration" })
  
  return pages
end

function GetModel(props)
  return {}
end

function RectifyProperties(props)
  log("RectifyProperties called")
  
  state.portCount = getPortCount(resolveModel(props))
  
  props.RebuildGUI = true
  return props
end

if Controls then
  state.portCount = getPortCount(resolveModel(Properties))
  local pc = state.portCount or 30
  
  state.darkMode = Properties["Dark Mode"].Value ~= "No"
  state.chassis = chassisGeometry(resolveModel(Properties))
  clearPortCards()
  
  --------------------------------------------------------------------------------
  -- IP / connect / identify
  --------------------------------------------------------------------------------
  -- "Enter your IP" is the field's placeholder value, not an address.
  local function connectToSwitch()
    updateAuthStatus("")
    local ip = Controls["Auth.IP Address"].String
    if ip == "" or ip == "Enter your IP" then
      state.baseIP = ""
      SetConnection("noip")
      return
    end
    state.baseIP = ip
    state.reconnectDelay = 5
    SetConnection("connecting")
    openWS(state.baseIP)
  end
  
  -- Enter in the IP box connects, same as the Connect button.
  if Controls["Auth.IP Address"] then
    Controls["Auth.IP Address"].EventHandler = function(txt)
      state.baseIP = txt.String
      if txt.String ~= "" then connectToSwitch() end
    end
  end
  
  -- The password box's text is transparent; Auth.Masked Password, under it,
  -- shows one bullet per character. Q-SYS reports the text only on Enter, so
  -- the previous bullets stay while typing.
  local function refreshMaskedPassword()
    local mask = Controls["Auth.Masked Password"]
    if mask == nil then return end
    local pass = Controls["Auth.Password"] and Controls["Auth.Password"].String or ""
    mask.String = string.rep("\u{2022}", utf8.len(pass) or #pass)
  end
  refreshMaskedPassword()
  
  -- Enter in the username or password box connects with the new credentials,
  -- like Enter in the IP box.
  if Controls["Auth.Username"] then
    Controls["Auth.Username"].EventHandler = function()
      connectToSwitch()
    end
  end
  
  if Controls["Auth.Password"] then
    Controls["Auth.Password"].EventHandler = function()
      refreshMaskedPassword()
      connectToSwitch()
    end
  end
  
  if Controls["Auth.Connect"] then
    Controls["Auth.Connect"].EventHandler = function(btn)
      if btn.Boolean then
        connectToSwitch()
        btn.Boolean = false
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Port enable toggle
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local ctrl = Controls["Ports.Port " .. p .. ".Enabled"]
    if ctrl then
      ctrl.EventHandler = function()
        local newState = ctrl.Boolean
        HttpClient.Upload {
          Url     = string.format("http://%s/api/ports/port/%d/enabled", state.baseIP, p),
          Method  = "PUT",
          Data    = newState and "true" or "false",
          Headers = MergeTables(
            { ["Content-Type"] = "application/json" },
            getAuthHeaders()
          ),
          EventHandler = function(_tbl, code, _body, _err)
            log("Port " .. p .. " enable set to " .. tostring(newState) .. " | HTTP " .. tostring(code))
          end,
        }
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- PoE enable toggle
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local ctrl = Controls["PoE.Port " .. p .. ".Enabled"]
    if ctrl then
      ctrl.EventHandler = function()
        local newState = ctrl.Boolean
        HttpClient.Upload {
          Url     = string.format("http://%s/api/poe/ports/%d/enabled", state.baseIP, p),
          Method  = "PUT",
          Data    = newState and "true" or "false",
          Headers = MergeTables(
            { ["Content-Type"] = "application/json" },
            getAuthHeaders()
          ),
          EventHandler = function(_tbl, code, _body, _err)
            log("PoE " .. p .. " enabled set to " .. tostring(newState) .. " | HTTP " .. tostring(code))
          end,
        }
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- PoE bounce: disable PoE, wait 3s, re-enable
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local bounceCtrl = Controls["PoE.Bounce " .. p]
    if bounceCtrl then
      bounceCtrl.EventHandler = function(ctrl)
        if not ctrl.Boolean then return end
        local port = p
        local url = string.format("http://%s/api/poe/ports/%d/enabled", state.baseIP, port)
  
        HttpClient.Upload {
          Url     = url,
          Method  = "PUT",
          Data    = "false",
          Headers = MergeTables(
            { ["Content-Type"] = "application/json" },
            getAuthHeaders()
          ),
          EventHandler = function(_tbl, code, _body, _err)
            log("PoE bounce port " .. port .. " off | HTTP " .. tostring(code))
          end,
        }
  
        Timer.CallAfter(function()
          HttpClient.Upload {
            Url     = url,
            Method  = "PUT",
            Data    = "true",
            Headers = MergeTables(
              { ["Content-Type"] = "application/json" },
              getAuthHeaders()
            ),
            EventHandler = function(_tbl, code, _body, _err)
              log("PoE bounce port " .. port .. " on | HTTP " .. tostring(code))
            end,
          }
        end, 3)
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Port legend edit
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local legendCtrl = Controls["Ports.Port " .. p .. ".Legend"]
    if legendCtrl then
      legendCtrl.EventHandler = function(ctrl) putPortLegend(p, ctrl.String) end
    end
  end
  
  -- Neighbor panel (main page): a chassis card opens it for its port (the
  -- open port's card closes it), Close closes it, -> Legend writes the
  -- port's proposed legend.
  for p = 1, pc do
    local card = Controls["Port.Card " .. p]
    if card then
      card.EventHandler = function(c)
        if c.Boolean then toggleLldpPanel(p) end
      end
    end
  end
  
  -- The panel body catches clicks (nothing to do): the grid under it stays out
  -- of reach while it is open.
  local panelBody = Controls["zLldp.Panel"]
  if panelBody then panelBody.EventHandler = function() end end
  
  local panelClose = Controls["zLldp.Panel Close"]
  if panelClose then
    panelClose.EventHandler = function(c)
      if c.Boolean then closeLldpPanel() end
    end
  end
  
  local panelLegend = Controls["zLldp.Panel To Legend"]
  if panelLegend then
    panelLegend.EventHandler = function(c)
      local port = state.lldpPanelPort
      local neighbor = port and state.lldp[port]
      if c.Boolean and state.connection == "online" and neighbor then
        putPortLegend(port, lldpView(neighbor).legend)
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- RLinkX toggle
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local toggleCtrl = Controls["Ports.Port " .. p .. ".RLinkX.Enabled"]
    if toggleCtrl then
      toggleCtrl.EventHandler = function(ctrl)
        local enabled = ctrl.Boolean
        HttpClient.Upload {
          Url     = string.format("http://%s/api/ports/port/%d/rlinkx", state.baseIP, p),
          Method  = "PUT",
          Data    = '{"enabled":' .. tostring(enabled) .. '}',
          Headers = MergeTables(
            { ["Content-Type"] = "application/json" },
            getAuthHeaders()
          ),
          EventHandler = function(_tbl, _status, _body, _err)
            log("RLinkX PUT port " .. p .. " => " .. tostring(enabled))
          end,
        }
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Link Speed and Member Of pins: one write, one PUT of the whole object.
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local base = "Ports.Port " .. p .. "."
    local speed = Controls[base .. "Link Speed"]
    if speed then
      speed.EventHandler = function() putPortLinkSpeed(p) end
    end
    local member = Controls[base .. "Member Of"]
    if member then
      member.EventHandler = function() putPortMemberOf(p) end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Speed cell: opens the speed picker (applyPortSpeed on a pick).
  --------------------------------------------------------------------------------
  for p = 1, pc do
    local cell = Controls["Port.Speed Cell " .. p]
    if cell then
      cell.EventHandler = function(c)
        if c.Boolean then openSpeedPicker(p) end
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Identify — device-level (logo click, Configuration page button) and per-port
  -- (port number click).
  --------------------------------------------------------------------------------
  local function identifyDevice()
    if state.baseIP == "" then return end
    HttpClient.Upload {
      Url     = string.format("http://%s/api/identify", state.baseIP),
      Method  = "PUT",
      Data    = '{"duration": 9}',
      Headers = MergeTables(
        { ["Content-Type"] = "application/json" },
        getAuthHeaders()
      ),
      EventHandler = function(_tbl, status, _b, err)
        log("Identify device => status: " .. tostring(status) .. ", err: " .. tostring(err))
      end,
    }
  end
  
  local function identifyPort(port)
    if state.baseIP == "" then return end
    local payload = string.format('{"duration":9,"port_numbers":[%d]}', port)
    HttpClient.Upload {
      Url     = string.format("http://%s/api/port_identify", state.baseIP),
      Method  = "PUT",
      Data    = payload,
      Headers = MergeTables(
        { ["Content-Type"] = "application/json" },
        getAuthHeaders()
      ),
      EventHandler = function(_tbl, status, _b, err)
        log("Identify port " .. port .. " => status: " .. tostring(status) .. ", err: " .. tostring(err))
      end,
    }
  end
  
  local idBtn = Controls["Identify"]
  if idBtn then
    idBtn.EventHandler = function(c)
      if c.Boolean then identifyDevice() end
    end
  end
  
  for p = 1, pc do
    local b = Controls["Port Identify.Port " .. p]
    if b then
      b.EventHandler = function(c)
        if c.Boolean then identifyPort(p) end
      end
    end
  end
  
  --------------------------------------------------------------------------------
  -- Group picker (main page): a Port.Group cell opens it, an item PUTs the
  -- new membership, Cancel or the backdrop closes it.
  --------------------------------------------------------------------------------
  closeGroupPicker()
  closeSpeedPicker()
  closeLldpPanel()
  
  for p = 1, pc do
    local cell = Controls["Port.Group " .. p]
    if cell then
      cell.EventHandler = function(c)
        if c.Boolean then openGroupPicker(p) end
      end
    end
  end
  
  for slot = 1, 20 + CUSTOM_GROUP_SLOTS do
    local b = Controls["zPicker.Group " .. slot]
    if b then
      b.EventHandler = function(c)
        local id = state.pickerSlotGroupId and state.pickerSlotGroupId[slot]
        if c.Boolean and id then pickerAssign("group", id) end
      end
    end
  end
  
  for slot = 1, 1 + CUSTOM_TRUNK_SLOTS do
    local b = Controls["zPicker.Trunk " .. slot]
    if b then
      b.EventHandler = function(c)
        local id = state.pickerSlotTrunkId and state.pickerSlotTrunkId[slot]
        if c.Boolean and id then pickerAssign("trunk", id) end
      end
    end
  end
  
  local noneBtn = Controls["zPicker.None"]
  if noneBtn then
    noneBtn.EventHandler = function(c)
      if c.Boolean then pickerAssign("none") end
    end
  end
  
  for _, name in ipairs({ "zPicker.Cancel", "zPicker.Bg" }) do
    local b = Controls[name]
    if b then
      b.EventHandler = function(c)
        if c.Boolean then closeGroupPicker() end
      end
    end
  end
  
  for i, label in ipairs(SPEED_CHOICES) do
    local b = Controls["zSpeed.Item " .. i]
    if b then
      b.EventHandler = function(c)
        if not c.Boolean then return end
        local port = state.speedPickerPort
        closeSpeedPicker()
        if port then applyPortSpeed(port, label) end
      end
    end
  end
  
  for _, name in ipairs({ "zSpeed.Cancel", "zSpeed.Bg" }) do
    local b = Controls[name]
    if b then
      b.EventHandler = function(c)
        if c.Boolean then closeSpeedPicker() end
      end
    end
  end
  
  -- Connect at start: a Core reboot or a redeploy reconnects to the saved
  -- IP address without a press on Connect (Status Fault when none is set).
  connectToSwitch()
  
  log("Enjoy")
end
